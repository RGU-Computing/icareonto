    <rdfs:label>(Sobre)viver ao cancro: Guia de apoio</rdfs:label>
    <dcterms:description>Guide for people who have completed cancer treatment, addressing recovery, ongoing symptoms, emotional and social wellbeing, healthy living and continuing health surveillance.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0170</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">pt</dcterms:language>
    <dcterms:publisher>Associação Enfermagem Oncológica Portuguesa (AEOP); Ana Cristina Ferreira and colleagues</dcterms:publisher>
    <dcterms:rights>Link / Signpost Only</dcterms:rights>
    <dcterms:source rdf:resource="https://www.aeop.pt/ficheiros/SobreViverCancro_A5_12Dez.pdf"/>
    <dcterms:title>(Sobre)viver ao cancro: Guia de apoio</dcterms:title>
    <edu:accessConditions>Public</edu:accessConditions>
    <edu:applicabilityNotes>Written for adult cancer survivors and their families/caregivers rather than specifically for AYA survivors. Assess suitability for adult AYAs (18-39) and use with younger adolescents (15-17) separately. Personal treatment, exercise, medication, and surveillance decisions remain with the clinical care team.</edu:applicabilityNotes>
    <edu:completionStatus>Complete</edu:completionStatus>
