    <rdfs:label>Overwhelmed by diet and cancer advice? You’re not alone</rdfs:label>
    <dcterms:description>Illustrated nutrition guide for people living with and beyond cancer, supporting informed food choices, understanding conflicting dietary advice and managing eating difficulties through practical guidance and recipes.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0023</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">en</dcterms:language>
    <dcterms:publisher>Trekstock</dcterms:publisher>
    <dcterms:rights>Link / Signpost Only</dcterms:rights>
    <dcterms:source rdf:resource="https://www.trekstock.com/get-support/nutrition-guide"/>
    <dcterms:title>Overwhelmed by diet and cancer advice? You’re not alone</dcterms:title>
    <edu:accessConditions>Restricted</edu:accessConditions>
    <edu:applicabilityNotes>Designed for people in their 20s, 30s and 40s during and after treatment, including people living with cancer long-term. Uses short sections, reduced text and imagery to accommodate fatigue and reading difficulties. Full-guide access requires name and email registration.</edu:applicabilityNotes>
    <edu:completionStatus>Complete</edu:completionStatus>
