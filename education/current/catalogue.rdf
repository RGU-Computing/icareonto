  <rdf:Description rdf:about="https://w3id.org/icareonto/education/resources/MAYA-EDU-0061">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EducationalResource"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyResource"/>
    <rdfs:label>Guia de Alimentação na Pessoa com Cancro</rdfs:label>
    <dcterms:description>Guide explaining nutrition during and after cancer treatment, food-related myths, symptoms affecting intake, when to seek nutritional support and practical dietary adjustments, with a dedicated post-treatment section.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0061</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">pt</dcterms:language>
    <dcterms:publisher>Associação de Investigação de Cuidados de Suporte em Oncologia (AICSO); Andreia Capela, Luciana Teixeira, Elsa Madureira and Sara Torcato Parreira</dcterms:publisher>
    <dcterms:rights>Link / Signpost Only</dcterms:rights>
    <dcterms:source rdf:resource="https://aicso.pt/wp-content/uploads/2024/04/Guia-de-Alimentacao-Doente-Cancro_Digital.pdf"/>
    <dcterms:title>Guia de Alimentação na Pessoa com Cancro</dcterms:title>
    <edu:accessConditions>Public</edu:accessConditions>
    <edu:applicabilityNotes>General oncology guide, not AYA-specific. Includes malnutrition and symptom-management advice for active treatment that should not be applied indiscriminately to well survivors. For post-treatment users, prioritise the relevant section and their current nutritional needs. Dietary supplements and individual dietary treatment require professional advice.</edu:applicabilityNotes>
    <edu:completionStatus>Complete</edu:completionStatus>
    <edu:curatedBy>INO</edu:curatedBy>
    <edu:curatedOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-18</edu:curatedOn>
    <edu:curationStatus>Approved</edu:curationStatus>
    <edu:journeyStage>After treatment / survivorship</edu:journeyStage>
    <edu:journeyStage>During treatment</edu:journeyStage>
