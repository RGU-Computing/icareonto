    <rdfs:label>Ficha del paciente: Cardio-oncología</rdfs:label>
    <dcterms:description>Two-page illustrated patient information sheet explaining cardiovascular complications of cancer treatment, assessment and monitoring before, during and after treatment, and practical measures to support cardiovascular health.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0004</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">es</dcterms:language>
