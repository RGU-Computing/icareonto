    <rdfs:label>Heart health and cancer</rdfs:label>
    <dcterms:description>Explains how cancer treatments can affect heart health, including symptoms, cardiovascular assessments, long-term monitoring and practical measures to support cardiovascular wellbeing.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0017</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">en</dcterms:language>
    <dcterms:publisher>Macmillan Cancer Support</dcterms:publisher>
    <dcterms:rights>Link / Signpost Only</dcterms:rights>
    <dcterms:source rdf:resource="https://www.macmillan.org.uk/cancer-information-and-support/impacts-of-cancer/heart-health"/>
    <dcterms:title>Heart health and cancer</dcterms:title>
    <edu:accessConditions>Public</edu:accessConditions>
    <edu:applicabilityNotes>General oncology information, with some childhood-treatment context. Includes emergency and service information that requires local interpretation when used across pilots.</edu:applicabilityNotes>
