  <rdf:Description rdf:about="https://w3id.org/icareonto/education/resources/MAYA-EDU-0178">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EducationalResource"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyResource"/>
    <rdfs:label>How to Find Cancer Resources You Can Trust</rdfs:label>
    <dcterms:description>Practical guidance for finding and evaluating cancer information, checking authorship, evidence, sponsorship and currency, protecting personal information, and using websites, social media and email safely.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0178</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">en</dcterms:language>
    <dcterms:publisher>National Cancer Institute (NCI), National Institutes of Health</dcterms:publisher>
    <dcterms:rights>Link / Signpost Only</dcterms:rights>
    <dcterms:source rdf:resource="https://www.cancer.gov/about-cancer/managing-care/using-trusted-resources"/>
    <dcterms:title>How to Find Cancer Resources You Can Trust</dcterms:title>
    <edu:accessConditions>Public</edu:accessConditions>
    <edu:applicabilityNotes>Applicable throughout the cancer journey. Some website-domain examples and linked organisations reflect the US context. Review linked resources separately before recommending them.</edu:applicabilityNotes>
    <edu:completionStatus>Complete</edu:completionStatus>
