    <rdfs:label>Giving up smoking</rdfs:label>
    <dcterms:description>Explains the benefits of stopping smoking during and after cancer treatment, including reducing heart and lung risks. Describes preparing to quit, seeking professional support and accessing smoking-cessation services.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0183</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">en</dcterms:language>
