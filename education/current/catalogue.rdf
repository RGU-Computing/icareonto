  <rdf:Description rdf:about="https://w3id.org/icareonto/education/resources/MAYA-EDU-0176">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EducationalResource"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyResource"/>
    <rdfs:label>Promozione della salute</rdfs:label>
    <dcterms:description>Survivor-oriented summary explaining health-promoting behaviours after childhood, adolescent or young-adult cancer, including activity, diet, avoiding smoking and discussing suitable lifestyle changes with professionals.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0176</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">it</dcterms:language>
    <dcterms:publisher>PanCare PLAIN Information Group; Italian PLAIN summary</dcterms:publisher>
    <dcterms:rights>Link / Signpost Only</dcterms:rights>
    <dcterms:source rdf:resource="https://www.pancare.eu/brochures-divulgative-plain/promozione-della-salute/"/>
    <dcterms:title>Promozione della salute</dcterms:title>
    <edu:accessConditions>Public</edu:accessConditions>
    <edu:applicabilityNotes>Intended for survivors of childhood, adolescent and young-adult cancer. Lifestyle guidance is general and may require adaptation to treatment-related limitations and the individual care plan.</edu:applicabilityNotes>
    <edu:completionStatus>Complete</edu:completionStatus>
