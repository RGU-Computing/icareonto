  <rdf:Description rdf:about="https://w3id.org/icareonto/education/resources/MAYA-EDU-0030">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EducationalResource"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyResource"/>
    <rdfs:label>Teenagers and young adults affected by cancer</rdfs:label>
    <dcterms:description>Information and signposting to age-appropriate cancer support for teenagers, young adults and young carers, including practical, emotional, financial and peer-support services.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0030</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">en</dcterms:language>
    <dcterms:publisher>Macmillan Cancer Support</dcterms:publisher>
    <dcterms:rights>Link / Signpost Only</dcterms:rights>
    <dcterms:source rdf:resource="https://www.macmillan.org.uk/cancer-information-and-support/get-help/teenagers-and-young-adults"/>
    <dcterms:title>Teenagers and young adults affected by cancer</dcterms:title>
    <edu:accessConditions>Public</edu:accessConditions>
    <edu:applicabilityNotes>Primarily signposting rather than detailed educational guidance. Includes UK-specific services, rights and eligibility criteria. Young carers are a separate audience from young people diagnosed with cancer.</edu:applicabilityNotes>
