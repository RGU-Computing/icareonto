  <rdf:Description rdf:about="https://w3id.org/icareonto/education/resources/MAYA-EDU-0020">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EducationalResource"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyResource"/>
    <rdfs:label>Getting Back to Normal After Treatment Ends</rdfs:label>
    <dcterms:description>Practical guidance for young people adjusting to life after cancer treatment, covering relationships, identity, work or education, ongoing effects, emotional recovery and fear of relapse.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0020</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">en</dcterms:language>
    <dcterms:publisher>Young Lives vs Cancer</dcterms:publisher>
    <dcterms:rights>Link / Signpost Only</dcterms:rights>
    <dcterms:source rdf:resource="https://www.younglivesvscancer.org.uk/cancer-info-support/body-and-health/getting-back-to-normal-after-treatment-ends/"/>
    <dcterms:title>Getting Back to Normal After Treatment Ends</dcterms:title>
    <edu:accessConditions>Public</edu:accessConditions>
    <edu:applicabilityNotes>Youth-focused survivorship guidance. Includes UK-specific employment, education and support references whose applicability varies between pilots. Content can be viewed in 134 different languages.</edu:applicabilityNotes>
