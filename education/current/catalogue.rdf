    <rdfs:label>Onkologia w Internecie: jak rozpoznać rzetelne źródła informacji?</rdfs:label>
    <dcterms:description>Practical advice on finding and evaluating online cancer information, including checking source authority, publication dates, author credentials, supporting evidence and sensational claims. Identifies types of information sources patients and families can consult.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0108a</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">pl</dcterms:language>
    <dcterms:publisher>Alivia Onkofundacja; Jarosław Gośliński</dcterms:publisher>
    <dcterms:rights>Link / Signpost Only</dcterms:rights>
    <dcterms:source rdf:resource="https://alivia.org.pl/wiedza-o-raku/onkologia-w-internecie-jak-rozpoznac-rzetelne-zrodla-informacji/"/>
    <dcterms:title>Onkologia w Internecie: jak rozpoznać rzetelne źródła informacji?</dcterms:title>
    <edu:accessConditions>Public</edu:accessConditions>
    <edu:applicabilityNotes>Relevant throughout the cancer journey, including survivorship. Covers information credibility rather than comprehensive privacy or data-protection guidance. General patient information rather than an AYA-specific resource.</edu:applicabilityNotes>
    <edu:completionStatus>Complete</edu:completionStatus>
    <edu:curatedBy>INO</edu:curatedBy>
