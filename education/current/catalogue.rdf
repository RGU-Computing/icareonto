    <rdfs:label>Cómo encontrar recursos confiables sobre el cáncer</rdfs:label>
    <dcterms:description>Guidance for finding trustworthy cancer information and assessing authorship, evidence, commercial interests and currency. Includes personal-data precautions and advice on using social media, applications and email safely.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0179</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">es</dcterms:language>
    <dcterms:publisher>Instituto Nacional del Cáncer (NCI), National Institutes of Health</dcterms:publisher>
    <dcterms:rights>Link / Signpost Only</dcterms:rights>
    <dcterms:source rdf:resource="https://www.cancer.gov/espanol/cancer/manejo-del-cancer/encontrar-recursos-confiables"/>
    <dcterms:title>Cómo encontrar recursos confiables sobre el cáncer</dcterms:title>
    <edu:accessConditions>Public</edu:accessConditions>
    <edu:applicabilityNotes>Applicable throughout the cancer journey. Some linked resources are in English, and website-domain examples reflect the US context. Assess onward links separately.</edu:applicabilityNotes>
