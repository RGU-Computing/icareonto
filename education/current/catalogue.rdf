    <rdfs:label>Schluss mit Rauchen: Welche Methoden funktionieren?</rdfs:label>
    <dcterms:description>Article explaining smoking-cessation approaches, the evidence supporting different methods, practical behaviour-change strategies and sources of professional support.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0173</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">de</dcterms:language>
    <dcterms:publisher>Krebsinformationsdienst, Deutsches Krebsforschungszentrum (DKFZ); Vanessa Schöner</dcterms:publisher>
    <dcterms:rights>Link / Signpost Only</dcterms:rights>
    <dcterms:source rdf:resource="https://www.krebsinformationsdienst.de/aktuelles/detail/schluss-mit-rauchen-welche-methoden-funktionieren"/>
    <dcterms:title>Schluss mit Rauchen: Welche Methoden funktionieren?</dcterms:title>
    <edu:accessConditions>Public</edu:accessConditions>
    <edu:applicabilityNotes>Relevant to participants who smoke and want cessation support, including after cancer treatment. Not specifically designed for AYA survivors. Medication, prescription-app and treatment choices require appropriate professional advice; check local service applicability.</edu:applicabilityNotes>
    <edu:completionStatus>Complete</edu:completionStatus>
