  <rdf:Description rdf:about="https://w3id.org/icareonto/education/resources/MAYA-EDU-0046">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EducationalResource"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyResource"/>
    <rdfs:label>Dicas para quem vive com cancro</rdfs:label>
    <dcterms:description>Practical tips on daily life with cancer, including emotional wellbeing, fatigue, sleep, common treatment effects, sexuality, exercise, food and support from family and friends.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0046</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">pt</dcterms:language>
    <dcterms:publisher>Laço (publication hosted by iMM–Laço); drawing on contributions from women with breast-cancer experience</dcterms:publisher>
    <dcterms:rights>Link / Signpost Only</dcterms:rights>
    <dcterms:source rdf:resource="https://laco.imm.medicina.ulisboa.pt/wp-content/uploads/sites/11/2021/10/BOOKLET-LACO_Dicas-para-quem-vive-com-cancro.pdf"/>
    <dcterms:title>Dicas para quem vive com cancro</dcterms:title>
    <edu:accessConditions>Public</edu:accessConditions>
    <edu:applicabilityNotes>Draws substantially on breast-cancer and treatment experiences, rather than being a dedicated AYA or post-treatment guide. Review relevance of each intended section; distinguish everyday coping tips from treatment-specific symptom advice. Not every topic in the full guide applies to every survivor.</edu:applicabilityNotes>
    <edu:completionStatus>Complete</edu:completionStatus>
