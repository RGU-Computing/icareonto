    <rdfs:label>¿Y después del cáncer, qué?</rdfs:label>
    <dcterms:description>Information on emotional adjustment after cancer treatment, including uncertainty, confidence, changing identity, everyday coping strategies and when to seek additional support.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0009</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">es</dcterms:language>
