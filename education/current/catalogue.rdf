  <rdf:Description rdf:about="https://w3id.org/icareonto/education/resources/MAYA-EDU-0008">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EducationalResource"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyResource"/>
    <rdfs:label>Alimentación saludable</rdfs:label>
    <dcterms:description>Guidance on balanced eating after a cancer diagnosis, including gradual dietary changes, weight management, food safety, supplements and common nutrition misconceptions.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0008</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">es</dcterms:language>
    <dcterms:publisher>Fundación Jiménez Díaz – Comprehensive Cancer Center</dcterms:publisher>
    <dcterms:rights>Link / Signpost Only</dcterms:rights>
    <dcterms:source rdf:resource="https://www.fjd.es/comprehensivecancer/es/area-paciente/cancer/prevenir/estilo-vida-saludable/alimentacion-saludable"/>
    <dcterms:title>Alimentación saludable</dcterms:title>
    <edu:accessConditions>Public</edu:accessConditions>
    <edu:applicabilityNotes>General oncology information, not AYA-specific. Includes general dietary targets and advice concerning supplements and reduced immunity; suitability depends on individual nutritional and treatment needs.</edu:applicabilityNotes>
    <edu:completionStatus>Complete</edu:completionStatus>
