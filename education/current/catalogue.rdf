    <rdfs:label>Relationships after cancer treatment</rdfs:label>
    <dcterms:description>Guidance for young people navigating relationships after cancer treatment, including family dynamics, friendships, romantic relationships, independence and communicating personal needs and concerns.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0021</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">en</dcterms:language>
