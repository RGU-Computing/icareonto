    <dcterms:rights>Link / Signpost Only</dcterms:rights>
    <dcterms:source rdf:resource="https://www.macmillan.org.uk/cancer-information-and-support/treatment/coping-with-treatment/giving-up-smoking"/>
    <dcterms:title>Giving up smoking</dcterms:title>
    <edu:accessConditions>Public</edu:accessConditions>
    <edu:applicabilityNotes>General cancer information, including survivorship. Service links are UK-specific; participants elsewhere require local services. Recheck when the provider publishes its update.</edu:applicabilityNotes>
