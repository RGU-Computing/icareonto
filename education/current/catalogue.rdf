  <rdf:Description rdf:about="https://w3id.org/icareonto/education/resources/MAYA-EDU-0007">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EducationalResource"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyResource"/>
    <rdfs:label>Mantenerse activo</rdfs:label>
    <dcterms:description>Practical guidance on staying active during and after cancer treatment, covering exercise benefits, activity types, gradual progression, safety considerations and everyday strategies for reducing sedentary time.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0007</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">es</dcterms:language>
    <dcterms:publisher>Fundación Jiménez Díaz – Comprehensive Cancer Center</dcterms:publisher>
    <dcterms:rights>Link / Signpost Only</dcterms:rights>
    <dcterms:source rdf:resource="https://www.fjd.es/comprehensivecancer/es/area-paciente/cancer/prevenir/estilo-vida-saludable/mantenerse-activo"/>
    <dcterms:title>Mantenerse activo</dcterms:title>
    <edu:accessConditions>Public</edu:accessConditions>
    <edu:applicabilityNotes>General oncology resource, not AYA-specific. Relevant to exercise during treatment and survivorship. Includes situations requiring clinical assessment and adaptation of activity.</edu:applicabilityNotes>
    <edu:completionStatus>Complete</edu:completionStatus>
