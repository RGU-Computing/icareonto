  <rdf:Description rdf:about="https://w3id.org/icareonto/education/resources/MAYA-EDU-0167a">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EducationalResource"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyResource"/>
    <rdfs:label>Życie po nowotworze: Poradnik dla osób po przebytej chorobie</rdfs:label>
    <dcterms:description>Post-treatment guide addressing follow-up care, persistent symptoms, body image and intimacy, emotional adjustment, family and work relationships, support and relaxation.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0167a</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">pl</dcterms:language>
