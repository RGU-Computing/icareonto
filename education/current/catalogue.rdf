  <rdf:Description rdf:about="https://w3id.org/icareonto/education/resources/MAYA-EDU-0077e">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EducationalResource"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyResource"/>
    <rdfs:label>La sobrevivencia: Una guía ESMO-ECPC para pacientes</rdfs:label>
    <dcterms:description>Patient guide to life after initial cancer treatment, covering follow-up, cardiovascular and other late effects, physical activity, nutrition, smoking cessation, emotional wellbeing, relationships, support services and personal care records.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0077e</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">es</dcterms:language>
    <dcterms:publisher>European Society for Medical Oncology (ESMO); European Cancer Patient Coalition (ECPC); developed in collaboration with the International Psycho-Oncology Society (IPOS)</dcterms:publisher>
    <dcterms:rights>Link / Signpost Only</dcterms:rights>
    <dcterms:source rdf:resource="https://dam.esmo.org/image/upload/ESMO-Guia-para-Pacientes-Sobrevivencia.pdf"/>
    <dcterms:title>La sobrevivencia: Una guía ESMO-ECPC para pacientes</dcterms:title>
    <edu:accessConditions>Public</edu:accessConditions>
    <edu:applicabilityNotes>Broad adult survivorship guide. Direct participants to relevant sections. Clinical review should confirm the continuing applicability of recommendations in this 2017 edition, particularly lifestyle and treatment advice.</edu:applicabilityNotes>
    <edu:completionStatus>Complete</edu:completionStatus>
    <edu:curatedBy>INO</edu:curatedBy>
    <edu:curatedOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-23</edu:curatedOn>
    <edu:curationStatus>Approved</edu:curationStatus>
    <edu:journeyStage>After treatment / survivorship</edu:journeyStage>
    <edu:resourceDateText>2017</edu:resourceDateText>
    <edu:resourceRole>Direct Educational Resource</edu:resourceRole>
