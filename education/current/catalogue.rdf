  <rdf:Description rdf:about="https://w3id.org/icareonto/education/resources/MAYA-EDU-0099">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EducationalResource"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyResource"/>
    <rdfs:label>Jak dbać o seksualność w obliczu raka?</rdfs:label>
    <dcterms:description>Short article on the effects of cancer and treatment on intimacy, body image and sexual wellbeing, including communication about needs, fertility considerations and seeking specialist advice.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0099</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">pl</dcterms:language>
    <dcterms:publisher>Narodowy Portal Onkologiczny / Narodowy Instytut Onkologii; content oversight: Dr Maciej Kawecki</dcterms:publisher>
    <dcterms:rights>Link / Signpost Only</dcterms:rights>
    <dcterms:source rdf:resource="https://onkologia.pacjent.gov.pl/pl/pacjent/codziennosc-w-trakcie-leczenia/jak-dbac-o-seksualnosc-w-obliczu-raka"/>
    <dcterms:title>Jak dbać o seksualność w obliczu raka?</dcterms:title>
    <edu:accessConditions>Public</edu:accessConditions>
    <edu:applicabilityNotes>General oncology article, not AYA-specific. Suitable as an introduction to sexual wellbeing and communication, rather than a fertility-treatment guide. The existing broad topics describe follow-up and emotional context. Confirm suitability for the participant’s age and clinical context.</edu:applicabilityNotes>
    <edu:completionStatus>Complete</edu:completionStatus>
    <edu:curatedBy>INO</edu:curatedBy>
