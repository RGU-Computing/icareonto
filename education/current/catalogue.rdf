  <rdf:Description rdf:about="https://w3id.org/icareonto/education/resources/MAYA-EDU-0175">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EducationalResource"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyResource"/>
    <rdfs:label>Transition - Der Übergang von der Kinder- und Jugendmedizin in die Erwachsenenmedizin</rdfs:label>
    <dcterms:description>Explanation of the transition from paediatric to adult healthcare, including continuity of follow-up, preparation, growing independence, care planning and possible sources of support.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0175</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">de</dcterms:language>
    <dcterms:publisher>Kinderkrebsinfo / GPOH; Dr Hannah Schmidt and Dr Ingo Menrath; editor: Maria Yiallouros</dcterms:publisher>
    <dcterms:rights>Link / Signpost Only</dcterms:rights>
    <dcterms:source rdf:resource="https://www.gpoh.de/kinderkrebsinfo/content/patienten/nachsorge/spaetfolgen___langzeitnachsorge/transition/index_ger.html"/>
    <dcterms:title>Transition - Der Übergang von der Kinder- und Jugendmedizin in die Erwachsenenmedizin</dcterms:title>
    <edu:accessConditions>Public</edu:accessConditions>
    <edu:applicabilityNotes>Directly developed for adolescents (from age 14–16) and young adults (around age 18) transitioning from paediatric to adult oncology care. Applies specifically to AYA survivors of childhood or adolescent cancers rather than those diagnosed in adult care settings. Clinic listings and care pathways are specific to Germany.</edu:applicabilityNotes>
    <edu:completionStatus>Complete</edu:completionStatus>
    <edu:curatedBy>INO</edu:curatedBy>
    <edu:curatedOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-18</edu:curatedOn>
