  <rdf:Description rdf:about="https://w3id.org/icareonto/education/resources/MAYA-EDU-0167">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EducationalResource"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyResource"/>
    <rdfs:label>Facing Forward: Life After Cancer Treatment</rdfs:label>
    <dcterms:description>Guide to life after cancer treatment, covering follow-up care, healthy living, persistent symptoms, emotional adjustment, relationships and work. Includes consultation guidance and a pain diary for recording symptoms and responses to treatment.</dcterms:description>
    <dcterms:identifier>MAYA-EDU-0167</dcterms:identifier>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">en</dcterms:language>
    <dcterms:publisher>National Cancer Institute (NCI), National Institutes of Health</dcterms:publisher>
    <dcterms:rights>Link / Signpost Only</dcterms:rights>
    <dcterms:source rdf:resource="https://www.cancer.gov/publications/patient-education/facing-forward"/>
    <dcterms:title>Facing Forward: Life After Cancer Treatment</dcterms:title>
    <edu:accessConditions>Public</edu:accessConditions>
    <edu:applicabilityNotes>Broad adult survivorship guide. Check suitability for younger AYAs and current recommendations. US-specific insurance, service and contact information may not apply locally. Direct participants to relevant sections.</edu:applicabilityNotes>
    <edu:completionStatus>Complete</edu:completionStatus>
    <edu:curatedBy>INO</edu:curatedBy>
