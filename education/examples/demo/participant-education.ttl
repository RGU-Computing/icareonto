@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edu: <https://w3id.org/icareonto/education/metadata#> .
@prefix icare: <https://w3id.org/icareonto/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/icareonto/education/demo/care-plan> a owl:NamedIndividual,
        icare:CarePlan ;
    rdfs:label "Draft demonstration education plan" ;
    icare:carePlanHasGoal <https://w3id.org/icareonto/education/demo/goal> ;
    icare:carePlanHasStatus icare:DraftCarePlan ;
    icare:carePlanIncludesActivity <https://w3id.org/icareonto/education/demo/intervention> ;
    icare:carePlanIntendedFor <https://w3id.org/icareonto/education/demo/participant> .

<https://w3id.org/icareonto/education/demo/graph> a owl:Ontology ;
    rdfs:label "Fictional participant education example using real resource metadata"@en ;
    dcterms:contributor "MAYA consortium partners" ;
    dcterms:creator "Robert Gordon University" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright (c) 2026 Robert Gordon University and contributing MAYA consortium partners, for their respective contributions. CC BY 4.0 covers original metadata and activity content only; linked publications retain their provider terms."@en ;
    owl:imports <https://w3id.org/icareonto/education/dataset> ;
    edu:isSynthetic true .

edu:accessConditions a owl:AnnotationProperty .

edu:applicabilityNotes a owl:AnnotationProperty .

edu:completionStatus a owl:AnnotationProperty .

edu:curatedBy a owl:AnnotationProperty .

edu:curatedOn a owl:AnnotationProperty .

edu:curationStatus a owl:AnnotationProperty .

edu:identificationMethod a owl:AnnotationProperty .

edu:isSynthetic a owl:AnnotationProperty .

edu:journeyStage a owl:AnnotationProperty .

edu:learningObjective a owl:AnnotationProperty .

edu:learningStep a owl:AnnotationProperty .

edu:reflectionPrompt a owl:AnnotationProperty .

edu:resourceDateText a owl:AnnotationProperty .

edu:resourceRole a owl:AnnotationProperty .

edu:templateStatus a owl:AnnotationProperty .

<https://w3id.org/icareonto/education/demo/intervention> a owl:NamedIndividual,
        icare:EducationActivity,
        icare:HealthLiteracyIntervention ;
    rdfs:label "Understanding cardiovascular follow-up" ;
    dcterms:source <https://w3id.org/icareonto/education/activity-templates/EDU-CV-FOLLOWUP> ;
    icare:activityContributesToGoal <https://w3id.org/icareonto/education/demo/goal> ;
    edu:templateStatus "Draft" ;
    icare:healthLiteracyInterventionAddressesNeed icare:InformationComprehensionSupportNeed ;
    icare:healthLiteracyInterventionUsesResource <https://w3id.org/icareonto/education/resources/MAYA-EDU-0004>,
        <https://w3id.org/icareonto/education/resources/MAYA-EDU-0077e> .

<https://w3id.org/icareonto/education/demo/language> a owl:NamedIndividual,
        icare:LanguagePreference ;
    rdfs:label "Supplied demonstration language preference" ;
    icare:preferredLanguageTag "es-es"^^xsd:language .

<https://w3id.org/icareonto/education/demo/needs-identification> a owl:NamedIndividual,
        icare:MeasurementEvent ;
    rdfs:label "Fictional support-needs identification" ;
    edu:identificationMethod "Discussion" ;
    icare:measurementEventHasOutput <https://w3id.org/icareonto/education/demo/needs-result> .

<https://w3id.org/icareonto/education/demo/needs-result> a owl:NamedIndividual,
        icare:ObservationResult ;
    rdfs:label "Fictional identified support needs" ;
    dcterms:description "Fictional participant requests help understanding cardiovascular follow-up information. No licensed questionnaire or measured outcome is claimed." ;
    icare:healthLiteracyResultIdentifiesNeed icare:InformationComprehensionSupportNeed .

<https://w3id.org/icareonto/education/demo/participant> a owl:NamedIndividual,
        icare:Person ;
    rdfs:label "Fictional AYA survivor" ;
    icare:personHasPreference <https://w3id.org/icareonto/education/demo/language> ;
    icare:personParticipatesInMeasurement <https://w3id.org/icareonto/education/demo/needs-identification> .

<https://w3id.org/icareonto/education/demo/goal> a owl:NamedIndividual,
        icare:Goal ;
    rdfs:label "Identify the purpose of cardiovascular follow-up and formulate a question for the care team about the participant's own follow-up." ;
    icare:goalDescriptionText "Identify the purpose of cardiovascular follow-up and formulate a question for the care team about the participant's own follow-up."^^xsd:string .

