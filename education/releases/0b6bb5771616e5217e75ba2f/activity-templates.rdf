  <rdf:Description rdf:about="https://w3id.org/icareonto/education/activity-templates/EDU-CV-FOLLOWUP">
    <rdf:type rdf:resource="https://w3id.org/icareonto/EducationActivity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyIntervention"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0018"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0077a"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0077e"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0004"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0077b"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0077c"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0017"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0077d"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0183"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0170"/>
    <edu:templateStatus>Draft</edu:templateStatus>
    <icare:activityContributesToGoal rdf:resource="https://w3id.org/icareonto/education/activity-templates/EDU-CV-FOLLOWUP/goal"/>
    <edu:learningStep>2. Offer a suitable reviewed resource in the participant's language and explain its access conditions.</edu:learningStep>
    <edu:learningStep>4. Help the participant prepare a question for their care team; personal monitoring decisions remain with the care team.</edu:learningStep>
    <edu:learningStep>3. Invite the participant to explain the main message in their own words and identify any unclear information.</edu:learningStep>
    <edu:learningStep>1. Introduce the topic using the participant's stated question and identified support need.</edu:learningStep>
    <edu:reflectionPrompt>1. In your own words, what is the main reason for the follow-up described in this resource?</edu:reflectionPrompt>
    <edu:reflectionPrompt>2. What would you like your care team to explain about your own follow-up?</edu:reflectionPrompt>
    <rdfs:label>Understanding cardiovascular follow-up</rdfs:label>
    <icare:healthLiteracyInterventionAddressesNeed rdf:resource="https://w3id.org/icareonto/InformationComprehensionSupportNeed"/>
    <icare:healthLiteracyInterventionAddressesNeed rdf:resource="https://w3id.org/icareonto/CareTeamCommunicationSupportNeed"/>
    <edu:learningObjective>Identify the purpose of cardiovascular follow-up and formulate a question for the care team about the participant's own follow-up.</edu:learningObjective>
  </rdf:Description>
