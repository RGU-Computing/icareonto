    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0010"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0011"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0077b"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0009"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0177"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0167a"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0077a"/>
    <edu:learningObjective>Recognise an information or support need concerning life after treatment and identify a suitable source of support.</edu:learningObjective>
    <edu:learningStep>3. Invite reflection on what feels relevant and what remains unclear.</edu:learningStep>
    <edu:learningStep>4. Identify a person or service the participant may choose to approach; follow the avatar's operational support and escalation arrangements.</edu:learningStep>
    <edu:learningStep>1. Ask which aspect of adjustment the participant wishes to discuss, without inferring a literacy need from emotional distress alone.</edu:learningStep>
    <edu:learningStep>2. Offer a reviewed resource matching the recorded need, topic and language.</edu:learningStep>
    <icare:healthLiteracyInterventionAddressesNeed rdf:resource="https://w3id.org/icareonto/InformationComprehensionSupportNeed"/>
    <icare:healthLiteracyInterventionAddressesNeed rdf:resource="https://w3id.org/icareonto/SocialSupportNeed"/>
    <icare:healthLiteracyInterventionAddressesNeed rdf:resource="https://w3id.org/icareonto/SelfManagementSupportNeed"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyIntervention"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EducationActivity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <icare:activityContributesToGoal rdf:resource="https://w3id.org/icareonto/education/activity-templates/EDU-AFTER-TREATMENT/goal"/>
    <edu:reflectionPrompt>2. Who could you talk to, or what further information would help?</edu:reflectionPrompt>
    <edu:reflectionPrompt>1. Which part of this information feels relevant to your situation?</edu:reflectionPrompt>
    <edu:templateStatus>Draft</edu:templateStatus>
    <rdfs:label>Adjusting to life after treatment</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/education/activity-templates/EDU-HEALTHY-CHOICES">
    <edu:reflectionPrompt>1. Which idea from the resource would you like to explore?</edu:reflectionPrompt>
    <edu:reflectionPrompt>2. What support or advice would you need before trying it?</edu:reflectionPrompt>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0007"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0077d"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0181"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0170"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0176"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0077b"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0077a"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0180"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0167"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0005"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0061"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0008"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0023"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0077e"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0077c"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0167a"/>
    <icare:healthLiteracyInterventionUsesResource rdf:resource="https://w3id.org/icareonto/education/resources/MAYA-EDU-0046"/>
    <icare:healthLiteracyInterventionAddressesNeed rdf:resource="https://w3id.org/icareonto/SelfManagementSupportNeed"/>
    <icare:healthLiteracyInterventionAddressesNeed rdf:resource="https://w3id.org/icareonto/InformationApplicationSupportNeed"/>
    <edu:learningStep>1. Ask whether the participant wants information about food choices or physical activity.</edu:learningStep>
    <edu:learningStep>2. Select a resource matching that topic, the identified support need and the participant's preferences.</edu:learningStep>
    <edu:learningStep>3. Invite the participant to identify one manageable idea and any barriers or questions.</edu:learningStep>
    <edu:learningStep>4. Distinguish general educational information from an individual dietary or exercise prescription.</edu:learningStep>
    <rdfs:label>Making manageable everyday health choices</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EducationActivity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyIntervention"/>
    <icare:activityContributesToGoal rdf:resource="https://w3id.org/icareonto/education/activity-templates/EDU-HEALTHY-CHOICES/goal"/>
    <edu:templateStatus>Draft</edu:templateStatus>
    <edu:learningObjective>Identify one practical nutrition or activity question or action relevant to the participant's interests and circumstances.</edu:learningObjective>
  </rdf:Description>
