    <edu:accessConditions>Public</edu:accessConditions>
    <dcterms:title>Transition - Der Übergang von der Kinder- und Jugendmedizin in die Erwachsenenmedizin</dcterms:title>
    <icare:knowledgeResourceHasComplexityLevel rdf:resource="https://w3id.org/icareonto/StandardComplexity"/>
    <dcterms:description>Explanation of the transition from paediatric to adult healthcare, including continuity of follow-up, preparation, growing independence, care planning and possible sources of support.</dcterms:description>
