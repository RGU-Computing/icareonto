    <edu:curatedBy>INO</edu:curatedBy>
    <edu:completionStatus>Complete</edu:completionStatus>
    <dcterms:publisher>Associação de Investigação de Cuidados de Suporte em Oncologia (AICSO); Andreia Capela, Luciana Teixeira, Elsa Madureira and Sara Torcato Parreira</dcterms:publisher>
    <edu:curationStatus>Approved</edu:curationStatus>
    <dcterms:rights>Link / Signpost Only</dcterms:rights>
    <dcterms:title>Guia de Alimentação na Pessoa com Cancro</dcterms:title>
    <dcterms:source rdf:resource="https://aicso.pt/wp-content/uploads/2024/04/Guia-de-Alimentacao-Doente-Cancro_Digital.pdf"/>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">pt</dcterms:language>
    <rdfs:label>Guia de Alimentação na Pessoa com Cancro</rdfs:label>
    <dcterms:description>Guide explaining nutrition during and after cancer treatment, food-related myths, symptoms affecting intake, when to seek nutritional support and practical dietary adjustments, with a dedicated post-treatment section.</dcterms:description>
  </rdf:Description>
