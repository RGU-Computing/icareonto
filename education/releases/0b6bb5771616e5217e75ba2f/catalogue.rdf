    <dcterms:description>Practical advice on finding and evaluating online cancer information, including checking source authority, publication dates, author credentials, supporting evidence and sensational claims. Identifies types of information sources patients and families can consult.</dcterms:description>
    <icare:knowledgeResourceHasFormat rdf:resource="https://w3id.org/icareonto/WrittenText"/>
    <edu:accessConditions>Public</edu:accessConditions>
    <edu:completionStatus>Complete</edu:completionStatus>
