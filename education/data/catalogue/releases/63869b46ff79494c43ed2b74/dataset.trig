<http://maya-project.eu/icareonto/education/graphs/activities> {
    <http://maya-project.eu/icareonto/education/activity-templates/EDU-AFTER-TREATMENT> a ns1:EducationActivity,
            ns1:HealthLiteracyIntervention,
            owl:NamedIndividual ;
        rdfs:label "Adjusting to life after treatment" ;
        ns1:activityContributesToGoal <http://maya-project.eu/icareonto/education/activity-templates/EDU-AFTER-TREATMENT/goal> ;
        ns2:learningObjective "Recognise an information or support need concerning life after treatment and identify a suitable source of support." ;
        ns2:learningStep "1. Ask which aspect of adjustment the participant wishes to discuss, without inferring a literacy need from emotional distress alone.",
            "2. Offer a reviewed resource matching the recorded need, topic and language.",
            "3. Invite reflection on what feels relevant and what remains unclear.",
            "4. Identify a person or service the participant may choose to approach; follow the avatar's operational support and escalation arrangements." ;
        ns2:reflectionPrompt "1. Which part of this information feels relevant to your situation?",
            "2. Who could you talk to, or what further information would help?" ;
        ns2:templateStatus "Draft" ;
        ns1:healthLiteracyInterventionAddressesNeed ns1:InformationComprehensionSupportNeed,
            ns1:SelfManagementSupportNeed,
            ns1:SocialSupportNeed ;
        ns1:healthLiteracyInterventionUsesResource <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0009>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0010>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0011>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0013>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0019>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0020>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0021>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0030>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0046>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0077a>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0077b>,
