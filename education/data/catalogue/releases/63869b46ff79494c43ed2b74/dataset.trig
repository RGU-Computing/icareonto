            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0180> .

    <http://maya-project.eu/icareonto/education/activity-templates/EDU-CV-FOLLOWUP> a ns1:EducationActivity,
            ns1:HealthLiteracyIntervention,
            owl:NamedIndividual ;
        rdfs:label "Understanding cardiovascular follow-up" ;
        ns1:activityContributesToGoal <http://maya-project.eu/icareonto/education/activity-templates/EDU-CV-FOLLOWUP/goal> ;
        ns2:learningObjective "Identify the purpose of cardiovascular follow-up and formulate a question for the care team about the participant's own follow-up." ;
        ns2:learningStep "1. Introduce the topic using the participant's stated question and identified support need.",
            "2. Offer a suitable reviewed resource in the participant's language and explain its access conditions.",
            "3. Invite the participant to explain the main message in their own words and identify any unclear information.",
            "4. Help the participant prepare a question for their care team; personal monitoring decisions remain with the care team." ;
        ns2:reflectionPrompt "1. In your own words, what is the main reason for the follow-up described in this resource?",
            "2. What would you like your care team to explain about your own follow-up?" ;
        ns2:templateStatus "Draft" ;
        ns1:healthLiteracyInterventionAddressesNeed ns1:CareTeamCommunicationSupportNeed,
            ns1:InformationComprehensionSupportNeed ;
        ns1:healthLiteracyInterventionUsesResource <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0004>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0017>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0018>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0077a>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0077b>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0077c>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0077d>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0077e>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0170>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0183> .

    <http://maya-project.eu/icareonto/education/activity-templates/EDU-HEALTHY-CHOICES> a ns1:EducationActivity,
            ns1:HealthLiteracyIntervention,
            owl:NamedIndividual ;
        rdfs:label "Making manageable everyday health choices" ;
        ns1:activityContributesToGoal <http://maya-project.eu/icareonto/education/activity-templates/EDU-HEALTHY-CHOICES/goal> ;
        ns2:learningObjective "Identify one practical nutrition or activity question or action relevant to the participant's interests and circumstances." ;
        ns2:learningStep "1. Ask whether the participant wants information about food choices or physical activity.",
            "2. Select a resource matching that topic, the identified support need and the participant's preferences.",
            "3. Invite the participant to identify one manageable idea and any barriers or questions.",
            "4. Distinguish general educational information from an individual dietary or exercise prescription." ;
        ns2:reflectionPrompt "1. Which idea from the resource would you like to explore?",
            "2. What support or advice would you need before trying it?" ;
        ns2:templateStatus "Draft" ;
        ns1:healthLiteracyInterventionAddressesNeed ns1:InformationApplicationSupportNeed,
            ns1:SelfManagementSupportNeed ;
        ns1:healthLiteracyInterventionUsesResource <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0005>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0007>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0008>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0023>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0046>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0061>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0077a>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0077b>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0077c>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0077d>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0077e>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0167>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0167a>,
            <http://maya-project.eu/icareonto/education/resources/MAYA-EDU-0170>,
