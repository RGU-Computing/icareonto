@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/icareonto/shapes/diagnosisDateFormat> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:message "Expected a valid iso-calendar-date string." ;
    sh:not [ sh:pattern "\\s" ] ;
    sh:path <https://w3id.org/icareonto/diagnosisDate> ;
    sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" ;
    sh:sparql [ sh:message "Calendar date must exist in years 0001–9999." ;
            sh:select """PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?value WHERE {
  $this <https://w3id.org/icareonto/diagnosisDate> ?value .
  BIND(xsd:integer(SUBSTR(STR(?value), 1, 4)) AS ?year)
  BIND(xsd:integer(SUBSTR(STR(?value), 6, 2)) AS ?month)
  BIND(xsd:integer(SUBSTR(STR(?value), 9, 2)) AS ?day)
  BIND((?year / 4 = FLOOR(?year / 4)) &&
       ((?year / 100 != FLOOR(?year / 100)) || (?year / 400 = FLOOR(?year / 400))) AS ?leap)
  BIND(IF(?month = 2, IF(?leap, 29, 28), IF(?month IN (4, 6, 9, 11), 30, 31)) AS ?days)
  FILTER(?year < 1 || ?day > ?days)
}""" ] ;
    sh:targetSubjectsOf <https://w3id.org/icareonto/diagnosisDate> .

<https://w3id.org/icareonto/shapes/estimatedCompletionTimeFormat> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:message "Expected a valid iso-duration string." ;
    sh:not [ sh:pattern "\\s" ] ;
    sh:path <https://w3id.org/icareonto/estimatedCompletionTime> ;
    sh:pattern "^-?P([0-9]+W|([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)(T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|[0-9]+M([0-9]+(\\.[0-9]+)?S)?|[0-9]+(\\.[0-9]+)?S))?|T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|[0-9]+M([0-9]+(\\.[0-9]+)?S)?|[0-9]+(\\.[0-9]+)?S))$" ;
    sh:targetSubjectsOf <https://w3id.org/icareonto/estimatedCompletionTime> .

<https://w3id.org/icareonto/shapes/intervalDurationFormat> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:message "Expected a valid iso-duration string." ;
    sh:not [ sh:pattern "\\s" ] ;
    sh:path <https://w3id.org/icareonto/intervalDuration> ;
    sh:pattern "^-?P([0-9]+W|([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)(T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|[0-9]+M([0-9]+(\\.[0-9]+)?S)?|[0-9]+(\\.[0-9]+)?S))?|T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|[0-9]+M([0-9]+(\\.[0-9]+)?S)?|[0-9]+(\\.[0-9]+)?S))$" ;
    sh:targetSubjectsOf <https://w3id.org/icareonto/intervalDuration> .

<https://w3id.org/icareonto/shapes/serviceUseDurationFormat> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:message "Expected a valid iso-duration string." ;
    sh:not [ sh:pattern "\\s" ] ;
    sh:path <https://w3id.org/icareonto/serviceUseDuration> ;
    sh:pattern "^-?P([0-9]+W|([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)(T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|[0-9]+M([0-9]+(\\.[0-9]+)?S)?|[0-9]+(\\.[0-9]+)?S))?|T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|[0-9]+M([0-9]+(\\.[0-9]+)?S)?|[0-9]+(\\.[0-9]+)?S))$" ;
    sh:targetSubjectsOf <https://w3id.org/icareonto/serviceUseDuration> .

