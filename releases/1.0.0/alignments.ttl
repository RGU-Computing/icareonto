@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix icare: <https://w3id.org/icareonto/> .
@prefix meta: <https://w3id.org/icareonto/metadata#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icare:alignments a owl:Ontology ;
    rdfs:label "iCARE Onto external alignments"@en ;
    dcterms:contributor "MAYA consortium partners" ;
    dcterms:creator "Robert Gordon University" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright (c) 2026 Robert Gordon University and contributing MAYA consortium partners, for their respective contributions. Third-party material retains its applicable terms."@en ;
    rdfs:comment "Semantic relationships connecting iCARE Onto entities to external ontology concepts while preserving their domain-specific meaning."@en ;
    owl:imports <https://w3id.org/icareonto/releases/1.0.0/agent>,
        <https://w3id.org/icareonto/releases/1.0.0/imports/prov-reference>,
        <https://w3id.org/icareonto/releases/1.0.0/metadata>,
        <https://w3id.org/icareonto/releases/1.0.0/provenance-governance> ;
    owl:versionIRI <https://w3id.org/icareonto/releases/1.0.0/alignments> ;
    owl:versionInfo "1.0.0" ;
    meta:releaseStatus "Published" .

icare:Agent rdfs:subClassOf prov:Agent .

icare:ConsentRecord rdfs:subClassOf prov:Entity .

icare:ParticipantKnowledgeGraph rdfs:subClassOf prov:Collection .

[] a owl:Axiom ;
    rdfs:comment "A participant KG is a collection of provenance-bearing entities."@en ;
    rdfs:seeAlso <https://www.w3.org/TR/prov-o/> ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource icare:ParticipantKnowledgeGraph ;
    owl:annotatedTarget prov:Collection ;
    meta:reviewStatus "Approved" .

[] a owl:Axiom ;
    rdfs:comment "The local Agent is scoped to MAYA/iCARE agents and is therefore narrower than prov:Agent."@en ;
    rdfs:seeAlso <https://www.w3.org/TR/prov-o/> ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource icare:Agent ;
    owl:annotatedTarget prov:Agent ;
    meta:reviewStatus "Approved" .

[] a owl:Axiom ;
    rdfs:comment "A consent record is a provenance-bearing information entity."@en ;
    rdfs:seeAlso <https://www.w3.org/TR/prov-o/> ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource icare:ConsentRecord ;
    owl:annotatedTarget prov:Entity ;
    meta:reviewStatus "Approved" .

