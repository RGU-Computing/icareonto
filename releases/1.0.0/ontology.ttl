    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:range <https://w3id.org/icareonto/TreatmentRegimen> ;
    skos:definition "Relates a treatment record to the regimen or protocol used."@en .

<https://w3id.org/icareonto/treatmentRecordHasSetting> a owl:ObjectProperty ;
    rdfs:label "has treatment setting"@en ;
    rdfs:domain <https://w3id.org/icareonto/CancerTreatmentRecord> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:range <https://w3id.org/icareonto/CancerTreatmentSetting> ;
    skos:definition "Identifies the timing or strategic relationship of the recorded treatment to other cancer treatments."@en .

<https://w3id.org/icareonto/treatmentRecordHasSource> a owl:ObjectProperty ;
    rdfs:label "has treatment source"@en ;
    rdfs:domain <https://w3id.org/icareonto/CancerTreatmentRecord> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:range <https://w3id.org/icareonto/DataSource> ;
    skos:definition "Relates a treatment record to its data source."@en .

<https://w3id.org/icareonto/treatmentRecordHasTreatmentPeriod> a owl:ObjectProperty ;
    rdfs:label "record has treatment period"@en ;
    rdfs:domain <https://w3id.org/icareonto/CancerTreatmentRecord> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:range <https://w3id.org/icareonto/TimeInterval> ;
    skos:definition "Relates Cancer Treatment Record to Time Interval. A treatment record may cover a broader episode than one exposure."@en .

<https://w3id.org/icareonto/treatmentRecordIndicatesExposure> a owl:ObjectProperty ;
    rdfs:label "record indicates exposure"@en ;
    rdfs:domain <https://w3id.org/icareonto/CancerTreatmentRecord> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:range <https://w3id.org/icareonto/TreatmentExposure> ;
    skos:definition "Relates Cancer Treatment Record to Treatment Exposure."@en .

<https://w3id.org/icareonto/treatmentRecordRecordedAt> a owl:ObjectProperty ;
    rdfs:label "recorded treatment at"@en ;
    rdfs:domain <https://w3id.org/icareonto/CancerTreatmentRecord> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:range <https://w3id.org/icareonto/Timepoint> ;
    skos:definition "Relates a treatment record to the time it was recorded or asserted."@en .

<https://w3id.org/icareonto/treatmentRecordRecordsTreatmentType> a owl:ObjectProperty ;
    rdfs:label "records treatment type"@en ;
    rdfs:domain <https://w3id.org/icareonto/CancerTreatmentRecord> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:range <https://w3id.org/icareonto/CancerTreatmentType> ;
    skos:definition "Relates Cancer Treatment Record to Cancer Treatment Type."@en .

<https://w3id.org/icareonto/treatmentRecordTreatsDiagnosis> a owl:ObjectProperty ;
    rdfs:label "treats diagnosis"@en ;
    rdfs:domain <https://w3id.org/icareonto/CancerTreatmentRecord> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:range <https://w3id.org/icareonto/CancerDiagnosis> ;
    skos:definition "Identifies the cancer diagnosis for which the recorded treatment was delivered."@en .

<https://w3id.org/icareonto/treatmentRegimenName> a owl:DatatypeProperty ;
    rdfs:label "treatment regimen name"@en ;
    rdfs:domain <https://w3id.org/icareonto/TreatmentRegimen> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:range xsd:string ;
    skos:definition "Records the name of a treatment regimen."@en .

<https://w3id.org/icareonto/turnSequenceNumber> a owl:DatatypeProperty ;
    rdfs:label "turn sequence number"@en ;
    rdfs:domain <https://w3id.org/icareonto/DialogueTurn> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Position of the turn within its dialogue session."@en .

<https://w3id.org/icareonto/turnText> a owl:DatatypeProperty ;
    rdfs:label "turn text"@en ;
    rdfs:domain <https://w3id.org/icareonto/DialogueTurn> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range xsd:string ;
    skos:definition "Textual content of a user utterance or agent response."@en .

<https://w3id.org/icareonto/unitCode> a owl:DatatypeProperty ;
    rdfs:label "unit code"@en ;
    rdfs:domain <https://w3id.org/icareonto/Unit> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    rdfs:range xsd:string ;
    skos:definition "Records the machine-readable code identifying the unit within a unit code system."@en .

<https://w3id.org/icareonto/unitCodeSystem> a owl:DatatypeProperty ;
    rdfs:label "unit code system"@en ;
    rdfs:domain <https://w3id.org/icareonto/Unit> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    rdfs:range xsd:anyURI ;
    skos:definition "Identifies the code system that defines the unit code."@en .

<https://w3id.org/icareonto/unitSymbol> a owl:DatatypeProperty ;
    rdfs:label "unit symbol"@en ;
    rdfs:domain <https://w3id.org/icareonto/Unit> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    rdfs:range xsd:string ;
    skos:definition "Records the human-readable symbol used to display the unit."@en .

<https://w3id.org/icareonto/userIntentRequiresSlot> a owl:ObjectProperty ;
    rdfs:label "requires slot"@en ;
    rdfs:domain <https://w3id.org/icareonto/UserIntent> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range <https://w3id.org/icareonto/SlotType> ;
    skos:definition "Identifies information required to fulfil an intent."@en .

<https://w3id.org/icareonto/userUtteranceExpressesIntent> a owl:ObjectProperty ;
    rdfs:label "expresses intent"@en ;
    rdfs:domain <https://w3id.org/icareonto/UserUtterance> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range <https://w3id.org/icareonto/UserIntent> ;
    skos:definition "Identifies an intent inferred from the utterance."@en .

skos:broadMatch a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has broader match"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:broader,
        skos:mappingRelation ;
    owl:inverseOf skos:narrowMatch ;
    skos:definition "skos:broadMatch is used to state a hierarchical mapping link between two conceptual resources in different concept schemes."@en .

skos:closeMatch a rdf:Property,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has close match"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:mappingRelation ;
    skos:definition "skos:closeMatch is used to link two concepts that are sufficiently similar that they can be used interchangeably in some information retrieval applications. In order to avoid the possibility of \"compound errors\" when combining mappings across more than two concept schemes, skos:closeMatch is not declared to be a transitive property."@en .

skos:hasTopConcept a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has top concept"@en ;
    rdfs:domain skos:ConceptScheme ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range skos:Concept ;
    owl:inverseOf skos:topConceptOf ;
    skos:definition "Relates, by convention, a concept scheme to a concept which is topmost in the broader/narrower concept hierarchies for that scheme, providing an entry point to these hierarchies."@en .

skos:inScheme a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "is in scheme"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range skos:ConceptScheme ;
    skos:definition "Relates a resource (for example a concept) to a concept scheme in which it is included."@en ;
    skos:scopeNote "A concept may be a member of more than one concept scheme."@en .

skos:narrowMatch a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has narrower match"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:mappingRelation,
        skos:narrower ;
    owl:inverseOf skos:broadMatch ;
    skos:definition "skos:narrowMatch is used to state a hierarchical mapping link between two conceptual resources in different concept schemes."@en .

skos:related a rdf:Property,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has related"@en ;
    rdfs:comment "skos:related is disjoint with skos:broaderTransitive"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:semanticRelation ;
    skos:definition "Relates a concept to a concept with which there is an associative semantic relationship."@en .

skos:topConceptOf a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "is top concept in scheme"@en ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range skos:ConceptScheme ;
    rdfs:subPropertyOf skos:inScheme ;
    owl:inverseOf skos:hasTopConcept ;
    skos:definition "Relates a concept to the concept scheme that it is a top level concept of."@en .

<https://w3id.org/icareonto/AYASurvivorAudience> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/icareonto/ResourceAudienceType> ;
    rdfs:label "AYA survivor audience"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/knowledge-resource> ;
    skos:definition "A resource-audience type representing adolescent and young adult cancer survivors."@en ;
    skos:inScheme <https://w3id.org/icareonto/ResourceAudienceTypeScheme> ;
    skos:prefLabel "AYA survivor audience"@en ;
    skos:topConceptOf <https://w3id.org/icareonto/ResourceAudienceTypeScheme> ;
    ns1:reviewStatus "Proposed" .

<https://w3id.org/icareonto/AboveReferenceRange> a owl:NamedIndividual,
        skos:Concept,
