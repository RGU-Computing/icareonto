<https://w3id.org/icareonto/cumulativeDrugDoseUnit> a owl:DatatypeProperty ;
    rdfs:label "cumulative drug dose unit"@en ;
    rdfs:domain <https://w3id.org/icareonto/SystemicTherapyExposure> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:range xsd:string ;
