<https://w3id.org/icareonto/intervalDuration> a owl:DatatypeProperty ;
    rdfs:label "interval duration"@en ;
    rdfs:domain <https://w3id.org/icareonto/TimeInterval> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/core> ;
    rdfs:range xsd:string ;
    skos:definition "Records the duration of a temporal interval as an ISO 8601 duration string, for example P7D for seven days or PT30M for thirty minutes."@en ;
    ns1:valueFormat "iso-duration" ;
    ns1:valuePattern "^-?P([0-9]+W|([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)(T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|[0-9]+M([0-9]+(\\.[0-9]+)?S)?|[0-9]+(\\.[0-9]+)?S))?|T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|[0-9]+M([0-9]+(\\.[0-9]+)?S)?|[0-9]+(\\.[0-9]+)?S))$" .

