<https://w3id.org/icareonto/BehaviourMetricType> a owl:Class ;
    rdfs:label "Behaviour Metric Type"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/lifestyle-behaviour> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept classifying the aspect of a lifestyle behaviour represented by a behaviour metric, such as sleep duration, daily step count or sedentary duration."@en .

<https://w3id.org/icareonto/CancerDiagnosis> a owl:Class ;
    rdfs:label "Cancer Diagnosis"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    skos:definition "A recorded diagnosis of cancer associated with a person, representing a current or historical cancer condition and providing context for treatment history, follow-up and assessment of potential late effects."@en .

<https://w3id.org/icareonto/CarePlan> a owl:Class ;
    rdfs:label "Care Plan"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/intervention-careplan> ;
    skos:altLabel "personalised care plan"@en ;
    skos:definition "Personalised plan of goals and activities used to support cardiovascular risk management, lifestyle change and follow-up."@en .

<https://w3id.org/icareonto/ClinicalRecord> a owl:Class ;
    rdfs:label "Clinical Record"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/clinical-profile> ;
    skos:definition "A dated clinical statement or record about a person's health status, medication, condition, symptom, assessment, or care-relevant finding."@en .

<https://w3id.org/icareonto/ExerciseActivityType> a owl:Class ;
    rdfs:label "Exercise Activity Type"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/exercise> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept representing a specific named exercise activity or movement, such as walking, cycling, squatting or resistance-band rowing."@en .

<https://w3id.org/icareonto/ExercisePrescription> a owl:Class ;
    rdfs:label "Exercise Prescription"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/exercise> ;
    skos:definition "A person-specific information specification defining intended exercise activities and their frequency, intensity, duration, sets, repetitions, load, rest, and progression."@en .

<https://w3id.org/icareonto/ResourceTopic> a owl:Class ;
    rdfs:label "Resource Topic"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/knowledge-resource> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Subject focus used for identification or retrieval of a resource."@en .

<https://w3id.org/icareonto/RiskEstimate> a owl:Class ;
    rdfs:label "Risk Estimate"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cv-risk> ;
    skos:definition "A quantitative or categorical estimate of the likelihood, severity, or level of cardiovascular risk for a condition or adverse event."@en .

<https://w3id.org/icareonto/SocialContextRecord> a owl:Class ;
    rdfs:label "Social Context Record"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/social-context> ;
    skos:definition "A time- and source-qualified statement or observation about a social context factor affecting a person."@en .

<https://w3id.org/icareonto/AgentCapability> a owl:Class ;
    rdfs:label "Agent Capability"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/agent> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept representing a function an agent is designed and authorised to perform."@en .

<https://w3id.org/icareonto/BehaviourChangeStageScheme> a owl:NamedIndividual,
        skos:ConceptScheme ;
