<https://w3id.org/icareonto/serviceUseDuration> a owl:DatatypeProperty ;
    rdfs:label "service use duration"@en ;
    rdfs:domain <https://w3id.org/icareonto/ServiceUseEvent> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/healthhub-service> ;
    rdfs:range xsd:string ;
    skos:definition "Records the elapsed duration of a service-use event as an ISO 8601 duration string, for example PT15M for fifteen minutes, supporting analysis of service engagement."@en ;
    ns1:valueFormat "iso-duration" ;
    ns1:valuePattern "^-?P([0-9]+W|([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)(T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|[0-9]+M([0-9]+(\\.[0-9]+)?S)?|[0-9]+(\\.[0-9]+)?S))?|T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|[0-9]+M([0-9]+(\\.[0-9]+)?S)?|[0-9]+(\\.[0-9]+)?S))$" .

