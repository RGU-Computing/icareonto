<https://w3id.org/icareonto/conversationAgentOverseenBy> a owl:ObjectProperty ;
    rdfs:label "overseen by"@en ;
    rdfs:domain <https://w3id.org/icareonto/DigitalAgent> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/agent> ;
    rdfs:range <https://w3id.org/icareonto/Person> ;
    skos:definition "Identifies a person responsible for oversight of the digital agent."@en .

<https://w3id.org/icareonto/criterionText> a owl:DatatypeProperty ;
