    rdfs:domain <https://w3id.org/icareonto/DataSource> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/core> ;
    rdfs:range xsd:string ;
    skos:definition "Records a textual description of the data source and what it contributes."@en .

<https://w3id.org/icareonto/dataSourceIdentifier> a owl:DatatypeProperty ;
    rdfs:label "data source identifier"@en ;
    rdfs:domain <https://w3id.org/icareonto/DataSource> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/core> ;
    rdfs:range xsd:string ;
    skos:definition "Records an identifier for a data source."@en .

<https://w3id.org/icareonto/dataSourceName> a owl:DatatypeProperty ;
    rdfs:label "data source name"@en ;
    rdfs:domain <https://w3id.org/icareonto/DataSource> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/core> ;
    rdfs:range xsd:string ;
    skos:definition "Records the display name or common name of a data source."@en .

<https://w3id.org/icareonto/derivedParameterDerivedFrom> a owl:ObjectProperty ;
    rdfs:label "derived from"@en ;
    rdfs:domain <https://w3id.org/icareonto/DerivedParameter> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    rdfs:range <https://w3id.org/icareonto/MeasurableParameter> ;
    skos:definition "Relates a derived parameter to source parameters used to calculate it."@en .

<https://w3id.org/icareonto/deviceProvidesAccessTo> a owl:ObjectProperty ;
    rdfs:label "provides access to"@en ;
    rdfs:domain <https://w3id.org/icareonto/Device> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/healthhub-service> ;
    rdfs:range <https://w3id.org/icareonto/DigitalService> ;
    skos:definition "Relates a device to a digital service that users can access through it."@en .

<https://w3id.org/icareonto/diagnosisDate> a owl:DatatypeProperty ;
    rdfs:label "diagnosis date"@en ;
    rdfs:domain <https://w3id.org/icareonto/CancerDiagnosis> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:range xsd:string ;
    skos:definition "Records the calendar date of cancer diagnosis, when known, as a string in YYYY-MM-DD format. No time of day or timezone is implied."@en ;
    ns1:valueFormat "iso-calendar-date" ;
    ns1:valuePattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" .

<https://w3id.org/icareonto/dialogueContextAddressesIntent> a owl:ObjectProperty ;
    rdfs:label "addresses intent"@en ;
    rdfs:domain <https://w3id.org/icareonto/DialogueContext> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range <https://w3id.org/icareonto/UserIntent> ;
    skos:definition "Identifies the intent currently being handled."@en .

<https://w3id.org/icareonto/dialogueContextHasSlot> a owl:ObjectProperty ;
    rdfs:label "has slot"@en ;
    rdfs:domain <https://w3id.org/icareonto/DialogueContext> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range <https://w3id.org/icareonto/DialogueSlot> ;
    skos:definition "Associates the current context with an expected or populated information slot."@en .

<https://w3id.org/icareonto/dialogueContextIncludesEntity> a owl:ObjectProperty ;
    rdfs:label "includes entity"@en ;
    rdfs:domain <https://w3id.org/icareonto/DialogueContext> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range owl:Thing ;
    skos:definition "Links the dialogue context to any relevant domain entity."@en .

<https://w3id.org/icareonto/dialogueSessionDeliveredThroughService> a owl:ObjectProperty ;
