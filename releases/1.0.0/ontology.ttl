@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <https://w3id.org/icareonto/metadata#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:bibliographicCitation a owl:AnnotationProperty ;
    rdfs:label "bibliographicCitation"@en .

dcterms:contributor a owl:AnnotationProperty ;
    rdfs:label "contributor"@en .

dcterms:creator a owl:AnnotationProperty ;
    rdfs:label "creator"@en .

dcterms:description a owl:AnnotationProperty ;
    rdfs:label "description"@en .

dcterms:identifier a owl:AnnotationProperty ;
    rdfs:label "identifier"@en .

dcterms:issued a owl:AnnotationProperty ;
    rdfs:label "issued"@en .

dcterms:language a owl:AnnotationProperty ;
    rdfs:label "language"@en .

dcterms:license a owl:AnnotationProperty ;
    rdfs:label "license"@en .

dcterms:modified a owl:AnnotationProperty ;
    rdfs:label "modified"@en .

dcterms:publisher a owl:AnnotationProperty ;
    rdfs:label "publisher"@en .

dcterms:rights a owl:AnnotationProperty ;
    rdfs:label "rights"@en .

dcterms:source a owl:AnnotationProperty ;
    rdfs:label "source"@en .

dcterms:title a owl:AnnotationProperty ;
    rdfs:label "title"@en .

skos:altLabel a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "alternative label"@en ;
    rdfs:comment "The range of skos:altLabel is the class of RDF plain literals."@en,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf rdfs:label ;
    skos:definition "An alternative lexical label for a resource."@en .

skos:changeNote a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "change note"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "A note about a modification to a concept."@en .

skos:definition a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "definition"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "A statement or formal explanation of the meaning of a concept."@en .

skos:editorialNote a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "editorial note"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "A note for an editor, translator or maintainer of the vocabulary."@en .

skos:exactMatch a rdf:Property,
        owl:ObjectProperty,
        owl:SymmetricProperty,
        owl:TransitiveProperty ;
    rdfs:label "has exact match"@en ;
    rdfs:comment "skos:exactMatch is disjoint with each of the properties skos:broadMatch and skos:relatedMatch."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:closeMatch ;
    skos:definition "skos:exactMatch is used to link two concepts, indicating a high degree of confidence that the concepts can be used interchangeably across a wide range of information retrieval applications. skos:exactMatch is a transitive property, and is a sub-property of skos:closeMatch."@en .

skos:example a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "example"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "An example of the use of a concept."@en .

skos:hiddenLabel a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "hidden label"@en ;
    rdfs:comment "The range of skos:hiddenLabel is the class of RDF plain literals."@en,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf rdfs:label ;
    skos:definition "A lexical label for a resource that should be hidden when generating visual displays of the resource, but should still be accessible to free text search operations."@en .

skos:historyNote a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "history note"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "A note about the past state/use/meaning of a concept."@en .

skos:notation a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "notation"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    skos:definition "A notation, also known as classification code, is a string of characters such as \"T58.5\" or \"303.4833\" used to uniquely identify a concept within the scope of a given concept scheme."@en ;
    skos:scopeNote "By convention, skos:notation is used with a typed literal in the object position of the triple."@en .

skos:prefLabel a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "preferred label"@en ;
    rdfs:comment "A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag."@en,
        "The range of skos:prefLabel is the class of RDF plain literals."@en,
        """skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise
      disjoint properties."""@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf rdfs:label ;
    skos:definition "The preferred lexical label for a resource, in a given language."@en .

skos:relatedMatch a rdf:Property,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has related match"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:mappingRelation,
        skos:related ;
    skos:definition "skos:relatedMatch is used to state an associative mapping link between two conceptual resources in different concept schemes."@en .

skos:scopeNote a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "scope note"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "A note that helps to clarify the meaning and/or the use of a concept."@en .

<https://w3id.org/icareonto/> a owl:Ontology ;
    rdfs:label "iCARE Onto"@en ;
    dcterms:contributor "MAYA consortium partners" ;
    dcterms:creator "Robert Gordon University" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright (c) 2026 Robert Gordon University and contributing MAYA consortium partners, for their respective contributions. Third-party material retains its applicable terms."@en ;
    rdfs:comment "iCARE Onto provides the semantic foundation for the MAYA iCARE Health Hub, supporting adolescent and young adult cancer survivorship and cardiovascular health. Its modular model represents people and preferences, cancer treatment history, clinical profiles, measurements, cardiovascular risk, personalised care, lifestyle, social context, educational resources, conversational interaction, digital services, pilot settings and knowledge governance. It supports participant- and pilot-specific knowledge graphs, personalised educational support and evidence-grounded dialogue."@en ;
    owl:versionIRI <https://w3id.org/icareonto/releases/1.0.0/icareonto> ;
    owl:versionInfo "1.0.0" ;
    ns1:releaseStatus "Published" .

<https://w3id.org/icareonto/AYACancerSurvivorRole> a owl:Class ;
    rdfs:label "AYA Cancer Survivor Role"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/person-role> ;
    rdfs:subClassOf <https://w3id.org/icareonto/CancerSurvivorRole> ;
    skos:altLabel "AYA survivor role"@en,
        "adolescent and young adult cancer survivor role"@en ;
    skos:definition "A cancer survivor role held by a person whose cancer diagnosis or treatment occurred during adolescence or young adulthood, typically between 15 and 39 years of age."@en .

<https://w3id.org/icareonto/AlcoholUseBehaviour> a owl:Class ;
    rdfs:label "Alcohol Use Behaviour"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/lifestyle-behaviour> ;
    rdfs:subClassOf <https://w3id.org/icareonto/LifestyleBehaviour> ;
    skos:definition "A behaviour describing alcohol consumption frequency, quantity, or risk level."@en .

<https://w3id.org/icareonto/AnthracyclineExposure> a owl:Class ;
    rdfs:label "Anthracycline Exposure"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:subClassOf <https://w3id.org/icareonto/ChemotherapyExposure> ;
    skos:definition "Exposure to anthracycline chemotherapy, represented because cumulative anthracycline dose is a key factor in cardiovascular late-effect risk."@en .

<https://w3id.org/icareonto/AnthropometricParameter> a owl:Class ;
    rdfs:label "Anthropometric Parameter"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    rdfs:subClassOf <https://w3id.org/icareonto/PhysiologicalParameter> ;
    skos:definition "A body-size or body-composition parameter, such as weight, height, BMI, waist circumference, or body fat percentage."@en .

<https://w3id.org/icareonto/BehaviouralParameter> a owl:Class ;
    rdfs:label "Behavioural Parameter"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    rdfs:subClassOf <https://w3id.org/icareonto/MeasurableParameter> ;
    skos:definition "A measurable parameter describing behaviour relevant to health, monitoring, adherence, or lifestyle risk."@en .

<https://w3id.org/icareonto/BloodPressureMeasurementProtocol> a owl:Class ;
    rdfs:label "Blood Pressure Measurement Protocol"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    rdfs:subClassOf <https://w3id.org/icareonto/MeasurementProtocol> ;
    skos:definition "A protocol specifying how an activity, measurement, assessment, or clinical process should be performed."@en .

<https://w3id.org/icareonto/BodyCompositionProtocol> a owl:Class ;
    rdfs:label "Body Composition Protocol"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    rdfs:subClassOf <https://w3id.org/icareonto/MeasurementProtocol> ;
    skos:definition "A protocol specifying how an activity, measurement, assessment, or clinical process should be performed."@en .

<https://w3id.org/icareonto/CardiacBiomarker> a owl:Class ;
    rdfs:label "Cardiac Biomarker"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    rdfs:subClassOf <https://w3id.org/icareonto/Biomarker> ;
    skos:definition "A biomarker relevant to cardiac function, injury, or cardiovascular risk monitoring."@en .

<https://w3id.org/icareonto/CardiovascularCondition> a owl:Class ;
    rdfs:label "Cardiovascular Condition"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/clinical-profile> ;
    rdfs:subClassOf <https://w3id.org/icareonto/ClinicalCondition> ;
    skos:definition "A clinical condition affecting the heart or vascular system, including hypertension, cardiomyopathy, arrhythmia, heart failure, or other cardiovascular late effects."@en .

<https://w3id.org/icareonto/CarePlanAdherenceBehaviour> a owl:Class ;
    rdfs:label "Care Plan Adherence Behaviour"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/lifestyle-behaviour> ;
    rdfs:subClassOf <https://w3id.org/icareonto/AdherenceBehaviour> ;
    skos:definition "Adherence behaviour specific to planned care-plan activities."@en .

<https://w3id.org/icareonto/CaregiverRole> a owl:Class ;
    rdfs:label "Caregiver Role"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/person-role> ;
    rdfs:subClassOf <https://w3id.org/icareonto/PersonRole> ;
    skos:definition "A support role held by a person who provides practical, emotional, health-related, or daily-living support to a survivor."@en .

<https://w3id.org/icareonto/ChemotherapyTreatment> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/icareonto/CancerTreatmentType> ;
    rdfs:label "Chemotherapy treatment"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    skos:broader <https://w3id.org/icareonto/SystemicTreatment> ;
    skos:definition "A cancer-treatment type involving cytotoxic medicines intended to destroy or inhibit cancer cells."@en ;
    skos:inScheme <https://w3id.org/icareonto/CancerTreatmentTypeScheme> ;
    skos:prefLabel "Chemotherapy treatment"@en ;
    ns1:reviewStatus "Proposed" .

<https://w3id.org/icareonto/ChestRadiotherapyExposure> a owl:Class ;
    rdfs:label "Chest Radiotherapy Exposure"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:subClassOf <https://w3id.org/icareonto/RadiotherapyExposure> ;
    skos:definition "Radiotherapy exposure involving the chest, mediastinum, heart region, or adjacent structures, represented because of its relevance to cardiovascular late-effect risk."@en .

<https://w3id.org/icareonto/ClinicalAssessmentActivity> a owl:Class ;
    rdfs:label "Clinical Assessment Activity"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/intervention-careplan> ;
    rdfs:subClassOf <https://w3id.org/icareonto/CarePlanActivity> ;
    skos:definition "A care-plan activity involving clinical review, examination, assessment, or interpretation of health status."@en .

<https://w3id.org/icareonto/ClinicalProtocol> a owl:Class ;
    rdfs:label "Clinical Protocol"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/knowledge-resource> ;
    rdfs:subClassOf <https://w3id.org/icareonto/KnowledgeResource> ;
    skos:definition "A structured resource specifying how a clinical, monitoring, assessment, or study procedure should be performed."@en .

<https://w3id.org/icareonto/ClinicalRecordDataSource> a owl:Class ;
    rdfs:label "Clinical Record Data Source"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    rdfs:subClassOf <https://w3id.org/icareonto/DataSource> ;
    skos:definition "A data source in which information was obtained from a clinical record or electronic health record."@en .

<https://w3id.org/icareonto/ClinicalVisitContext> a owl:Class ;
    rdfs:label "Clinical Visit Context"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    rdfs:subClassOf <https://w3id.org/icareonto/MeasurementContext> ;
    skos:definition "A measurement context in which a measurement is performed as part of a scheduled or unscheduled clinical visit or assessment."@en .

<https://w3id.org/icareonto/ClinicianRole> a owl:Class ;
    rdfs:label "Clinician Role"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/person-role> ;
    rdfs:subClassOf <https://w3id.org/icareonto/PersonRole> ;
    skos:definition "A care delivery role held by a healthcare professional involved in assessment, follow-up, treatment, monitoring, counselling, or clinical oversight."@en .

<https://w3id.org/icareonto/CulturalFactor> a owl:Class ;
    rdfs:label "Cultural Factor"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/social-context> ;
    rdfs:subClassOf <https://w3id.org/icareonto/SocialContextFactor> ;
    skos:definition "A person-stated cultural belief, practice, norm, or context relevant to communication, care, or intervention use."@en .

<https://w3id.org/icareonto/DemographicAttribute> a owl:Class ;
    rdfs:label "Demographic Attribute"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/person-role> ;
    rdfs:subClassOf <https://w3id.org/icareonto/PersonAttribute> ;
    skos:definition "A demographic attribute of a person, such as age group, sex, gender, country, or education-related demographic data."@en .

<https://w3id.org/icareonto/DeviceDataSource> a owl:Class ;
    rdfs:label "Device Data Source"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    rdfs:subClassOf <https://w3id.org/icareonto/DataSource> ;
    skos:definition "A data source in which information was produced, captured or transmitted by a measurement or monitoring device."@en .

<https://w3id.org/icareonto/DietaryPattern> a owl:Class ;
    rdfs:label "Dietary Pattern"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/lifestyle-behaviour> ;
    rdfs:subClassOf <https://w3id.org/icareonto/NutritionBehaviour> ;
    skos:definition "A nutrition behaviour representing an overall dietary pattern, such as Mediterranean diet, high-salt diet, or low-fibre diet."@en .

<https://w3id.org/icareonto/ECGMonitoringProtocol> a owl:Class ;
    rdfs:label "ECG Monitoring Protocol"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    rdfs:subClassOf <https://w3id.org/icareonto/MeasurementProtocol> ;
    skos:definition "A protocol specifying how an activity, measurement, assessment, or clinical process should be performed."@en .

<https://w3id.org/icareonto/EducationActivity> a owl:Class ;
    rdfs:label "Education Activity"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/intervention-careplan> ;
    rdfs:subClassOf <https://w3id.org/icareonto/CarePlanActivity> ;
    skos:definition "A care-plan activity that provides educational or self-management content."@en .

<https://w3id.org/icareonto/EducationalResource> a owl:Class ;
    rdfs:label "Educational Resource"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/knowledge-resource> ;
    rdfs:subClassOf <https://w3id.org/icareonto/KnowledgeResource> ;
    skos:definition "A resource designed to improve knowledge, understanding, skills, confidence, or self-management."@en .

<https://w3id.org/icareonto/EngagementParameter> a owl:Class ;
    rdfs:label "Engagement Parameter"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    rdfs:subClassOf <https://w3id.org/icareonto/MeasurableParameter> ;
    skos:definition "A measurable parameter describing interaction with services, adherence to monitoring, app use, session participation, or user engagement."@en .

<https://w3id.org/icareonto/EscalationActivity> a owl:Class ;
    rdfs:label "Escalation Activity"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/intervention-careplan> ;
    rdfs:subClassOf <https://w3id.org/icareonto/CarePlanActivity> ;
    skos:definition "A care-plan activity that routes a concern for clinical review, urgent follow-up, or safety oversight."@en .

<https://w3id.org/icareonto/FamilyMemberRole> a owl:Class ;
    rdfs:label "Family Member Role"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/person-role> ;
    rdfs:subClassOf <https://w3id.org/icareonto/PersonRole> ;
    skos:definition "A relationship-based support role held by a person who is a family member of a survivor and may contribute to care, support, communication, or contextual knowledge."@en .

<https://w3id.org/icareonto/FollowUpActivity> a owl:Class ;
    rdfs:label "Follow Up Activity"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/intervention-careplan> ;
    rdfs:subClassOf <https://w3id.org/icareonto/CarePlanActivity> ;
    skos:definition "A planned activity that continues review, monitoring, communication, or care after a prior assessment, event, or intervention."@en .

<https://w3id.org/icareonto/Guideline> a owl:Class ;
    rdfs:label "Guideline"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/knowledge-resource> ;
    rdfs:subClassOf <https://w3id.org/icareonto/KnowledgeResource> ;
    skos:definition "A systematically developed knowledge resource containing recommendations intended to support health, care, or policy decisions."@en .

<https://w3id.org/icareonto/HomeMonitoringContext> a owl:Class ;
    rdfs:label "Home Monitoring Context"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    rdfs:subClassOf <https://w3id.org/icareonto/MeasurementContext> ;
    skos:definition "A measurement context in which a measurement is performed outside a clinical setting as part of home-based or self-monitoring."@en .

<https://w3id.org/icareonto/ImmunotherapyExposure> a owl:Class ;
    rdfs:label "Immunotherapy Exposure"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:subClassOf <https://w3id.org/icareonto/SystemicTherapyExposure> ;
    skos:definition "Exposure to cancer immunotherapy, such as checkpoint inhibitors or immune-modulating treatments, with potential relevance to later clinical monitoring."@en .

<https://w3id.org/icareonto/ImmunotherapyTreatment> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/icareonto/CancerTreatmentType> ;
    rdfs:label "Immunotherapy treatment"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    skos:broader <https://w3id.org/icareonto/SystemicTreatment> ;
    skos:definition "A cancer-treatment type that modifies or uses immune-system activity to act against cancer."@en ;
    skos:inScheme <https://w3id.org/icareonto/CancerTreatmentTypeScheme> ;
    skos:prefLabel "Immunotherapy treatment"@en ;
    ns1:reviewStatus "Proposed" .

<https://w3id.org/icareonto/LaboratoryProtocol> a owl:Class ;
    rdfs:label "Laboratory Protocol"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    rdfs:subClassOf <https://w3id.org/icareonto/MeasurementProtocol> ;
    skos:definition "A protocol specifying how an activity, measurement, assessment, or clinical process should be performed."@en .

<https://w3id.org/icareonto/MeasurementDevice> a owl:Class ;
    rdfs:label "Measurement Device"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    rdfs:subClassOf <https://w3id.org/icareonto/Device>,
        <https://w3id.org/icareonto/MeasurementInstrument> ;
    skos:definition "A physical measurement instrument used to collect or generate data about a measurable parameter."@en .

<https://w3id.org/icareonto/MedicalCheckUpActivity> a owl:Class ;
    rdfs:label "Medical Check Up Activity"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/intervention-careplan> ;
    rdfs:subClassOf <https://w3id.org/icareonto/CarePlanActivity> ;
    skos:definition "A scheduled clinical check-up used for routine follow-up, monitoring, or review of survivorship care needs."@en .

<https://w3id.org/icareonto/MedicationAdherenceBehaviour> a owl:Class ;
    rdfs:label "Medication Adherence Behaviour"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/lifestyle-behaviour> ;
    rdfs:subClassOf <https://w3id.org/icareonto/AdherenceBehaviour> ;
    skos:definition "Adherence behaviour specific to medication use."@en .

<https://w3id.org/icareonto/MetabolicCondition> a owl:Class ;
    rdfs:label "Metabolic Condition"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/clinical-profile> ;
    rdfs:subClassOf <https://w3id.org/icareonto/ClinicalCondition> ;
    skos:definition "A clinical condition involving metabolic risk or dysfunction, such as diabetes, dyslipidaemia, obesity, insulin resistance, or metabolic syndrome."@en .

<https://w3id.org/icareonto/MonitoringActivity> a owl:Class ;
    rdfs:label "Monitoring Activity"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/intervention-careplan> ;
    rdfs:subClassOf <https://w3id.org/icareonto/CarePlanActivity> ;
    skos:definition "A care-plan activity that collects or reviews data to track symptoms, clinical status, measurements, adherence, or late-effect risk."@en .

<https://w3id.org/icareonto/MonitoringAdherenceBehaviour> a owl:Class ;
    rdfs:label "Monitoring Adherence Behaviour"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/lifestyle-behaviour> ;
    rdfs:subClassOf <https://w3id.org/icareonto/AdherenceBehaviour> ;
    skos:definition "Adherence behaviour specific to home monitoring, check-ins, measurements, or follow-up tasks."@en .

<https://w3id.org/icareonto/NonModifiableRiskFactor> a owl:Class ;
    rdfs:label "Non Modifiable Risk Factor"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cv-risk> ;
    rdfs:subClassOf <https://w3id.org/icareonto/RiskFactor> ;
    skos:definition "A risk factor that cannot usually be changed through behaviour or intervention, such as age, prior treatment exposure, diagnosis history, or inherited predisposition."@en .

<https://w3id.org/icareonto/PatientReportedOutcome> a owl:Class ;
    rdfs:label "Patient Reported Outcome"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
