    rdfs:domain <https://w3id.org/icareonto/DialogueSession> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range <https://w3id.org/icareonto/DigitalService> ;
    skos:definition "Identifies the digital service through which a dialogue session was conducted."@en .

<https://w3id.org/icareonto/dialogueSessionHasAgentParticipant> a owl:ObjectProperty ;
    rdfs:label "has agent participant"@en ;
    rdfs:domain <https://w3id.org/icareonto/DialogueSession> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range <https://w3id.org/icareonto/ConversationAgent> ;
    skos:definition "Identifies the conversational agent participating in the session."@en .

<https://w3id.org/icareonto/dialogueSessionHasParticipant> a owl:ObjectProperty ;
    rdfs:label "has participant"@en ;
    rdfs:domain <https://w3id.org/icareonto/DialogueSession> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range <https://w3id.org/icareonto/Person> ;
    skos:definition "Identifies the person participating in the dialogue session."@en .

<https://w3id.org/icareonto/dialogueSessionHasTurn> a owl:ObjectProperty ;
    rdfs:label "has turn"@en ;
    rdfs:domain <https://w3id.org/icareonto/DialogueSession> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range <https://w3id.org/icareonto/DialogueTurn> ;
    skos:definition "Associates a dialogue session with one of its turns."@en .

<https://w3id.org/icareonto/dialogueSessionStartedAt> a owl:ObjectProperty ;
    rdfs:label "started at"@en ;
    rdfs:domain <https://w3id.org/icareonto/DialogueSession> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range <https://w3id.org/icareonto/Timepoint> ;
    skos:definition "Identifies when the dialogue session began."@en .

<https://w3id.org/icareonto/dialogueSessionUsesStrategy> a owl:ObjectProperty ;
    rdfs:label "uses strategy"@en ;
    rdfs:domain <https://w3id.org/icareonto/DialogueSession> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range <https://w3id.org/icareonto/DialogueStrategy> ;
    skos:definition "Identifies a conversational strategy applied during the session."@en .

<https://w3id.org/icareonto/dialogueSlotConfidence> a owl:DatatypeProperty ;
    rdfs:label "dialogue slot confidence"@en ;
    rdfs:domain <https://w3id.org/icareonto/DialogueSlot> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range xsd:decimal ;
    skos:definition "Optional confidence (between 0 and 1) assigned to the extracted or inferred slot value."@en .

<https://w3id.org/icareonto/dialogueSlotExtractedFrom> a owl:ObjectProperty ;
    rdfs:label "extracted from"@en ;
    rdfs:domain <https://w3id.org/icareonto/DialogueSlot> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range <https://w3id.org/icareonto/UserUtterance> ;
    skos:definition "Identifies the utterance from which the slot value was extracted."@en .

<https://w3id.org/icareonto/dialogueSlotHasEntityValue> a owl:ObjectProperty ;
    rdfs:label "has entity value"@en ;
    rdfs:domain <https://w3id.org/icareonto/DialogueSlot> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range owl:Thing ;
    skos:definition "Links a filled slot to a structured ontology entity, such as an exercise activity or observation result."@en .

<https://w3id.org/icareonto/dialogueSlotHasStatus> a owl:ObjectProperty ;
    rdfs:label "has status"@en ;
    rdfs:domain <https://w3id.org/icareonto/DialogueSlot> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range <https://w3id.org/icareonto/SlotStatusValue> ;
    skos:definition "Identifies whether the slot is filled, missing, ambiguous, or awaiting confirmation."@en .

<https://w3id.org/icareonto/dialogueSlotHasType> a owl:ObjectProperty ;
    rdfs:label "has type"@en ;
    rdfs:domain <https://w3id.org/icareonto/DialogueSlot> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range <https://w3id.org/icareonto/SlotType> ;
    skos:definition "Identifies the kind of information represented by the slot."@en .

<https://w3id.org/icareonto/dialogueSlotLiteralValue> a owl:DatatypeProperty ;
    rdfs:label "dialogue slot literal value"@en ;
    rdfs:domain <https://w3id.org/icareonto/DialogueSlot> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range xsd:string ;
    skos:definition "Literal slot value when it is not represented by a structured ontology entity."@en .

<https://w3id.org/icareonto/dialogueStrategyAdaptedToContext> a owl:ObjectProperty ;
    rdfs:label "adapted to context"@en ;
    rdfs:domain <https://w3id.org/icareonto/DialogueStrategy> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range <https://w3id.org/icareonto/SocialContextRecord> ;
    skos:definition "Indicates that a dialogue strategy was adapted in response to recorded social context."@en .

<https://w3id.org/icareonto/dialogueTurnOccursAt> a owl:ObjectProperty ;
    rdfs:label "occurs at"@en ;
    rdfs:domain <https://w3id.org/icareonto/DialogueTurn> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:range <https://w3id.org/icareonto/Timepoint> ;
    skos:definition "Identifies when a dialogue turn occurred."@en .

<https://w3id.org/icareonto/digitalLiteracyHasLevel> a owl:ObjectProperty ;
    rdfs:label "has level"@en ;
    rdfs:domain <https://w3id.org/icareonto/DigitalLiteracy> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/social-context> ;
    rdfs:range <https://w3id.org/icareonto/LiteracyLevelValue> ;
    skos:definition "Summary digital level, such as limited, adequate, high, or unknown."@en .

<https://w3id.org/icareonto/digitalServiceHasType> a owl:ObjectProperty ;
    rdfs:label "has type"@en ;
    rdfs:domain <https://w3id.org/icareonto/DigitalService> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/healthhub-service> ;
    rdfs:range <https://w3id.org/icareonto/DigitalServiceType> ;
    skos:definition "Classifies the principal function of a digital service."@en .

<https://w3id.org/icareonto/distanceUnit> a owl:DatatypeProperty ;
    rdfs:label "distance unit"@en ;
    rdfs:domain <https://w3id.org/icareonto/ExerciseActivity> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/exercise> ;
    rdfs:range xsd:string ;
    skos:definition "Unit for distance, such as metres or kilometres."@en .

<https://w3id.org/icareonto/distanceValue> a owl:DatatypeProperty ;
    rdfs:label "distance value"@en ;
    rdfs:domain <https://w3id.org/icareonto/ExerciseActivity> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/exercise> ;
    rdfs:range xsd:decimal ;
    skos:definition "Intended or actual distance when relevant."@en .

<https://w3id.org/icareonto/doseFrequency> a owl:DatatypeProperty ;
    rdfs:label "dose frequency"@en ;
    rdfs:domain <https://w3id.org/icareonto/MedicationDose> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/clinical-profile> ;
    rdfs:range xsd:string ;
    skos:definition "Records dosing frequency as text."@en .

<https://w3id.org/icareonto/doseUnit> a owl:DatatypeProperty ;
    rdfs:label "dose unit"@en ;
    rdfs:domain <https://w3id.org/icareonto/MedicationDose> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/clinical-profile> ;
    rdfs:range xsd:string ;
    skos:definition "Records the medication dose unit."@en .

<https://w3id.org/icareonto/doseValue> a owl:DatatypeProperty ;
    rdfs:label "dose value"@en ;
    rdfs:domain <https://w3id.org/icareonto/MedicationDose> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/clinical-profile> ;
    rdfs:range xsd:decimal ;
    skos:definition "Records the numeric medication dose."@en .

<https://w3id.org/icareonto/durationMinutes> a owl:DatatypeProperty ;
    rdfs:label "duration in minutes"@en ;
    rdfs:domain <https://w3id.org/icareonto/ExerciseActivity> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/exercise> ;
    rdfs:range xsd:decimal ;
    skos:definition "Intended or actual duration; interpretation comes from prescription or performed-session context."@en .

<https://w3id.org/icareonto/estimatedCompletionTime> a owl:DatatypeProperty ;
    rdfs:label "estimated completion time"@en ;
    rdfs:domain <https://w3id.org/icareonto/KnowledgeResource> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/knowledge-resource> ;
    rdfs:range xsd:string ;
    skos:definition "Records the estimated time required to read, watch or complete a knowledge resource as an ISO 8601 duration string, for example PT10M for ten minutes."@en ;
    ns1:valueFormat "iso-duration" ;
    ns1:valuePattern "^-?P([0-9]+W|([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)(T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|[0-9]+M([0-9]+(\\.[0-9]+)?S)?|[0-9]+(\\.[0-9]+)?S))?|T([0-9]+H([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|[0-9]+M([0-9]+(\\.[0-9]+)?S)?|[0-9]+(\\.[0-9]+)?S))$" .

<https://w3id.org/icareonto/exerciseActivityHasActivityType> a owl:ObjectProperty ;
    rdfs:label "has activity type"@en ;
    rdfs:domain <https://w3id.org/icareonto/ExerciseActivity> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/exercise> ;
    rdfs:range <https://w3id.org/icareonto/ExerciseActivityType> ;
    skos:definition "Classifies the activity as walking, cycling, squat, etc."@en .

<https://w3id.org/icareonto/exerciseActivityHasIntensity> a owl:ObjectProperty ;
    rdfs:label "has intensity"@en ;
    rdfs:domain <https://w3id.org/icareonto/ExerciseActivity> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/exercise> ;
    rdfs:range <https://w3id.org/icareonto/ExerciseIntensity> ;
    skos:definition "Associates an activity with prescribed or reported intensity."@en .

<https://w3id.org/icareonto/exerciseActivityHasSet> a owl:ObjectProperty ;
    rdfs:label "has set"@en ;
    rdfs:domain <https://w3id.org/icareonto/ExerciseActivity> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/exercise> ;
    rdfs:range <https://w3id.org/icareonto/ExerciseSet> ;
    skos:definition "Associates an activity with set, repetition, load, and rest information."@en .

<https://w3id.org/icareonto/exerciseActivityHasTrainingPattern> a owl:ObjectProperty ;
    rdfs:label "has training pattern"@en ;
