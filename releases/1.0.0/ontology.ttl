    skos:definition "Relates Clinical Condition Record to Severity."@en .

<https://w3id.org/icareonto/conditionRecordRecordsCondition> a owl:ObjectProperty ;
    rdfs:label "records condition"@en ;
    rdfs:domain <https://w3id.org/icareonto/ClinicalConditionRecord> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/clinical-profile> ;
    rdfs:range <https://w3id.org/icareonto/ClinicalCondition> ;
    skos:definition "Relates Clinical Condition Record to Clinical Condition."@en .

<https://w3id.org/icareonto/conditionRecordResolvedAt> a owl:ObjectProperty ;
    rdfs:label "record resolved at"@en ;
    rdfs:domain <https://w3id.org/icareonto/ClinicalConditionRecord> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/clinical-profile> ;
    rdfs:range <https://w3id.org/icareonto/Timepoint> ;
    skos:definition "Relates a condition record to the time the condition resolved, if known."@en .

<https://w3id.org/icareonto/conditionRecordValidDuring> a owl:ObjectProperty ;
    rdfs:label "record valid during"@en ;
    rdfs:domain <https://w3id.org/icareonto/ClinicalConditionRecord> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/clinical-profile> ;
    rdfs:range <https://w3id.org/icareonto/TimeInterval> ;
    skos:definition "Relates a condition record to the interval during which the condition status applies."@en .

<https://w3id.org/icareonto/consentRecordAppliesToKnowledgeGraph> a owl:ObjectProperty ;
    rdfs:label "applies to knowledge graph"@en ;
    rdfs:domain <https://w3id.org/icareonto/ConsentRecord> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/provenance-governance> ;
    rdfs:range <https://w3id.org/icareonto/ParticipantKnowledgeGraph> ;
    skos:definition "Identifies the graph to which the consent applies."@en .

<https://w3id.org/icareonto/consentRecordGrantedBy> a owl:ObjectProperty ;
    rdfs:label "granted by"@en ;
    rdfs:domain <https://w3id.org/icareonto/ConsentRecord> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/provenance-governance> ;
    rdfs:range <https://w3id.org/icareonto/Person> ;
    skos:definition "Identifies the person who made the consent decision."@en .

<https://w3id.org/icareonto/consentRecordHasStatus> a owl:ObjectProperty ;
    rdfs:label "has status"@en ;
    rdfs:domain <https://w3id.org/icareonto/ConsentRecord> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/provenance-governance> ;
    rdfs:range <https://w3id.org/icareonto/ConsentStatusValue> ;
    skos:definition "Identifies the current consent status."@en .

<https://w3id.org/icareonto/consentRecordValidDuring> a owl:ObjectProperty ;
    rdfs:label "valid during"@en ;
    rdfs:domain <https://w3id.org/icareonto/ConsentRecord> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/provenance-governance> ;
    rdfs:range <https://w3id.org/icareonto/TimeInterval> ;
    skos:definition "Identifies the period during which the consent is valid."@en .

<https://w3id.org/icareonto/contextFactorDescriptionText> a owl:DatatypeProperty ;
    rdfs:label "context factor description text"@en ;
    rdfs:domain <https://w3id.org/icareonto/SocialContextFactor> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/social-context> ;
    rdfs:range xsd:string ;
    skos:definition "A person-specific explanation of social context factor."@en .

<https://w3id.org/icareonto/contraindicationText> a owl:DatatypeProperty ;
    rdfs:label "contraindication text"@en ;
    rdfs:domain <https://w3id.org/icareonto/Contraindication> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/knowledge-resource> ;
    rdfs:range xsd:string ;
    skos:definition "Human-readable description of a reason the recommendation may be unsuitable."@en .

<https://w3id.org/icareonto/contributionMetricType> a owl:DatatypeProperty ;
    rdfs:label "contribution metric type"@en ;
    rdfs:domain <https://w3id.org/icareonto/RiskFactorContribution> ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cv-risk> ;
