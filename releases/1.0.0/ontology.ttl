        <https://w3id.org/icareonto/SedentaryDuration>,
        <https://w3id.org/icareonto/SleepDuration>,
        <https://w3id.org/icareonto/SleepQuality> .

<https://w3id.org/icareonto/ObservationResult> a owl:Class ;
    rdfs:label "Observation Result"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    skos:definition "The result produced by a measurement event, including numeric, categorical, score, textual, unit, threshold, and interpretation information."@en .

<https://w3id.org/icareonto/ResourceTopicScheme> a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Resource Topic scheme"@en ;
    skos:hasTopConcept <https://w3id.org/icareonto/CardiovascularLateEffects>,
        <https://w3id.org/icareonto/DigitalHealthPrivacyAndTrust>,
        <https://w3id.org/icareonto/FollowUpCare>,
        <https://w3id.org/icareonto/MentalHealthAndEmotionalWellbeing>,
        <https://w3id.org/icareonto/Nutrition>,
        <https://w3id.org/icareonto/PhysicalActivity>,
        <https://w3id.org/icareonto/SelfMonitoring>,
        <https://w3id.org/icareonto/Smoking> .

<https://w3id.org/icareonto/KnowledgeResource> a owl:Class ;
    rdfs:label "Knowledge Resource"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/knowledge-resource> ;
    skos:definition "An identifiable information resource used to support education, evidence-grounded dialogue, recommendations, care activities, or clinical and study procedures."@en .

<https://w3id.org/icareonto/MeasurableParameter> a owl:Class ;
    rdfs:label "Measurable Parameter"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    skos:definition "A clinical, physiological, behavioural, psychological, performance, engagement, or reported variable that can be measured or observed."@en .

<https://w3id.org/icareonto/AgentCapabilityScheme> a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Agent Capability scheme"@en ;
    skos:hasTopConcept <https://w3id.org/icareonto/CarePlanSupportCapability>,
        <https://w3id.org/icareonto/ClarificationCapability>,
        <https://w3id.org/icareonto/ConversationalInteractionCapability>,
        <https://w3id.org/icareonto/HealthEducationCapability>,
        <https://w3id.org/icareonto/HealthLiteracySupportCapability>,
        <https://w3id.org/icareonto/LifestyleCoachingCapability>,
        <https://w3id.org/icareonto/ResourceRecommendationCapability>,
        <https://w3id.org/icareonto/SafetyEscalationCapability>,
        <https://w3id.org/icareonto/SelfMonitoringSupportCapability> .

<https://w3id.org/icareonto/HealthLiteracyNeedTypeScheme> a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Health Literacy Need Type scheme"@en ;
    skos:hasTopConcept <https://w3id.org/icareonto/CareTeamCommunicationSupportNeed>,
        <https://w3id.org/icareonto/DigitalInteractionSupportNeed>,
        <https://w3id.org/icareonto/HealthcareNavigationSupportNeed>,
        <https://w3id.org/icareonto/InformationAccessSupportNeed>,
        <https://w3id.org/icareonto/InformationApplicationSupportNeed>,
        <https://w3id.org/icareonto/InformationAppraisalSupportNeed>,
        <https://w3id.org/icareonto/InformationComprehensionSupportNeed>,
        <https://w3id.org/icareonto/SelfManagementSupportNeed>,
        <https://w3id.org/icareonto/SocialSupportNeed> .

<https://w3id.org/icareonto/UserIntentScheme> a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "User Intent scheme"@en ;
    skos:hasTopConcept <https://w3id.org/icareonto/ConfirmInformation>,
        <https://w3id.org/icareonto/RejectInformation>,
        <https://w3id.org/icareonto/ReportActivity>,
        <https://w3id.org/icareonto/ReportMeasurement>,
        <https://w3id.org/icareonto/ReportSymptom>,
        <https://w3id.org/icareonto/RequestExplanation>,
        <https://w3id.org/icareonto/RequestInformation>,
        <https://w3id.org/icareonto/RequestPlanChange>,
        <https://w3id.org/icareonto/RequestRecommendation> .

<https://w3id.org/icareonto/SlotTypeScheme> a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Slot Type scheme"@en ;
    skos:hasTopConcept <https://w3id.org/icareonto/ActivityTypeSlot>,
        <https://w3id.org/icareonto/GoalSlot>,
        <https://w3id.org/icareonto/MeasurementTimeSlot>,
        <https://w3id.org/icareonto/MeasurementTypeSlot>,
        <https://w3id.org/icareonto/MeasurementUnitSlot>,
        <https://w3id.org/icareonto/MeasurementValueSlot>,
        <https://w3id.org/icareonto/ResourceTopicSlot>,
        <https://w3id.org/icareonto/SymptomOnsetSlot>,
        <https://w3id.org/icareonto/SymptomSeveritySlot>,
        <https://w3id.org/icareonto/SymptomTypeSlot> .

<https://w3id.org/icareonto/Person> a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/person-role> ;
    skos:definition "A human actor represented in the ontology, such as an AYA cancer survivor, clinician, caregiver, family member, researcher, or study participant."@en .

<https://w3id.org/icareonto/Timepoint> a owl:Class ;
    rdfs:label "Timepoint"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/core> ;
    rdfs:subClassOf <https://w3id.org/icareonto/TemporalEntity> ;
    skos:definition "A temporal point or instant used to timestamp records, events, assessments, schedules, and model executions."@en .

<https://w3id.org/icareonto/CarePlanActivity> a owl:Class ;
    rdfs:label "Care Plan Activity"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/intervention-careplan> ;
    skos:definition "A planned activity within a care plan, including interventions, monitoring, assessment, follow-up, and surveillance."@en .

skos:ConceptScheme a owl:Class ;
    rdfs:label "Concept Scheme"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    owl:disjointWith skos:Concept ;
    skos:definition "A set of concepts, optionally including statements about semantic relationships between those concepts."@en ;
    skos:scopeNote "A concept scheme may be defined to include concepts from different sources."@en .

skos:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    skos:definition "An idea or notion; a unit of thought."@en .

[] a owl:Axiom ;
    rdfs:comment "A participant KG is a collection of provenance-bearing entities."@en ;
    rdfs:seeAlso <https://www.w3.org/TR/prov-o/> ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource <https://w3id.org/icareonto/ParticipantKnowledgeGraph> ;
    owl:annotatedTarget prov:Collection ;
    ns1:reviewStatus "Approved" .

[] a owl:Axiom ;
    rdfs:comment "The local Agent is scoped to MAYA/iCARE agents and is therefore narrower than prov:Agent."@en ;
    rdfs:seeAlso <https://www.w3.org/TR/prov-o/> ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource <https://w3id.org/icareonto/Agent> ;
    owl:annotatedTarget prov:Agent ;
    ns1:reviewStatus "Approved" .

[] a owl:Axiom ;
    rdfs:comment "A consent record is a provenance-bearing information entity."@en ;
    rdfs:seeAlso <https://www.w3.org/TR/prov-o/> ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource <https://w3id.org/icareonto/ConsentRecord> ;
    owl:annotatedTarget prov:Entity ;
    ns1:reviewStatus "Approved" .

