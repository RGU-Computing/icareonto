<https://w3id.org/icareonto/WeeklyRecurrence> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/icareonto/RecurrencePattern> ;
    rdfs:label "Weekly recurrence"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/core> ;
    skos:definition "A recurrence pattern in which an activity is expected to recur each week."@en ;
    skos:inScheme <https://w3id.org/icareonto/RecurrencePatternScheme> ;
    skos:prefLabel "Weekly recurrence"@en ;
    skos:topConceptOf <https://w3id.org/icareonto/RecurrencePatternScheme> ;
    ns1:reviewStatus "Proposed" .

<https://w3id.org/icareonto/WholeGrains> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/icareonto/DietaryComponent> ;
    rdfs:label "Whole grains"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/nutrition> ;
    skos:definition "A dietary component representing whole grains as a target of nutrition guidance."@en ;
    skos:inScheme <https://w3id.org/icareonto/DietaryComponentScheme> ;
    skos:prefLabel "Whole grains"@en ;
    skos:topConceptOf <https://w3id.org/icareonto/DietaryComponentScheme> ;
    ns1:reviewStatus "Proposed" .

<https://w3id.org/icareonto/WithdrawnEnrolmentStatus> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/icareonto/EnrolmentStatusValue> ;
    rdfs:label "Withdrawn enrolment status"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/pilot> ;
    skos:definition "An enrolment status indicating that the person withdrew or was withdrawn before completing participation."@en ;
    skos:inScheme <https://w3id.org/icareonto/EnrolmentStatusValueScheme> ;
    skos:prefLabel "Withdrawn enrolment status"@en ;
    skos:topConceptOf <https://w3id.org/icareonto/EnrolmentStatusValueScheme> ;
    ns1:reviewStatus "Proposed" .

<https://w3id.org/icareonto/WithinReferenceRange> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/icareonto/ThresholdCategory> ;
    rdfs:label "Within reference range"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    skos:definition "A threshold category indicating that the observed value falls within the applicable reference range."@en ;
    skos:inScheme <https://w3id.org/icareonto/ThresholdCategoryScheme> ;
