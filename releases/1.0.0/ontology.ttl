    skos:definition "A resource format that uses written text as its primary presentation format."@en ;
    skos:inScheme <https://w3id.org/icareonto/ResourceFormatScheme> ;
    skos:prefLabel "Written text"@en ;
    skos:topConceptOf <https://w3id.org/icareonto/ResourceFormatScheme> ;
    ns1:reviewStatus "Proposed" .

skos:broader a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has broader"@en ;
    rdfs:comment "Broader concepts are typically rendered as parents in a concept hierarchy (tree)."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:broaderTransitive ;
    owl:inverseOf skos:narrower ;
    skos:definition "Relates a concept to a concept that is more general in meaning."@en ;
    skos:scopeNote "By convention, skos:broader is only used to assert an immediate (i.e. direct) hierarchical link between two conceptual resources."@en .

skos:broaderTransitive a rdf:Property,
        owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has broader transitive"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:semanticRelation ;
    owl:inverseOf skos:narrowerTransitive ;
    skos:definition "skos:broaderTransitive is a transitive superproperty of skos:broader." ;
    skos:scopeNote "By convention, skos:broaderTransitive is not used to make assertions. Rather, the properties can be used to draw inferences about the transitive closure of the hierarchical relation, which is useful e.g. when implementing a simple query expansion algorithm in a search application."@en .

skos:narrower a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has narrower"@en ;
    rdfs:comment "Narrower concepts are typically rendered as children in a concept hierarchy (tree)."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:narrowerTransitive ;
    owl:inverseOf skos:broader ;
    skos:definition "Relates a concept to a concept that is more specific in meaning."@en ;
    skos:scopeNote "By convention, skos:broader is only used to assert an immediate (i.e. direct) hierarchical link between two conceptual resources."@en .

skos:narrowerTransitive a rdf:Property,
        owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has narrower transitive"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:semanticRelation ;
    owl:inverseOf skos:broaderTransitive ;
    skos:definition "skos:narrowerTransitive is a transitive superproperty of skos:narrower." ;
    skos:scopeNote "By convention, skos:narrowerTransitive is not used to make assertions. Rather, the properties can be used to draw inferences about the transitive closure of the hierarchical relation, which is useful e.g. when implementing a simple query expansion algorithm in a search application."@en .

prov:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    owl:disjointWith prov:InstantaneousEvent .

prov:Collection a owl:Class ;
    rdfs:label "Collection" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf prov:Entity .

prov:InstantaneousEvent a owl:Class ;
    rdfs:label "InstantaneousEvent" ;
    rdfs:comment "An instantaneous event, or event for short, happens in the world and marks a change in the world, in its activities and in its entities. The term 'event' is commonly used in process algebra with a similar meaning. Events represent communications or interactions; they are assumed to be atomic and instantaneous."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .

<https://w3id.org/icareonto/ActivityOutcome> a owl:Class ;
    rdfs:label "Activity Outcome"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/intervention-careplan> ;
    skos:definition "The result or outcome of a care-plan activity after it has been performed or reviewed."@en .

<https://w3id.org/icareonto/AlertThreshold> a owl:Class ;
    rdfs:label "Alert Threshold"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    skos:definition "A threshold used to identify values requiring attention, review, warning, escalation, or clinical interpretation."@en .

<https://w3id.org/icareonto/CancerTreatmentHistory> a owl:Class ;
    rdfs:label "Cancer Treatment History"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    skos:definition "A longitudinal summary of a person’s cancer diagnosis and treatment records, used to represent survivorship history and treatment exposures relevant to late-effect risk."@en .

<https://w3id.org/icareonto/CardiotoxicTreatmentExposure> a owl:Class ;
    rdfs:label "Cardiotoxic Treatment Exposure"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:subClassOf <https://w3id.org/icareonto/TreatmentExposure> ;
    skos:definition "A treatment exposure with known or suspected relevance to cardiovascular late effects, such as anthracycline therapy, chest radiotherapy, or other cardiotoxic regimens."@en .

<https://w3id.org/icareonto/CardiotoxicityRisk> a owl:Class ;
    rdfs:label "Cardiotoxicity Risk"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    skos:definition "A cancer-treatment-related risk concept describing potential cardiotoxic late effects associated with treatment exposure."@en .

<https://w3id.org/icareonto/ClinicalInterpretation> a owl:Class ;
    rdfs:label "Clinical Interpretation"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/clinical-profile> ;
    skos:definition "A clinical interpretation or summary derived from records, observations, assessments, or measurements."@en .

<https://w3id.org/icareonto/Contraindication> a owl:Class ;
    rdfs:label "Contraindication"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/knowledge-resource> ;
    skos:definition "A condition in which a recommended activity or intervention should not be used, or should be used only with additional assessment or supervision."@en .

<https://w3id.org/icareonto/ConversationAgent> a owl:Class ;
    rdfs:label "Conversation Agent"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/agent> ;
    rdfs:subClassOf <https://w3id.org/icareonto/DigitalAgent> ;
    skos:altLabel "AI-powered conversational agent"@en,
        "virtual assistant"@en ;
    skos:definition "A digital agent that provides non-diagnostic education, coaching, self-monitoring support, resource navigation and appropriate escalation under defined safety policies and human oversight."@en .

<https://w3id.org/icareonto/ExerciseAdherenceResult> a owl:Class ;
    rdfs:label "Exercise Adherence Result"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/exercise> ;
    rdfs:subClassOf <https://w3id.org/icareonto/ObservationResult> ;
    skos:definition "The result of an exercise adherence assessment, such as adherence percentage, completion status, missed session, partial completion, or exceeded target."@en .

<https://w3id.org/icareonto/ExerciseIntervention> a owl:Class ;
    rdfs:label "Exercise Intervention"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/intervention-careplan> ;
    rdfs:subClassOf <https://w3id.org/icareonto/Intervention> ;
    skos:definition "An intervention involving prescribed, guided, or monitored physical activity or exercise."@en .

<https://w3id.org/icareonto/Frequency> a owl:Class ;
    rdfs:label "Frequency"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/core> ;
    skos:definition "A value describing how often a scheduled activity should occur."@en .

<https://w3id.org/icareonto/HealthHub> a owl:Class ;
    rdfs:label "Health Hub"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/healthhub-service> ;
    skos:definition "An integrated digital-health platform through which MAYA provides participant-facing services and connects supported devices."@en .

<https://w3id.org/icareonto/HealthLiteracyIntervention> a owl:Class ;
    rdfs:label "Health Literacy Intervention"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/intervention-careplan> ;
    rdfs:subClassOf <https://w3id.org/icareonto/Intervention> ;
    skos:definition "An intervention intended to improve a person's understanding, confidence, or ability to act on health information."@en .

<https://w3id.org/icareonto/HealthLiteracyResource> a owl:Class ;
    rdfs:label "Health Literacy Resource"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/knowledge-resource> ;
    rdfs:subClassOf <https://w3id.org/icareonto/KnowledgeResource> ;
    skos:definition "A resource specifically designed to address one or more health-literacy dimensions or needs."@en .

<https://w3id.org/icareonto/LifestyleBarrier> a owl:Class ;
    rdfs:label "Lifestyle Barrier"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/lifestyle-behaviour> ;
    skos:definition "A barrier affecting lifestyle behaviour change, such as time, fatigue, cost, symptoms, access, confidence, or social support."@en .

<https://w3id.org/icareonto/LifestyleFacilitator> a owl:Class ;
    rdfs:label "Lifestyle Facilitator"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/lifestyle-behaviour> ;
    skos:definition "A factor that supports positive lifestyle behaviour change or adherence."@en .

<https://w3id.org/icareonto/LifestyleProfile> a owl:Class ;
    rdfs:label "Lifestyle Profile"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/lifestyle-behaviour> ;
    skos:definition "A person-specific profile grouping lifestyle and behaviour records relevant to cardiovascular risk, late-effect monitoring, self-management, and care planning."@en .

<https://w3id.org/icareonto/LivingSituation> a owl:Class ;
    rdfs:label "Living Situation"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/social-context> ;
    rdfs:subClassOf <https://w3id.org/icareonto/SocialContextFactor> ;
    skos:definition "Household and housing circumstances relevant to support availability, privacy, digital-service use, or access to care."@en .

<https://w3id.org/icareonto/MeasurementInterpretation> a owl:Class ;
    rdfs:label "Measurement Interpretation"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    skos:definition "An interpretation derived from one or more observation results, thresholds, reference ranges, or clinical context."@en .

<https://w3id.org/icareonto/RadiotherapyBodySite> a owl:Class ;
    rdfs:label "Radiotherapy Body Site"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    skos:definition "An anatomical site or treatment field involved in radiotherapy exposure."@en .

<https://w3id.org/icareonto/RecommendationStrength> a owl:Class ;
    rdfs:label "Recommendation Strength"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/knowledge-resource> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Strength of a recommendation, kept separate from certainty of evidence."@en .

<https://w3id.org/icareonto/RiskAssessmentMethod> a owl:Class ;
    rdfs:label "Risk Assessment Method"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cv-risk> ;
    skos:definition "The method used to assess risk, such as prediction model, rule-based stratification, clinician assessment, or guideline-based classification."@en .

<https://w3id.org/icareonto/RiskInterpretation> a owl:Class ;
    rdfs:label "Risk Interpretation"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cv-risk> ;
    skos:definition "A clinical or operational interpretation of a risk estimate, such as low concern, monitor routinely, review soon, or escalate."@en .

<https://w3id.org/icareonto/RiskTimeHorizon> a owl:Class ;
    rdfs:label "Risk Time Horizon"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cv-risk> ;
    skos:definition "The future period over which a risk estimate applies, such as 1-year, 5-year, 10-year, or lifetime risk."@en .

<https://w3id.org/icareonto/ScoreValue> a owl:Class ;
    rdfs:label "Score Value"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    skos:definition "A value object representing a recorded quantity, score, unit, category, or textual value."@en .

<https://w3id.org/icareonto/SocialContextProfile> a owl:Class ;
    rdfs:label "Social Context Profile"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/social-context> ;
    skos:definition "A person-specific collection of social context records used to support context-aware dialogue and adaptation of care activities."@en .

<https://w3id.org/icareonto/StudyArm> a owl:Class ;
    rdfs:label "Study Arm"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/pilot> ;
    skos:definition "A study-specific participant group receiving a defined intervention or comparator condition."@en .

<https://w3id.org/icareonto/StudyArmType> a owl:Class ;
    rdfs:label "Study Arm Type"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/pilot> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept classifying the role of a participant group within a study design, such as intervention or control."@en .

<https://w3id.org/icareonto/StudyTimepoint> a owl:Class ;
    rdfs:label "Study Timepoint"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/pilot> ;
    rdfs:subClassOf <https://w3id.org/icareonto/Timepoint> ;
    skos:definition "A protocol-defined assessment point such as baseline, end of intervention or follow-up."@en .

<https://w3id.org/icareonto/TemporalEntity> a owl:Class ;
    rdfs:label "Temporal Entity"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/core> ;
    skos:definition "A general temporal entity used to group instants and intervals."@en .

<https://w3id.org/icareonto/TreatmentAgent> a owl:Class ;
    rdfs:label "Treatment Agent"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    skos:definition "A drug, radiation modality, biological agent, or other therapeutic agent used in a cancer treatment."@en .

<https://w3id.org/icareonto/TreatmentRegimen> a owl:Class ;
    rdfs:label "Treatment Regimen"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    skos:definition "A named treatment regimen or protocol used during a cancer treatment record."@en .

<https://w3id.org/icareonto/AdherenceBehaviour> a owl:Class ;
    rdfs:label "Adherence Behaviour"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/lifestyle-behaviour> ;
    rdfs:subClassOf <https://w3id.org/icareonto/LifestyleBehaviour> ;
    skos:definition "A lifestyle behaviour describing whether a person follows planned monitoring, medication, intervention, or care-plan activities."@en .

<https://w3id.org/icareonto/ApplicabilityCriterion> a owl:Class ;
    rdfs:label "Applicability Criterion"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/knowledge-resource> ;
    skos:definition "A textual or structured condition used to determine whether a knowledge resource or recommendation is relevant to a particular person, population, or context."@en .

<https://w3id.org/icareonto/CancerStageType> a owl:Class ;
    rdfs:label "Cancer Stage Type"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept classifying a cancer-stage assessment as clinical, pathological or another recognised stage type."@en .

<https://w3id.org/icareonto/CancerStagingSystem> a owl:Class ;
    rdfs:label "Cancer Staging System"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept identifying the classification system used to express a cancer-stage assessment."@en .

<https://w3id.org/icareonto/CancerTreatmentIntent> a owl:Class ;
    rdfs:label "Cancer Treatment Intent"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept representing the therapeutic purpose of a cancer treatment."@en .

<https://w3id.org/icareonto/CarePlanParticipation> a owl:Class ;
    rdfs:label "Care Plan Participation"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/intervention-careplan> ;
    skos:definition "A representation of a person's role in a care plan, such as survivor, clinician, caregiver, or reviewer."@en .

<https://w3id.org/icareonto/ClinicalAssessment> a owl:Class ;
    rdfs:label "Clinical Assessment"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/clinical-profile> ;
    rdfs:subClassOf <https://w3id.org/icareonto/ActivityExecution> ;
    skos:definition "An assessment activity used to evaluate clinical status, late-effect risk, symptoms, function, monitoring results, or care needs."@en .

<https://w3id.org/icareonto/ClinicalFinding> a owl:Class ;
    rdfs:label "Clinical Finding"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/clinical-profile> ;
    skos:definition "A clinically meaningful finding that may indicate status, risk, abnormality, progression, or need for follow-up."@en .

<https://w3id.org/icareonto/ClinicalProfile> a owl:Class ;
    rdfs:label "Clinical Profile"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/clinical-profile> ;
    skos:definition "Longitudinal clinical profile grouping clinical records for conditions, medication, assessments, status and source provenance."@en .

<https://w3id.org/icareonto/CommunicationPreference> a owl:Class ;
    rdfs:label "Communication Preference"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/person-role> ;
    rdfs:subClassOf <https://w3id.org/icareonto/PersonPreference> ;
    skos:definition "A preference specifying how a person prefers to communicate or receive contact, such as channel, timing, frequency, format, or level of detail."@en .

<https://w3id.org/icareonto/ExerciseAdherenceAssessment> a owl:Class ;
    rdfs:label "Exercise Adherence Assessment"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/exercise> ;
    rdfs:subClassOf <https://w3id.org/icareonto/ActivityExecution> ;
    skos:definition "An assessment comparing planned exercise with performed exercise to determine completion, adherence, deviation, or barriers."@en .

<https://w3id.org/icareonto/MeasurementMethod> a owl:Class ;
    rdfs:label "Measurement Method"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    skos:definition "The method used to produce a measurement, such as resting blood pressure, 12-lead ECG, wearable PPG, blood test, questionnaire, or performance test."@en .

<https://w3id.org/icareonto/ModelOutput> a owl:Class ;
    rdfs:label "Model Output"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cv-risk> ;
    skos:definition "The direct output of a model execution, before or alongside conversion into a risk profile or risk estimate."@en .

<https://w3id.org/icareonto/ModelPerformanceMetric> a owl:Class ;
    rdfs:label "Model Performance Metric"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cv-risk> ;
    skos:definition "A metric describing model performance, validation, calibration, discrimination, or reliability."@en .

<https://w3id.org/icareonto/ParticipantKnowledgeGraph> a owl:Class ;
    rdfs:label "Participant Knowledge Graph"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/provenance-governance> ;
    rdfs:subClassOf prov:Collection ;
    skos:definition "A private logical collection of information associated with a particular participant."@en .

<https://w3id.org/icareonto/PilotPhase> a owl:Class ;
    rdfs:label "Pilot Phase"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/pilot> ;
    skos:definition "A bounded stage of a pilot study, such as needs assessment, feasibility testing or evaluation."@en .

<https://w3id.org/icareonto/PilotPhaseType> a owl:Class ;
    rdfs:label "Pilot Phase Type"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/pilot> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept classifying the purpose or stage of a phase within a pilot study, such as needs assessment, feasibility or evaluation."@en .

<https://w3id.org/icareonto/PilotSite> a owl:Class ;
    rdfs:label "Pilot Site"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/pilot> ;
    skos:definition "A clinical, research or living-lab site responsible for recruitment, intervention delivery or study assessment."@en .

<https://w3id.org/icareonto/QuantityValue> a owl:Class ;
    rdfs:label "Quantity Value"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    skos:definition "A value object representing a recorded quantity, score, unit, category, or textual value."@en .

<https://w3id.org/icareonto/RadiotherapyExposure> a owl:Class ;
    rdfs:label "Radiotherapy Exposure"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:subClassOf <https://w3id.org/icareonto/CardiotoxicTreatmentExposure> ;
    skos:definition "Exposure to radiotherapy, including dose, treatment field, anatomical site, and timing where available."@en .

<https://w3id.org/icareonto/ReferenceRange> a owl:Class ;
    rdfs:label "Reference Range"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    skos:definition "A normal, expected, or clinically relevant value range used to interpret an observation result."@en .

<https://w3id.org/icareonto/SafetyPolicy> a owl:Class ;
    rdfs:label "Safety Policy"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/agent> ;
    skos:definition "A versioned set of rules and constraints governing the safe behaviour of an agent."@en .

<https://w3id.org/icareonto/SafetyRule> a owl:Class ;
    rdfs:label "Safety Rule"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/agent> ;
    skos:definition "An actionable constraint or instruction contained in a safety policy, such as requiring clarification or escalation."@en .

<https://w3id.org/icareonto/Severity> a owl:Class ;
    rdfs:label "Severity"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/clinical-profile> ;
    skos:definition "A value or category describing the intensity, seriousness, grade, or clinical impact of a condition, symptom, finding, or adverse effect."@en .

<https://w3id.org/icareonto/SocioEconomicFactor> a owl:Class ;
    rdfs:label "Socio Economic Factor"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/social-context> ;
    rdfs:subClassOf <https://w3id.org/icareonto/SocialContextFactor> ;
    skos:definition "A social or economic circumstance, such as education, employment, or financial resources, that may affect health-related opportunities or participation."@en .

<https://w3id.org/icareonto/SupportAvailabilityValue> a owl:Class ;
    rdfs:label "Support Availability Value"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/social-context> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Permitted levels of available support"@en .

<https://w3id.org/icareonto/SymptomRecord> a owl:Class ;
    rdfs:label "Symptom Record"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/clinical-profile> ;
    rdfs:subClassOf <https://w3id.org/icareonto/ClinicalRecord> ;
    skos:definition "A clinical record documenting a symptom reported by a person or observed during care."@en .

<https://w3id.org/icareonto/UserUtterance> a owl:Class ;
    rdfs:label "User Utterance"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:subClassOf <https://w3id.org/icareonto/DialogueTurn> ;
    skos:definition "A dialogue turn containing information communicated by the user through speech, text, or another supported input mode."@en .

skos:mappingRelation a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "is in mapping relation with"@en ;
    rdfs:comment "These concept mapping relations mirror semantic relations, and the data model defined below is similar (with the exception of skos:exactMatch) to the data model defined for semantic relations. A distinct vocabulary is provided for concept mapping relations, to provide a convenient way to differentiate links within a concept scheme from links between concept schemes. However, this pattern of usage is not a formal requirement of the SKOS data model, and relies on informal definitions of best practice."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:semanticRelation ;
    skos:definition "Relates two concepts coming, by convention, from different schemes, and that have comparable meanings"@en .

skos:semanticRelation a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "is in semantic relation with"@en ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range skos:Concept ;
    skos:definition "Links a concept to a concept related by meaning."@en ;
    skos:scopeNote "This property should not be used directly, but as a super-property for all properties denoting a relationship of meaning between concepts."@en .

prov:Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    owl:disjointWith prov:InstantaneousEvent .

<https://w3id.org/icareonto/Agent> a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/agent> ;
    rdfs:subClassOf prov:Agent ;
    skos:definition "An entity capable of performing actions or generating outputs for which responsibility or provenance may be recorded."@en .

<https://w3id.org/icareonto/AgentResponse> a owl:Class ;
    rdfs:label "Agent Response"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    rdfs:subClassOf <https://w3id.org/icareonto/DialogueTurn> ;
    skos:definition "A dialogue turn generated by a conversational agent in response to the user or the current dialogue context."@en .

<https://w3id.org/icareonto/CancerStageTypeScheme> a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Cancer Stage Type scheme"@en ;
    skos:hasTopConcept <https://w3id.org/icareonto/ClinicalStageType>,
        <https://w3id.org/icareonto/PathologicalStageType> .

<https://w3id.org/icareonto/CancerStageValue> a owl:Class ;
    rdfs:label "Cancer Stage Value"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    skos:definition "A structured component of a cancer-stage assessment that records the component being represented and its coded value."@en .

<https://w3id.org/icareonto/CancerStagingSystemScheme> a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Cancer Staging System scheme"@en ;
    skos:hasTopConcept <https://w3id.org/icareonto/FIGOStagingSystem>,
        <https://w3id.org/icareonto/TNMStagingSystem> .

<https://w3id.org/icareonto/CancerTreatmentIntentScheme> a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Cancer Treatment Intent scheme"@en ;
    skos:hasTopConcept <https://w3id.org/icareonto/CurativeTreatmentIntent>,
        <https://w3id.org/icareonto/PalliativeTreatmentIntent> .

<https://w3id.org/icareonto/ContentComplexityLevel> a owl:Class ;
    rdfs:label "Content Complexity Level"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/knowledge-resource> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Describes the complexity of the content."@en .

<https://w3id.org/icareonto/ContextInfluenceValue> a owl:Class ;
    rdfs:label "Context Influence Value"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/social-context> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Whether a factor is a barrier, facilitator, or mixed"@en .

<https://w3id.org/icareonto/DialogueContext> a owl:Class ;
    rdfs:label "Dialogue Context"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/dialogue> ;
    skos:definition "A selected set of intents, slot states, domain records, preferences, recommendations, and resources used to interpret an utterance or generate a response."@en .

<https://w3id.org/icareonto/EducationalAttainmentValue> a owl:Class ;
    rdfs:label "Educational Attainment Value"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/social-context> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Permitted educational attainment values"@en .

<https://w3id.org/icareonto/FinancialConstraintStatusValue> a owl:Class ;
    rdfs:label "Financial Constraint Status Value"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/social-context> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Permitted financial-constraint states"@en .

<https://w3id.org/icareonto/InformationDetailLevelValue> a owl:Class ;
    rdfs:label "Information Detail Level Value"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/person-role> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept representing the level of detail a person prefers when receiving health information, such as brief, standard or detailed."@en .

<https://w3id.org/icareonto/Intervention> a owl:Class ;
    rdfs:label "Intervention"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/intervention-careplan> ;
    rdfs:subClassOf <https://w3id.org/icareonto/CarePlanActivity> ;
    skos:definition "A planned care-plan activity intended to reduce risk, manage symptoms, improve health behaviour, support monitoring, or address survivorship needs."@en .

<https://w3id.org/icareonto/Locale> a owl:Class ;
    rdfs:label "Locale"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/core> ;
    skos:definition "A regional, linguistic and operational context used to localise services, dialogue and knowledge resources."@en .

<https://w3id.org/icareonto/MeasurementContext> a owl:Class ;
    rdfs:label "Measurement Context"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    skos:definition "Circumstantial information relevant to understanding or interpreting a measurement event, including its setting, trigger or monitoring situation."@en .

<https://w3id.org/icareonto/MedicationDose> a owl:Class ;
    rdfs:label "Medication Dose"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/clinical-profile> ;
    skos:definition "A structured representation of medication dose amount, unit, frequency, or dosing instruction."@en .

<https://w3id.org/icareonto/MedicationRecord> a owl:Class ;
    rdfs:label "Medication Record"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/clinical-profile> ;
    rdfs:subClassOf <https://w3id.org/icareonto/ClinicalRecord> ;
    skos:definition "A clinical record describing a medication a person is taking, has taken, or has been prescribed, including indication, timing, status, and dose where available."@en .

<https://w3id.org/icareonto/PilotStudy> a owl:Class ;
    rdfs:label "Pilot Study"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/pilot> ;
    skos:definition "An operational representation of a pilot or evaluation, including its sites, phases, participant enrolments and study arms."@en .

<https://w3id.org/icareonto/RecommendationStrengthScheme> a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Recommendation Strength scheme"@en ;
    skos:hasTopConcept <https://w3id.org/icareonto/ConditionalRecommendation>,
        <https://w3id.org/icareonto/StrongRecommendation> .

<https://w3id.org/icareonto/RiskFactor> a owl:Class ;
    rdfs:label "Risk Factor"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cv-risk> ;
    skos:definition "A factor that may increase, reduce, or modify a person's cardiovascular or late-effect risk."@en .

<https://w3id.org/icareonto/ServiceUseEvent> a owl:Class ;
    rdfs:label "Service Use Event"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/healthhub-service> ;
    rdfs:subClassOf <https://w3id.org/icareonto/ActivityExecution> ;
    skos:definition "An occurrence in which a person accesses or uses a digital service, retained when service engagement needs to be recorded."@en .

<https://w3id.org/icareonto/SeverityLevel> a owl:Class ;
    rdfs:label "Severity Level"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/social-context> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Permitted barrier-severity levels"@en .

<https://w3id.org/icareonto/StudyArmTypeScheme> a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Study Arm Type scheme"@en ;
    skos:hasTopConcept <https://w3id.org/icareonto/ControlArmType>,
        <https://w3id.org/icareonto/InterventionArmType> .

<https://w3id.org/icareonto/Unit> a owl:Class ;
    rdfs:label "Unit"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    skos:definition "A unit of measurement used to qualify a numeric observation value."@en .

<https://w3id.org/icareonto/AccessOrEngagementBarrier> a owl:Class ;
    rdfs:label "Access or Engagement Barrier"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/social-context> ;
    rdfs:subClassOf <https://w3id.org/icareonto/SocialContextFactor> ;
    skos:altLabel "Barrier to Care"@en ;
    skos:definition "A circumstance reported or assessed as impeding access to care, participation, engagement, or sustained use of an intervention."@en .

<https://w3id.org/icareonto/ActivityPriority> a owl:Class ;
    rdfs:label "Activity Priority"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/intervention-careplan> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept representing the relative importance or urgency assigned to a care-plan activity, such as routine, important, urgent or requiring escalation."@en .

<https://w3id.org/icareonto/BehaviourMetric> a owl:Class ;
    rdfs:label "Behaviour Metric"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/lifestyle-behaviour> ;
    skos:definition "A measurable quantity or descriptor used to characterise a behaviour record."@en .

<https://w3id.org/icareonto/CancerStageComponentType> a owl:Class ;
    rdfs:label "Cancer Stage Component Type"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept identifying the component represented by a cancer-stage value, such as the overall stage group or a TNM T, N or M category."@en .

<https://w3id.org/icareonto/CancerTreatmentSetting> a owl:Class ;
    rdfs:label "Cancer Treatment Setting"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept representing the timing or strategic relationship of a cancer treatment to other treatments."@en .

<https://w3id.org/icareonto/CarePlanTrigger> a owl:Class ;
    rdfs:label "Care Plan Trigger"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/intervention-careplan> ;
    skos:definition "A reason or event that causes a care plan or activity to be created, updated, escalated, or reviewed."@en .

<https://w3id.org/icareonto/ClinicalSeverityLevel> a owl:Class ;
    rdfs:label "Clinical Severity Level"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/clinical-profile> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept representing the degree of intensity, seriousness or clinical impact of a symptom, condition or finding, such as mild, moderate or severe."@en .

<https://w3id.org/icareonto/ConsentRecord> a owl:Class ;
    rdfs:label "Consent Record"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/provenance-governance> ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A record of a person's consent decision, its status, validity period and applicable access policy."@en .

<https://w3id.org/icareonto/DigitalAgent> a owl:Class ;
    rdfs:label "Digital Agent"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/agent> ;
    rdfs:subClassOf <https://w3id.org/icareonto/Agent> ;
    skos:definition "A software-based agent that performs actions or generates outputs within a defined capability and safety scope."@en .

<https://w3id.org/icareonto/EvidenceGrade> a owl:Class ;
    rdfs:label "Evidence Grade"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/knowledge-resource> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled assessment of the certainty or quality of evidence, interpreted according to a named grading scheme."@en .

<https://w3id.org/icareonto/ExerciseIntensityLevel> a owl:Class ;
    rdfs:label "Exercise Intensity Level"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/exercise> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept representing a qualitative band of intended or performed exercise effort, such as light, moderate, vigorous or maximal intensity."@en .

<https://w3id.org/icareonto/ExerciseTrainingPattern> a owl:Class ;
    rdfs:label "Exercise Training Pattern"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/exercise> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept representing the organisational pattern through which an exercise activity is performed, such as continuous, interval, high-intensity interval or circuit training."@en .

<https://w3id.org/icareonto/LanguageProficiencyLevelValue> a owl:Class ;
    rdfs:label "Language Proficiency Level Value"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/social-context> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Permitted language-proficiency levels"@en .

<https://w3id.org/icareonto/LiteracyLevelValue> a owl:Class ;
    rdfs:label "Literacy Level Value"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/social-context> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Permitted summary levels for digital or health literacy"@en .

<https://w3id.org/icareonto/LivingSituationType> a owl:Class ;
    rdfs:label "Living Situation Type"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/social-context> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Permitted living-arrangement values"@en .

<https://w3id.org/icareonto/MeasurementPanel> a owl:Class ;
    rdfs:label "Measurement Panel"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/measurement-biomarker> ;
    skos:definition "A grouped set of related measurable parameters or biomarkers measured together, such as a lipid panel, cardiac biomarker panel, or body composition panel."@en .

<https://w3id.org/icareonto/Medication> a owl:Class ;
    rdfs:label "Medication"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/clinical-profile> ;
    skos:definition "A medicinal product, drug, or therapeutic substance used for treatment, prevention, symptom control, or risk-factor management."@en .

<https://w3id.org/icareonto/ModelExecution> a owl:Class ;
    rdfs:label "Model Execution"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cv-risk> ;
    skos:definition "A specific run of a prediction model using defined inputs at a given time to generate a risk profile or risk estimate."@en .

<https://w3id.org/icareonto/PlannedExerciseSession> a owl:Class ;
    rdfs:label "Planned Exercise Session"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/exercise> ;
    skos:definition "A scheduled occurrence of exercise that follows a particular prescription. It represents intention, not actual performance."@en .

<https://w3id.org/icareonto/PredictionModel> a owl:Class ;
    rdfs:label "Prediction Model"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cv-risk> ;
    skos:definition "A computational, statistical, rule-based, or machine-learning model used to estimate cardiovascular risk or support monitoring decisions."@en .

<https://w3id.org/icareonto/RecommendationDerivation> a owl:Class ;
    rdfs:label "Recommendation Derivation"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/knowledge-resource> ;
    skos:definition "A provenance record describing how an agent or process produced a recommendation from resources, observations, models, or profiles. Not needed if the agent only retrieves and presents approved content."@en .

<https://w3id.org/icareonto/ResourceAudienceType> a owl:Class ;
    rdfs:label "Resource Audience Type"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/knowledge-resource> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Intended audience of a knowledge resource."@en .

<https://w3id.org/icareonto/ResponseStatus> a owl:Class ;
    rdfs:label "Response Status"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/social-context> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Whether information was provided, unknown, inapplicable, or declined"@en .

<https://w3id.org/icareonto/RiskFactorContribution> a owl:Class ;
    rdfs:label "Risk Factor Contribution"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cv-risk> ;
    skos:definition "A representation of how much a specific factor contributes to a risk estimate or risk profile."@en .

<https://w3id.org/icareonto/SmokingStatusValue> a owl:Class ;
    rdfs:label "Smoking Status Value"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/lifestyle-behaviour> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept representing a person’s current or historical tobacco-smoking status, such as never smoked, former smoker, current smoker or unknown."@en .

<https://w3id.org/icareonto/StudyTimepointType> a owl:Class ;
    rdfs:label "Study Timepoint Type"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/pilot> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept classifying a protocol-defined point at which study activities or assessments are scheduled, such as baseline, end of intervention or follow-up."@en .

<https://w3id.org/icareonto/SystemicTherapyExposure> a owl:Class ;
    rdfs:label "Systemic Therapy Exposure"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    rdfs:subClassOf <https://w3id.org/icareonto/CardiotoxicTreatmentExposure> ;
    skos:definition "Exposure to a systemic anti-cancer therapy delivered through the body, including chemotherapy, targeted therapy, immunotherapy, hormonal therapy, or transplant-related conditioning."@en .

<https://w3id.org/icareonto/SystemicTreatment> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/icareonto/CancerTreatmentType> ;
    rdfs:label "Systemic treatment"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/cancer-history> ;
    skos:definition "A cancer-treatment type that acts throughout the body, including chemotherapy, immunotherapy, targeted therapy and relevant stem-cell transplantation."@en ;
    skos:inScheme <https://w3id.org/icareonto/CancerTreatmentTypeScheme> ;
    skos:prefLabel "Systemic treatment"@en ;
    skos:topConceptOf <https://w3id.org/icareonto/CancerTreatmentTypeScheme> ;
    ns1:reviewStatus "Proposed" .

skos:note a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "note"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    skos:definition "A general note, for any purpose."@en ;
    skos:scopeNote "This property may be used directly, or as a super-property for more specific note types."@en .

<https://w3id.org/icareonto/BehaviourChangeStage> a owl:Class ;
    rdfs:label "Behaviour Change Stage"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/lifestyle-behaviour> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept representing a person's stage of readiness or action in relation to changing a behaviour, according to an identified behaviour-change model (transtheoretical model)."@en .

<https://w3id.org/icareonto/CarePlanStatus> a owl:Class ;
    rdfs:label "Care Plan Status"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/intervention-careplan> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept representing the lifecycle state of a care plan, such as draft, active, paused, completed or cancelled."@en .

<https://w3id.org/icareonto/ConsentStatusValue> a owl:Class ;
    rdfs:label "Consent Status Value"@en ;
    rdfs:isDefinedBy <https://w3id.org/icareonto/provenance-governance> ;
    rdfs:subClassOf skos:Concept ;
