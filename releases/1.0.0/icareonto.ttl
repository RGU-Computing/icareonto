@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix icare: <https://w3id.org/icareonto/> .
@prefix meta: <https://w3id.org/icareonto/metadata#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

icare: a owl:Ontology ;
    rdfs:label "iCARE Onto"@en ;
    dcterms:contributor "MAYA consortium partners" ;
    dcterms:creator "Robert Gordon University" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright (c) 2026 Robert Gordon University and contributing MAYA consortium partners, for their respective contributions. Third-party material retains its applicable terms."@en ;
    rdfs:comment "iCARE Onto provides the semantic foundation for the MAYA iCARE Health Hub, supporting adolescent and young adult cancer survivorship and cardiovascular health. Its modular model represents people and preferences, cancer treatment history, clinical profiles, measurements, cardiovascular risk, personalised care, lifestyle, social context, educational resources, conversational interaction, digital services, pilot settings and knowledge governance. It supports participant- and pilot-specific knowledge graphs, personalised educational support and evidence-grounded dialogue."@en ;
    owl:imports <https://w3id.org/icareonto/releases/1.0.0/agent>,
        <https://w3id.org/icareonto/releases/1.0.0/alignments>,
        <https://w3id.org/icareonto/releases/1.0.0/cancer-history>,
        <https://w3id.org/icareonto/releases/1.0.0/clinical-profile>,
        <https://w3id.org/icareonto/releases/1.0.0/core>,
        <https://w3id.org/icareonto/releases/1.0.0/cv-risk>,
        <https://w3id.org/icareonto/releases/1.0.0/dialogue>,
        <https://w3id.org/icareonto/releases/1.0.0/exercise>,
        <https://w3id.org/icareonto/releases/1.0.0/healthhub-service>,
        <https://w3id.org/icareonto/releases/1.0.0/intervention-careplan>,
        <https://w3id.org/icareonto/releases/1.0.0/knowledge-resource>,
        <https://w3id.org/icareonto/releases/1.0.0/lifestyle-behaviour>,
        <https://w3id.org/icareonto/releases/1.0.0/measurement-biomarker>,
        <https://w3id.org/icareonto/releases/1.0.0/metadata>,
        <https://w3id.org/icareonto/releases/1.0.0/nutrition>,
        <https://w3id.org/icareonto/releases/1.0.0/person-role>,
        <https://w3id.org/icareonto/releases/1.0.0/pilot>,
        <https://w3id.org/icareonto/releases/1.0.0/provenance-governance>,
        <https://w3id.org/icareonto/releases/1.0.0/social-context> ;
    owl:versionIRI <https://w3id.org/icareonto/releases/1.0.0/icareonto> ;
    owl:versionInfo "1.0.0" ;
    meta:releaseStatus "Published" .

