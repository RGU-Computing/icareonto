    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Associates a quantitative value with the unit in which it is expressed.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Unit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/behaviourMetricUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/BehaviourMetric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <rdfs:label xml:lang="en">behaviour metric unit</rdfs:label>
    <skos:definition xml:lang="en">Records the metric unit, such as steps/day, minutes/day, hours/night, cigarettes/day, or servings/day.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/nutritionTargetAmount">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/NutritionInstruction"/>
    <skos:definition xml:lang="en">Records an optional numerical target for the instruction.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/nutrition"/>
    <rdfs:label xml:lang="en">nutrition target amount</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/hasLanguageProficiencyLevel">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:definition xml:lang="en">Ability to understand or communicate in the supported language, such as fluent, conversational, limited, or none.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/LanguageProficiencyLevelValue"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/LanguageBarrier"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has language proficiency level</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/EvidenceGradeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/VeryLowCertaintyEvidence"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/LowCertaintyEvidence"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ModerateCertaintyEvidence"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/HighCertaintyEvidence"/>
    <rdfs:label xml:lang="en">Evidence Grade scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/conditionCodeVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ClinicalCondition"/>
    <skos:definition xml:lang="en">Identifies the version of the terminology from which the condition code was selected.</skos:definition>
    <rdfs:label xml:lang="en">condition code version</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/localeCountryCode">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <rdfs:label xml:lang="en">locale country code</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">The country or territory code associated with the locale using ISO 3166-1 alpha-2 standard two-letter code.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Locale"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/EndOfInterventionTimepointType">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/StudyTimepointTypeScheme"/>
    <rdfs:label xml:lang="en">End of intervention timepoint</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/StudyTimepointType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
    <skos:prefLabel xml:lang="en">End of intervention timepoint</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/StudyTimepointTypeScheme"/>
    <skos:definition xml:lang="en">A study-timepoint type representing end of intervention.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/NutritionCoachingServiceType">
    <skos:prefLabel xml:lang="en">Nutrition coaching service</skos:prefLabel>
    <rdfs:label xml:lang="en">Nutrition coaching service</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/icareonto/DigitalServiceType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A digital-service type providing nutrition coaching.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/DigitalServiceTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/healthhub-service"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/DigitalServiceTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/LivesWithPartner">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/LivingSituationTypeScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/LivingSituationTypeScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/LivingSituationType"/>
    <rdfs:label xml:lang="en">Lives with partner</rdfs:label>
    <skos:prefLabel xml:lang="en">Lives with partner</skos:prefLabel>
    <skos:definition xml:lang="en">A living-situation type indicating that the person lives with a partner.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PhysiologicalParameter">
    <rdfs:label xml:lang="en">Physiological Parameter</rdfs:label>
    <skos:definition xml:lang="en">A measurable parameter describing bodily function, physical state, or biological status.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/MeasurableParameter"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ChemotherapyTreatment">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/CancerTreatmentType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Chemotherapy treatment</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CancerTreatmentTypeScheme"/>
    <rdfs:label xml:lang="en">Chemotherapy treatment</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <skos:definition xml:lang="en">A cancer-treatment type involving cytotoxic medicines intended to destroy or inhibit cancer cells.</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/icareonto/SystemicTreatment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Employed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EmploymentStatusValue"/>
    <skos:definition xml:lang="en">An employment-status value indicating that the person is employed.</skos:definition>
    <skos:prefLabel xml:lang="en">Employed</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/EmploymentStatusValueScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/EmploymentStatusValueScheme"/>
    <rdfs:label xml:lang="en">Employed</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Squat">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Squat</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ExerciseActivityType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ExerciseActivityTypeScheme"/>
    <skos:prefLabel xml:lang="en">Squat</skos:prefLabel>
    <skos:definition xml:lang="en">An exercise-activity type involving performance of a squat movement.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ExerciseActivityTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/VerificationStatusValueScheme">
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/Unverified"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/UserConfirmed"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/VerifiedAgainstClinicalRecord"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ClinicianVerified"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/Disputed"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Verification Status Value scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/InvalidMeasurement">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/MeasurementQualityScheme"/>
    <skos:prefLabel xml:lang="en">Invalid measurement</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/MeasurementQuality"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Invalid measurement</rdfs:label>
    <skos:definition xml:lang="en">A measurement-quality value indicating that the measurement should not be used as a valid result.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/MeasurementQualityScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CancelledActivity">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Cancelled activity</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ActivityStatusScheme"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ActivityStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:definition xml:lang="en">An activity status indicating that the activity is cancelled.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ActivityStatusScheme"/>
    <skos:prefLabel xml:lang="en">Cancelled activity</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ModifiableRiskFactor">
    <rdfs:label xml:lang="en">Modifiable Risk Factor</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <skos:definition xml:lang="en">A risk factor that may be changed or managed through lifestyle, clinical intervention, monitoring, education, medication, or care planning.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/RiskFactor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/personIdentifier">
    <skos:definition xml:lang="en">Records the person identifier for Person.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <rdfs:label xml:lang="en">person identifier</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Person"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/deviceProvidesAccessTo">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Device"/>
    <rdfs:label xml:lang="en">provides access to</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/healthhub-service"/>
    <skos:definition xml:lang="en">Relates a device to a digital service that users can access through it.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/DigitalService"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/NightTimeOfDay">
    <skos:definition xml:lang="en">A time-of-day value representing the night period.</skos:definition>
    <skos:prefLabel xml:lang="en">Night time of day</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/TimeOfDayScheme"/>
    <rdfs:label xml:lang="en">Night time of day</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/TimeOfDayScheme"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/TimeOfDay"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/performanceMetricName">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ModelPerformanceMetric"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Records the name of a model performance metric.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdfs:label xml:lang="en">performance metric name</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/safetyRuleText">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <skos:definition xml:lang="en">Human-readable statement of the safety constraint or required action.</skos:definition>
    <rdfs:label xml:lang="en">safety rule text</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/SafetyRule"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SmokingStatusValueScheme">
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/NeverSmoker"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/CurrentSmoker"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/FormerSmoker"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/UnknownSmokingStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Smoking Status Value scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MedicationDose">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Medication Dose</rdfs:label>
    <skos:definition xml:lang="en">A structured representation of medication dose amount, unit, frequency, or dosing instruction.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/diagnosisDate">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ns1:valueFormat>iso-calendar-date</ns1:valueFormat>
    <ns1:valuePattern>^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$</ns1:valuePattern>
    <rdfs:label xml:lang="en">diagnosis date</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerDiagnosis"/>
    <skos:definition xml:lang="en">Records the calendar date of cancer diagnosis, when known, as a string in YYYY-MM-DD format. No time of day or timezone is implied.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Agent">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">An entity capable of performing actions or generating outputs for which responsibility or provenance may be recorded.</skos:definition>
    <rdfs:label xml:lang="en">Agent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/dataSourceIdentifier">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <skos:definition xml:lang="en">Records an identifier for a data source.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">data source identifier</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DataSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#notation">
    <skos:definition xml:lang="en">A notation, also known as classification code, is a string of characters such as "T58.5" or "303.4833" used to uniquely identify a concept within the scope of a given concept scheme.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <skos:scopeNote xml:lang="en">By convention, skos:notation is used with a typed literal in the object position of the triple.</skos:scopeNote>
    <rdfs:label xml:lang="en">notation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/pilotPhaseHasVisit">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/StudyVisit"/>
    <skos:definition xml:lang="en">Identifies a study visit associated with a pilot phase.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PilotPhase"/>
    <rdfs:label xml:lang="en">has visit</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Smoking">
    <rdfs:label xml:lang="en">Smoking</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ResourceTopic"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ResourceTopicScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">Tobacco smoking, its health implications, smoking cessation and avoidance of tobacco-smoke exposure.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ResourceTopicScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <skos:prefLabel xml:lang="en">Smoking</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/criterionText">
    <skos:definition xml:lang="en">Human-readable condition under which the recommendation applies.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">criterion text</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ApplicabilityCriterion"/>
