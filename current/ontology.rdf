  <rdf:Description rdf:about="https://w3id.org/icareonto/PsychologicalParameter">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <skos:definition xml:lang="en">A measurable parameter describing mental health, emotional wellbeing, cognition, distress, or psychological symptoms.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/MeasurableParameter"/>
    <rdfs:label xml:lang="en">Psychological Parameter</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/cancerStageHasValue">
    <skos:definition xml:lang="en">Associates a cancer-stage assessment with one or more structured stage-component values.</skos:definition>
    <rdfs:label xml:lang="en">has stage value</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
