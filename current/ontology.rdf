    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A behaviour-change stage in which the person is actively making the relevant change.</skos:definition>
    <rdfs:label xml:lang="en">Action stage</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
