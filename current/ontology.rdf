    <rdfs:range rdf:resource="https://w3id.org/icareonto/Person"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ModelInput">
    <skos:definition xml:lang="en">A structured input used by a prediction model execution, derived from person attributes, clinical records, treatment exposures, or observations.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdfs:label xml:lang="en">Model Input</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Reduce">
    <skos:prefLabel xml:lang="en">Reduce</skos:prefLabel>
