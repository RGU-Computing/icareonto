    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Classifies the principal function of a digital service.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AdequateLiteracy">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/LiteracyLevelValue"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/LiteracyLevelValueScheme"/>
    <skos:prefLabel xml:lang="en">Adequate literacy</skos:prefLabel>
    <rdfs:label xml:lang="en">Adequate literacy</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/LiteracyLevelValueScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">A summary literacy level indicating sufficient capability to access, understand, appraise and use relevant information in common situations.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/participantEnrolmentForPerson">
