    <rdfs:label xml:lang="en">has arm</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/StudyArm"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/dialogueSessionDeliveredThroughService">
