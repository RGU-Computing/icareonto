    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ContentComplexityLevelScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/knowledgeResourceHasTopic">
    <rdfs:label xml:lang="en">has topic</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ResourceTopic"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <skos:definition xml:lang="en">Identifies a health or care topic addressed by a knowledge resource.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/KnowledgeResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/goalHasAchievementStatus">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Goal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/GoalAchievementStatus"/>
    <rdfs:label xml:lang="en">has achievement status</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:definition xml:lang="en">Identifies the current progress or outcome of a goal against its intended target.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/symptomCodeVersion">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Symptom"/>
    <rdfs:label xml:lang="en">symptom code version</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:definition xml:lang="en">Identifies the version of the terminology from which the symptom code was selected.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/minimumRepetitionCount">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseSet"/>
    <skos:definition xml:lang="en">Lower bound when a repetition range is used.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    <rdfs:label xml:lang="en">minimum repetition count</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/personHasAttribute">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/PersonAttribute"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Person"/>
    <skos:definition xml:lang="en">Relates Person to Person Attribute.</skos:definition>
    <rdfs:label xml:lang="en">has attribute</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ResponseStatusScheme">
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/NotApplicable"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/DeclinedToAnswer"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/Provided"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/UnknownToPerson"/>
    <rdfs:label xml:lang="en">Response Status scheme</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/symptomName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Symptom"/>
    <rdfs:label xml:lang="en">symptom name</rdfs:label>
    <skos:definition xml:lang="en">Records the symptom name, such as fatigue, chest pain, dizziness, or shortness of breath.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RiskProfile">
    <skos:altLabel xml:lang="en">CV risk profile</skos:altLabel>
    <skos:altLabel xml:lang="en">Cardiovascular risk profile</skos:altLabel>
    <skos:definition xml:lang="en">A person-specific cardiovascular risk summary derived from cancer treatment exposures, clinical records, observations, lifestyle factors, and model outputs.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdfs:label xml:lang="en">Risk Profile</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/UnconfirmedSlot">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/SlotStatusValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:definition xml:lang="en">A dialogue-slot status indicating that the available value has not yet been confirmed.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SlotStatusValueScheme"/>
    <skos:prefLabel xml:lang="en">Unconfirmed slot</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <rdfs:label xml:lang="en">Unconfirmed slot</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SlotStatusValueScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/NeverSmoker">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/SmokingStatusValue"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SmokingStatusValueScheme"/>
    <rdfs:label xml:lang="en">Never smoker</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SmokingStatusValueScheme"/>
    <skos:definition xml:lang="en">A smoking-status value indicating that the person has never smoked according to the adopted definition.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Never smoker</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PausedCarePlan">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/CarePlanStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Paused care plan</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/CarePlanStatusScheme"/>
    <rdfs:label xml:lang="en">Paused care plan</rdfs:label>
    <skos:definition xml:lang="en">A care-plan status indicating that the care plan is in the paused state.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CarePlanStatusScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/carePlanCreatedAt">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Timepoint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CarePlan"/>
    <rdfs:label xml:lang="en">created at</rdfs:label>
    <skos:definition xml:lang="en">Relates a care plan to its creation time.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/EscalationRequiredPriority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ActivityPriority"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ActivityPriorityScheme"/>
    <skos:definition xml:lang="en">An activity-priority value indicating escalation required priority.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ActivityPriorityScheme"/>
    <rdfs:label xml:lang="en">Escalation required priority</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:prefLabel xml:lang="en">Escalation required priority</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/intensityAssessmentMethod">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseIntensity"/>
    <skos:definition xml:lang="en">Method such as RPE, heart-rate reserve, %HRmax, MET, or %1RM.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">intensity assessment method</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SelfMonitoring">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ResourceTopic"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ResourceTopicScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <skos:definition xml:lang="en">Observing, measuring and recording symptoms, health indicators or health-related behaviours, including understanding measurements, tracking changes and communicating findings to the care team.</skos:definition>
    <skos:prefLabel xml:lang="en">Self-monitoring</skos:prefLabel>
    <rdfs:label xml:lang="en">Self-monitoring</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ResourceTopicScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#changeNote">
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#note"/>
    <rdfs:label xml:lang="en">change note</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <skos:definition xml:lang="en">A note about a modification to a concept.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/VeryHighRisk">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/RiskCategoryValueScheme"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/RiskCategoryValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/RiskCategoryValueScheme"/>
    <rdfs:label xml:lang="en">Very high risk</rdfs:label>
    <skos:definition xml:lang="en">A risk-category value indicating very high risk.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <skos:prefLabel xml:lang="en">Very high risk</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ExerciseTrainingPattern">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Exercise Training Pattern</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <skos:definition xml:lang="en">A controlled concept representing the organisational pattern through which an exercise activity is performed, such as continuous, interval, high-intensity interval or circuit training.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/dialogueSessionHasTurn">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/DialogueTurn"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DialogueSession"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <skos:definition xml:lang="en">Associates a dialogue session with one of its turns.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has turn</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/digitalLiteracyHasLevel">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DigitalLiteracy"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/LiteracyLevelValue"/>
    <rdfs:label xml:lang="en">has level</rdfs:label>
    <skos:definition xml:lang="en">Summary digital level, such as limited, adequate, high, or unknown.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/DetailedInformation">
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/InformationDetailLevelValueScheme"/>
    <skos:definition xml:lang="en">An information-detail preference indicating detailed information.</skos:definition>
    <skos:prefLabel xml:lang="en">Detailed information</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/InformationDetailLevelValue"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/InformationDetailLevelValueScheme"/>
    <rdfs:label xml:lang="en">Detailed information</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ConsentRecord">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Consent Record</rdfs:label>
    <skos:definition xml:lang="en">A record of a person's consent decision, its status, validity period and applicable access policy.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/provenance-governance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ServiceUseEvent">
    <rdfs:label xml:lang="en">Service Use Event</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/healthhub-service"/>
    <skos:definition xml:lang="en">An occurrence in which a person accesses or uses a digital service, retained when service engagement needs to be recorded.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/ActivityExecution"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#scopeNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <skos:definition xml:lang="en">A note that helps to clarify the meaning and/or the use of a concept.</skos:definition>
    <rdfs:label xml:lang="en">scope note</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#note"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/TreatmentBoundaryRule">
    <rdf:type rdf:resource="https://w3id.org/icareonto/SafetyRuleType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SafetyRuleTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <rdfs:label xml:lang="en">Treatment boundary rule</rdfs:label>
    <skos:definition xml:lang="en">A safety-rule type that prevents the agent from initiating or changing treatment outside its authorised role.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SafetyRuleTypeScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Treatment boundary rule</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/BloodPressureMeasurementProtocol">
    <skos:definition xml:lang="en">A protocol specifying how an activity, measurement, assessment, or clinical process should be performed.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Blood Pressure Measurement Protocol</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/MeasurementProtocol"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ObservationResult">
    <skos:definition xml:lang="en">The result produced by a measurement event, including numeric, categorical, score, textual, unit, threshold, and interpretation information.</skos:definition>
