    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Identifies the prescription whose adherence is being assessed.</skos:definition>
    <rdfs:label xml:lang="en">evaluates prescription</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/participantEnrolmentValidDuring">
    <skos:definition xml:lang="en">Identifies the interval during which a person's enrolment in a pilot study is effective.</skos:definition>
    <rdfs:label xml:lang="en">valid during</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ParticipantEnrolment"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/TimeInterval"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/WholeGrains">
