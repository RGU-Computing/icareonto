    <rdfs:label xml:lang="en">has status</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CarePlan"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/CarePlanStatus"/>
    <skos:definition xml:lang="en">Relates Care Plan to Care Plan Status.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SupportDisclosure">
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ResourcePurposeScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ResourcePurpose"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Support disclosure</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ResourcePurposeScheme"/>
    <rdfs:label xml:lang="en">Support disclosure</rdfs:label>
    <skos:definition xml:lang="en">A resource purpose indicating that the resource is intended to support appropriate disclosure or communication of health information.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#semanticRelation">
    <rdfs:domain rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is in semantic relation with</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <skos:definition xml:lang="en">Links a concept to a concept related by meaning.</skos:definition>
    <skos:scopeNote xml:lang="en">This property should not be used directly, but as a super-property for all properties denoting a relationship of meaning between concepts.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SurgeryTreatment">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
