  <rdf:Description rdf:about="https://w3id.org/icareonto/BelowReferenceRange">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ThresholdCategory"/>
    <skos:definition xml:lang="en">A threshold category indicating that the observed value is below the applicable reference range.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ThresholdCategoryScheme"/>
    <skos:prefLabel xml:lang="en">Below reference range</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ThresholdCategoryScheme"/>
    <rdfs:label xml:lang="en">Below reference range</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/WrittenText">
    <rdfs:label xml:lang="en">Written text</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ResourceFormat"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A resource format that uses written text as its primary presentation format.</skos:definition>
    <skos:prefLabel xml:lang="en">Written text</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ResourceFormatScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ResourceFormatScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/BaselineTimepointType">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/StudyTimepointType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/StudyTimepointTypeScheme"/>
    <rdfs:label xml:lang="en">Baseline timepoint</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/StudyTimepointTypeScheme"/>
    <skos:definition xml:lang="en">A study-timepoint type representing baseline.</skos:definition>
    <skos:prefLabel xml:lang="en">Baseline timepoint</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/medicationCodeVersion">
    <skos:definition xml:lang="en">Identifies the version of the terminology from which the medication code was selected.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">medication code version</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Medication"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AdjuvantTreatmentSetting">
    <rdfs:label xml:lang="en">Adjuvant treatment setting</rdfs:label>
    <skos:prefLabel xml:lang="en">Adjuvant treatment setting</skos:prefLabel>
    <skos:definition xml:lang="en">A cancer-treatment setting in which treatment is delivered after the principal definitive treatment to reduce recurrence risk.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/CancerTreatmentSettingScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/CancerTreatmentSetting"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CancerTreatmentSettingScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/estimatedCompletionTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">estimated completion time</rdfs:label>
    <ns1:valueFormat>iso-duration</ns1:valueFormat>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ns1:valuePattern>^-?P([0-9]+W|([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)(T([0-9]+H([0-9]+M)?([0-9]+(\.[0-9]+)?S)?|[0-9]+M([0-9]+(\.[0-9]+)?S)?|[0-9]+(\.[0-9]+)?S))?|T([0-9]+H([0-9]+M)?([0-9]+(\.[0-9]+)?S)?|[0-9]+M([0-9]+(\.[0-9]+)?S)?|[0-9]+(\.[0-9]+)?S))$</ns1:valuePattern>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <skos:definition xml:lang="en">Records the estimated time required to read, watch or complete a knowledge resource as an ISO 8601 duration string, for example PT10M for ten minutes.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/KnowledgeResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PrepareForConsultation">
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ResourcePurposeScheme"/>
    <rdfs:label xml:lang="en">Prepare for consultation</rdfs:label>
    <skos:prefLabel xml:lang="en">Prepare for consultation</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ResourcePurpose"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ResourcePurposeScheme"/>
    <skos:definition xml:lang="en">A resource purpose indicating that the resource is intended to help a person prepare for a healthcare consultation.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/exerciseActivityHasSet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Associates an activity with set, repetition, load, and rest information.</skos:definition>
    <rdfs:label xml:lang="en">has set</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseActivity"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ExerciseSet"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/turnSequenceNumber">
    <rdfs:label xml:lang="en">turn sequence number</rdfs:label>
    <skos:definition xml:lang="en">Position of the turn within its dialogue session.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DialogueTurn"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CigarettesPerDay">
    <skos:prefLabel xml:lang="en">Cigarettes per day</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/BehaviourMetricType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/BehaviourMetricTypeScheme"/>
    <skos:definition xml:lang="en">A behaviour metric representing the number of cigarettes smoked per day.</skos:definition>
    <rdfs:label xml:lang="en">Cigarettes per day</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/BehaviourMetricTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/EmpathicCommunicationStrategy">
    <skos:definition xml:lang="en">A dialogue strategy based on empathic communication to support the interaction.</skos:definition>
    <rdfs:label xml:lang="en">Empathic communication strategy</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/icareonto/DialogueStrategy"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/DialogueStrategyScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/DialogueStrategyScheme"/>
    <skos:prefLabel xml:lang="en">Empathic communication strategy</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/HistoricalClinicalStatus">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ClinicalStatus"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ClinicalStatusScheme"/>
    <skos:definition xml:lang="en">A clinical-status value indicating historical status.</skos:definition>
    <skos:prefLabel xml:lang="en">Historical clinical status</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ClinicalStatusScheme"/>
    <rdfs:label xml:lang="en">Historical clinical status</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CancerStageType">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cancer Stage Type</rdfs:label>
    <skos:definition xml:lang="en">A controlled concept classifying a cancer-stage assessment as clinical, pathological or another recognised stage type.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#Entity">
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
    <rdfs:label>Entity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/prov#InstantaneousEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/FamilyMemberRole">
    <skos:definition xml:lang="en">A relationship-based support role held by a person who is a family member of a survivor and may contribute to care, support, communication, or contextual knowledge.</skos:definition>
    <rdfs:label xml:lang="en">Family Member Role</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/PersonRole"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/severityHasSeverityLevel">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdfs:label xml:lang="en">has severity level</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ClinicalSeverityLevel"/>
    <skos:definition xml:lang="en">Records the severity level, category or grade.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Severity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/unitSymbol">
    <rdfs:label xml:lang="en">unit symbol</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Unit"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Records the human-readable symbol used to display the unit.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ClinicianVerified">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/VerificationStatusValue"/>
    <skos:definition xml:lang="en">A verification status indicating that a clinician has reviewed and confirmed the information.</skos:definition>
    <rdfs:label xml:lang="en">Clinician verified</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Clinician verified</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/provenance-governance"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/VerificationStatusValueScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/VerificationStatusValueScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SymptomRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A clinical record documenting a symptom reported by a person or observed during care.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/ClinicalRecord"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdfs:label xml:lang="en">Symptom Record</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/EnrolmentStatusValueScheme">
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/EnrolledStatus"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ScreeningEnrolmentStatus"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ActiveEnrolmentStatus"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/WithdrawnEnrolmentStatus"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/CompletedEnrolmentStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Enrolment Status Value scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/behaviourRecordHasSource">
    <skos:definition xml:lang="en">Relates a behaviour record to its source, such as self-report, device, questionnaire, or clinical record.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/BehaviourRecord"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/DataSource"/>
    <rdfs:label xml:lang="en">has source</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Barrier">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ContextInfluenceValueScheme"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ContextInfluenceValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ContextInfluenceValueScheme"/>
    <skos:prefLabel xml:lang="en">Barrier</skos:prefLabel>
    <skos:definition xml:lang="en">A context-influence value indicating that the factor impedes access, engagement or participation.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Barrier</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/treatmentRegimenName">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Records the name of a treatment regimen.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/TreatmentRegimen"/>
    <rdfs:label xml:lang="en">treatment regimen name</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/metadata#valueFormat">
    <rdfs:label xml:lang="en">value format</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/modelExecutionHasOutput">
    <skos:definition xml:lang="en">Relates a model execution to its direct output.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ModelOutput"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ModelExecution"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has output</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MildSeverity">
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ClinicalSeverityLevelScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ClinicalSeverityLevel"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:definition xml:lang="en">A clinical-severity level indicating mild clinical severity.</skos:definition>
    <skos:prefLabel xml:lang="en">Mild severity</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Mild severity</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ClinicalSeverityLevelScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/hasBarrierSeverity">
    <rdfs:label xml:lang="en">has barrier severity</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/AccessOrEngagementBarrier"/>
    <skos:definition xml:lang="en">Reported effect of a barrier, such as low, moderate, high, or unknown.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/SeverityLevel"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ThresholdCategoryScheme">
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/AboveReferenceRange"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/WithinReferenceRange"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/IndeterminateResult"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/BelowReferenceRange"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/CriticalResult"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Threshold Category scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/thresholdCategoryValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Records the interpreted threshold category.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ThresholdCategory"/>
    <rdfs:label xml:lang="en">threshold category value</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#example">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label xml:lang="en">example</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <skos:definition xml:lang="en">An example of the use of a concept.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#note"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/BehaviouralParameter">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">Behavioural Parameter</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A measurable parameter describing behaviour relevant to health, monitoring, adherence, or lifestyle risk.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/MeasurableParameter"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SlotType">
    <rdfs:label xml:lang="en">Slot Type</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
