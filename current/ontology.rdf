    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Content Complexity Level</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/plannedSessionIdentifier">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <skos:definition xml:lang="en">Identifier for a planned session.</skos:definition>
    <rdfs:label xml:lang="en">planned session identifier</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
