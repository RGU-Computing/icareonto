    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/DietaryComponentScheme"/>
    <skos:definition xml:lang="en">A dietary component representing whole grains as a target of nutrition guidance.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/DietaryComponentScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/nutrition"/>
