  <rdf:Description rdf:about="https://w3id.org/icareonto/CaregiverRole">
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/PersonRole"/>
    <skos:definition xml:lang="en">A support role held by a person who provides practical, emotional, health-related, or daily-living support to a survivor.</skos:definition>
    <rdfs:label xml:lang="en">Caregiver Role</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
