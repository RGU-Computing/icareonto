    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Surgery treatment</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CancerTreatmentTypeScheme"/>
    <rdfs:label xml:lang="en">Surgery treatment</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ImportantPriority">
