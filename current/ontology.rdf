    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/">
    <dcterms:creator>Robert Gordon University</dcterms:creator>
    <rdfs:comment xml:lang="en">iCARE Onto provides the semantic foundation for the MAYA iCARE Health Hub, supporting adolescent and young adult cancer survivorship and cardiovascular health. Its modular model represents people and preferences, cancer treatment history, clinical profiles, measurements, cardiovascular risk, personalised care, lifestyle, social context, educational resources, conversational interaction, digital services, pilot settings and knowledge governance. It supports participant- and pilot-specific knowledge graphs, personalised educational support and evidence-grounded dialogue.</rdfs:comment>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://w3id.org/icareonto/releases/1.0.0/icareonto"/>
    <dcterms:contributor>MAYA consortium partners</dcterms:contributor>
    <rdfs:label xml:lang="en">iCARE Onto</rdfs:label>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:rights xml:lang="en">Copyright (c) 2026 Robert Gordon University and contributing MAYA consortium partners, for their respective contributions. Third-party material retains its applicable terms.</dcterms:rights>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <ns1:releaseStatus>Published</ns1:releaseStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/nutritionInstructionText">
    <skos:definition xml:lang="en">Records the instruction in human-readable form.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/nutrition"/>
    <rdfs:label xml:lang="en">nutrition instruction text</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/NutritionInstruction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ClinicalFinding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A clinically meaningful finding that may indicate status, risk, abnormality, progression, or need for follow-up.</skos:definition>
    <rdfs:label xml:lang="en">Clinical Finding</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CurativeTreatmentIntent">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/CancerTreatmentIntentScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/CancerTreatmentIntent"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CancerTreatmentIntentScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Curative treatment intent</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:label xml:lang="en">Curative treatment intent</rdfs:label>
    <skos:definition xml:lang="en">A cancer-treatment intent in which treatment is delivered with the aim of curing the cancer.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CardiotoxicityRisk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cardiotoxicity Risk</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <skos:definition xml:lang="en">A cancer-treatment-related risk concept describing potential cardiotoxic late effects associated with treatment exposure.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:comment xml:lang="en">The range of skos:prefLabel is the class of RDF plain literals.</rdfs:comment>
    <rdfs:comment xml:lang="en">A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag.</rdfs:comment>
    <rdfs:comment xml:lang="en">skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise
      disjoint properties.</rdfs:comment>
    <skos:definition xml:lang="en">The preferred lexical label for a resource, in a given language.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
    <rdfs:label xml:lang="en">preferred label</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/radiotherapyBodySiteName">
    <rdfs:label xml:lang="en">radiotherapy body site name</rdfs:label>
    <skos:definition xml:lang="en">Records the name of the radiotherapy body site or field.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RadiotherapyBodySite"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/riskEstimateEstimatesConditionRisk">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RiskEstimate"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ClinicalCondition"/>
    <skos:definition xml:lang="en">Relates Risk Estimate to Clinical Condition.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">estimates condition risk</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RiskCategoryValueScheme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Risk Category Value scheme</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/HighRisk"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ModerateRisk"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/VeryHighRisk"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/LowRisk"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/UnknownRisk"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/hasEducationalAttainment">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/EducationalAttainment"/>
    <rdfs:label xml:lang="en">has educational attainment</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/EducationalAttainmentValue"/>
    <skos:definition xml:lang="en">Highest attained or current education level, preferably from a controlled vocabulary.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/measurementEventMeasures">
    <rdfs:label xml:lang="en">measures</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurementEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/MeasurableParameter"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <skos:definition xml:lang="en">Relates Measurement Event to Measurable Parameter.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/LivingSituation">
    <rdfs:label xml:lang="en">Living Situation</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/SocialContextFactor"/>
    <skos:definition xml:lang="en">Household and housing circumstances relevant to support availability, privacy, digital-service use, or access to care.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/StudyTimepointTypeScheme">
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/BaselineTimepointType"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/EndOfInterventionTimepointType"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/MidInterventionTimepointType"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/FollowUpTimepointType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Study Timepoint Type scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#hasTopConcept">
    <rdfs:domain rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates, by convention, a concept scheme to a concept which is topmost in the broader/narrower concept hierarchies for that scheme, providing an entry point to these hierarchies.</skos:definition>
    <rdfs:label xml:lang="en">has top concept</rdfs:label>
    <owl:inverseOf rdf:resource="http://www.w3.org/2004/02/skos/core#topConceptOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/EvaluationPhaseType">
    <rdf:type rdf:resource="https://w3id.org/icareonto/PilotPhaseType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/PilotPhaseTypeScheme"/>
    <rdfs:label xml:lang="en">Evaluation phase</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/PilotPhaseTypeScheme"/>
    <skos:definition xml:lang="en">A pilot-phase type representing evaluation.</skos:definition>
    <skos:prefLabel xml:lang="en">Evaluation phase</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PausedMedicationStatus">
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/MedicationStatusScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/MedicationStatus"/>
    <skos:prefLabel xml:lang="en">Paused medication status</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:definition xml:lang="en">A medication-status value indicating paused status.</skos:definition>
    <rdfs:label xml:lang="en">Paused medication status</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/MedicationStatusScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/derivedParameterDerivedFrom">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">derived from</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DerivedParameter"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/MeasurableParameter"/>
    <skos:definition xml:lang="en">Relates a derived parameter to source parameters used to calculate it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/activityExecutionHasIdentifier">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <skos:definition xml:lang="en">Records an identifier for an activity execution.</skos:definition>
    <rdfs:label xml:lang="en">activity execution identifier</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ActivityExecution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/dialogueSessionStartedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DialogueSession"/>
    <rdfs:label xml:lang="en">started at</rdfs:label>
    <skos:definition xml:lang="en">Identifies when the dialogue session began.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Timepoint"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MeasurementInstrument">
    <rdfs:label xml:lang="en">Measurement Instrument</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <skos:definition xml:lang="en">A device, questionnaire, tool, protocol, or assessment instrument used to collect or produce a measurement.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SafetyRuleType">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <rdfs:label xml:lang="en">Safety Rule Type</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A controlled concept categorising the purpose of a safety rule.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ContextInfluenceValueScheme">
    <rdfs:label xml:lang="en">Context Influence Value scheme</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/MixedInfluence"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/Facilitator"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/Barrier"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MeasurementUnitSlot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/SlotType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Measurement unit slot</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">A dialogue-slot type used to capture measurement unit.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SlotTypeScheme"/>
    <skos:prefLabel xml:lang="en">Measurement unit slot</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SlotTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/participantEnrolmentInStudy">
    <rdfs:label xml:lang="en">enrolment in study</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ParticipantEnrolment"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/PilotStudy"/>
    <skos:definition xml:lang="en">Identifies the study in which the person is enrolled.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RecommendationStrength">
    <rdfs:label xml:lang="en">Recommendation Strength</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">Strength of a recommendation, kept separate from certainty of evidence.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/LowCertaintyEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EvidenceGrade"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/EvidenceGradeScheme"/>
    <rdfs:label xml:lang="en">Low certainty evidence</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/EvidenceGradeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">An evidence grade indicating low certainty in the relevant body of evidence under the stated grading approach.</skos:definition>
    <skos:prefLabel xml:lang="en">Low certainty evidence</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RiskEstimate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A quantitative or categorical estimate of the likelihood, severity, or level of cardiovascular risk for a condition or adverse event.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdfs:label xml:lang="en">Risk Estimate</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/parameterCodeSystem">
    <rdfs:label xml:lang="en">parameter code system</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurableParameter"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <skos:definition xml:lang="en">Identifies the terminology or code system that defines the parameter code.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/frequencyValue">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Frequency"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Records the frequency value for Frequency.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <rdfs:label xml:lang="en">frequency value</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/clinicalRecordIdentifier">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ClinicalRecord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Records the clinical record identifier for Clinical Record.</skos:definition>
    <rdfs:label xml:lang="en">clinical record identifier</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/findingDerivedFromMeasurement">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/MeasurementEvent"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ClinicalFinding"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">derived from measurement</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:definition xml:lang="en">Relates a clinical finding to supporting measurement evidence.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/FinancialConstraint">
    <rdfs:label xml:lang="en">Financial Constraint</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">Financial difficulty that limits access to care, transport, connectivity, suitable equipment, healthy living resources, or intervention participation.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/SocioEconomicFactor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CarePlanParticipation">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:label xml:lang="en">Care Plan Participation</rdfs:label>
    <skos:definition xml:lang="en">A representation of a person's role in a care plan, such as survivor, clinician, caregiver, or reviewer.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/measurementEventUsesSpecimen">
    <rdfs:label xml:lang="en">uses specimen</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurementEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <skos:definition xml:lang="en">Relates a laboratory measurement event to the specimen used.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Specimen"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/LanguageBarrier">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdfs:label xml:lang="en">Language Barrier</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">Difficulty accessing or using care or digital services because an appropriate spoken or written language is unavailable or insufficiently understood.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/AccessOrEngagementBarrier"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/TreadmillWalking">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ExerciseActivityType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ExerciseActivityTypeScheme"/>
    <skos:definition xml:lang="en">An exercise-activity type involving walking on a treadmill.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Treadmill walking</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ExerciseActivityTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:label xml:lang="en">Treadmill walking</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/GoalLifecycleStatus">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A controlled concept representing the operational state of a goal throughout its lifecycle and whether it remains subject to active pursuit.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:label xml:lang="en">Goal Lifecycle Status</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/LivesWithFamily">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/LivingSituationType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:prefLabel xml:lang="en">Lives with family</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/LivingSituationTypeScheme"/>
    <skos:definition xml:lang="en">A living-situation type indicating that the person lives with one or more family members.</skos:definition>
    <rdfs:label xml:lang="en">Lives with family</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/LivingSituationTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ContentComplexityLevel">
