    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A protocol-defined assessment point such as baseline, end of intervention or follow-up.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/TNMStagingSystem">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">The tumour-node-metastasis staging system used to describe the anatomical extent of cancer.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/CancerStagingSystem"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
