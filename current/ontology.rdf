    <skos:definition xml:lang="en">Indicates that the value represents the TNM regional-lymph-node category, such as N1.</skos:definition>
    <rdfs:label xml:lang="en">Regional node category</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CancerStageComponentTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/CancerStageComponentTypeScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/UnknownRisk">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/RiskCategoryValueScheme"/>
    <rdfs:label xml:lang="en">Unknown risk</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/icareonto/RiskCategoryValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/RiskCategoryValueScheme"/>
    <skos:prefLabel xml:lang="en">Unknown risk</skos:prefLabel>
    <skos:definition xml:lang="en">A risk-category value indicating unknown risk.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ModelOutput">
    <skos:definition xml:lang="en">The direct output of a model execution, before or alongside conversion into a risk profile or risk estimate.</skos:definition>
    <rdfs:label xml:lang="en">Model Output</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/participationHasParticipant">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CarePlanParticipation"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Person"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has participant</rdfs:label>
    <skos:definition xml:lang="en">Relates Care Plan Participation to Person.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SelfReportedDataSource">
    <skos:definition xml:lang="en">A data source in which information was reported directly by the person to whom it relates, rather than obtained from a device or clinical record.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/DataSource"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">Self Reported Data Source</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PolicyRecommendation">
    <skos:definition xml:lang="en">A recommendation directed towards policy, organisational, or health-system action.</skos:definition>
    <rdfs:label xml:lang="en">Policy Recommendation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/Recommendation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RiskCategoryValue">
    <rdfs:label xml:lang="en">Risk Category Value</rdfs:label>
    <skos:definition xml:lang="en">A controlled concept representing a qualitative category assigned to a risk estimate, such as low, moderate, high or very high risk.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Frequency">
    <rdfs:label xml:lang="en">Frequency</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A value describing how often a scheduled activity should occur.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ResourceAudienceType">
    <skos:definition xml:lang="en">Intended audience of a knowledge resource.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Resource Audience Type</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/InformationAccessSupportNeed">
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/HealthLiteracyNeedTypeScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyNeedType"/>
