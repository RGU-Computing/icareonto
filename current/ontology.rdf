    <rdfs:label xml:lang="en">Video</rdfs:label>
    <skos:definition xml:lang="en">A resource format that uses video as its primary presentation format.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PhysicalPerformanceParameter">
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/MeasurableParameter"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Physical Performance Parameter</rdfs:label>
    <skos:definition xml:lang="en">A measurable parameter describing physical function, exercise capacity, strength, mobility, endurance, or activity tolerance.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/dialogueContextHasSlot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/DialogueSlot"/>
    <rdfs:label xml:lang="en">has slot</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DialogueContext"/>
    <skos:definition xml:lang="en">Associates the current context with an expected or populated information slot.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/prescriptionVersion">
