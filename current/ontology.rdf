  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#hiddenLabel">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <skos:definition xml:lang="en">A lexical label for a resource that should be hidden when generating visual displays of the resource, but should still be accessible to free text search operations.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <rdfs:comment xml:lang="en">The range of skos:hiddenLabel is the class of RDF plain literals.</rdfs:comment>
    <rdfs:comment xml:lang="en">skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties.</rdfs:comment>
    <rdfs:label xml:lang="en">hidden label</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RemoteMonitoringServiceType">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/DigitalServiceType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/healthhub-service"/>
    <skos:definition xml:lang="en">A digital-service type providing remote monitoring.</skos:definition>
    <skos:prefLabel xml:lang="en">Remote monitoring service</skos:prefLabel>
    <rdfs:label xml:lang="en">Remote monitoring service</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/DigitalServiceTypeScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/DigitalServiceTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ClinicalAssessment">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:definition xml:lang="en">An assessment activity used to evaluate clinical status, late-effect risk, symptoms, function, monitoring results, or care needs.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/ActivityExecution"/>
    <rdfs:label xml:lang="en">Clinical Assessment</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/nutritionTargetUnitText">
    <rdfs:label xml:lang="en">nutrition target unit text</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/NutritionInstruction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/nutrition"/>
    <skos:definition xml:lang="en">Records the unit associated with the target, such as portions, grams, or millilitres.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Video">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ResourceFormatScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ResourceFormat"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
