  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/FlexibilityExercise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ExerciseModality"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Flexibility exercise</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">An exercise modality intended to maintain or improve range of motion and flexibility.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ExerciseModalityScheme"/>
    <rdfs:label xml:lang="en">Flexibility exercise</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ExerciseModalityScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/userIntentRequiresSlot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Identifies information required to fulfil an intent.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/SlotType"/>
    <rdfs:label xml:lang="en">requires slot</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/UserIntent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CommunicationChannelType">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <skos:definition xml:lang="en">A controlled concept classifying the medium or interface through which communication is delivered or accessed, such as a smart mirror, mobile application, telephone or in-person interaction.</skos:definition>
    <rdfs:label xml:lang="en">Communication Channel Type</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/hasContextInfluence">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/SocialContextFactor"/>
    <skos:definition xml:lang="en">Whether the factor currently acts as a barrier, facilitator, mixed influence, or has unknown influence.</skos:definition>
    <rdfs:label xml:lang="en">has context influence</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ContextInfluenceValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/activityRequiresReviewBy">
    <rdfs:label xml:lang="en">requires review by</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CarePlanActivity"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/PersonRole"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates an activity to the role expected to review it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MissedActivity">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ActivityStatusScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ActivityStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:label xml:lang="en">Missed activity</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ActivityStatusScheme"/>
    <skos:prefLabel xml:lang="en">Missed activity</skos:prefLabel>
    <skos:definition xml:lang="en">An activity status indicating that the activity is missed.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SamplingProcedure">
    <skos:definition xml:lang="en">A procedure describing how a sample or reading was obtained, especially for laboratory or repeated home measurements.</skos:definition>
