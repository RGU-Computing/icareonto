<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:ns1="https://w3id.org/icareonto/metadata#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://w3id.org/icareonto/riskEstimateHasCategory">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/RiskCategoryValue"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RiskEstimate"/>
    <skos:definition xml:lang="en">A controlled concept representing a qualitative category assigned to a risk estimate, such as low, moderate, high or very high risk.</skos:definition>
    <rdfs:label xml:lang="en">has category</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SupportCareNavigation">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ResourcePurposeScheme"/>
    <skos:definition xml:lang="en">A resource purpose indicating that the resource is intended to support navigation of healthcare or support services.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ResourcePurpose"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ResourcePurposeScheme"/>
    <rdfs:label xml:lang="en">Support care navigation</rdfs:label>
    <skos:prefLabel xml:lang="en">Support care navigation</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MorningTimeOfDay">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/TimeOfDayScheme"/>
    <rdfs:label xml:lang="en">Morning time of day</rdfs:label>
    <skos:definition xml:lang="en">A time-of-day value representing the morning period.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/TimeOfDay"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/TimeOfDayScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Morning time of day</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/StoppedMedicationStatus">
    <rdf:type rdf:resource="https://w3id.org/icareonto/MedicationStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/MedicationStatusScheme"/>
    <skos:prefLabel xml:lang="en">Stopped medication status</skos:prefLabel>
    <skos:definition xml:lang="en">A medication-status value indicating stopped status.</skos:definition>
    <rdfs:label xml:lang="en">Stopped medication status</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/MedicationStatusScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/riskProfileValidDuring">
    <skos:definition xml:lang="en">Relates Risk Profile to Time Interval.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/TimeInterval"/>
    <rdfs:label xml:lang="en">valid during</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RiskProfile"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/adherencePercent">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <skos:definition xml:lang="en">Percentage adherence, normally constrained to 0-100.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseAdherenceResult"/>
    <rdfs:label xml:lang="en">adherence percent</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RequestRecommendation">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/UserIntentScheme"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/UserIntent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">A user-intent concept indicating that the user intends to request recommendation.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/UserIntentScheme"/>
    <rdfs:label xml:lang="en">Request recommendation</rdfs:label>
    <skos:prefLabel xml:lang="en">Request recommendation</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SmokingStatusValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <skos:definition xml:lang="en">A controlled concept representing a person’s current or historical tobacco-smoking status, such as never smoked, former smoker, current smoker or unknown.</skos:definition>
    <rdfs:label xml:lang="en">Smoking Status Value</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ResolvedClinicalStatus">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ClinicalStatusScheme"/>
    <rdfs:label xml:lang="en">Resolved clinical status</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ClinicalStatus"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ClinicalStatusScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Resolved clinical status</skos:prefLabel>
    <skos:definition xml:lang="en">A clinical-status value indicating resolved status.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MonitoringAdherenceBehaviour">
    <rdfs:label xml:lang="en">Monitoring Adherence Behaviour</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/AdherenceBehaviour"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">Adherence behaviour specific to home monitoring, check-ins, measurements, or follow-up tasks.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/recommendationText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Human-readable wording of the recommendation.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">recommendation text</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Recommendation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/DigitalInteractionSupportNeed">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyNeedType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/HealthLiteracyNeedTypeScheme"/>
    <skos:prefLabel xml:lang="en">Digital interaction support need</skos:prefLabel>
    <skos:definition xml:lang="en">An identified need for support using digital health interfaces, information or services.</skos:definition>
    <rdfs:label xml:lang="en">Digital interaction support need</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/HealthLiteracyNeedTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PrecontemplationStage">
    <rdf:type rdf:resource="https://w3id.org/icareonto/BehaviourChangeStage"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/BehaviourChangeStageScheme"/>
    <rdfs:label xml:lang="en">Precontemplation stage</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Precontemplation stage</skos:prefLabel>
    <skos:definition xml:lang="en">A behaviour-change stage in which the person is not currently intending to make the relevant change.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/BehaviourChangeStageScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CancerTreatmentIntentScheme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/CurativeTreatmentIntent"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/PalliativeTreatmentIntent"/>
    <rdfs:label xml:lang="en">Cancer Treatment Intent scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/recommendationHasEvidenceGrade">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Recommendation"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/EvidenceGrade"/>
    <skos:definition xml:lang="en">Relates Recommendation to Evidence Grade.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has evidence grade</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AdvancedComplexity">
    <skos:prefLabel xml:lang="en">Advanced complexity</skos:prefLabel>
    <skos:definition xml:lang="en">A content-complexity level indicating advanced complexity.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ContentComplexityLevelScheme"/>
    <rdfs:label xml:lang="en">Advanced complexity</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ContentComplexityLevel"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ContentComplexityLevelScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/contributionValue">
    <skos:definition xml:lang="en">Records a numeric contribution, weight, coefficient, or importance score.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdfs:label xml:lang="en">contribution value</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RiskFactorContribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/FinancialConstraintStatusValue">
    <skos:definition xml:lang="en">Permitted financial-constraint states</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Financial Constraint Status Value</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/personHasRiskProfile">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <skos:definition xml:lang="en">Relates Person to Risk Profile.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Person"/>
    <rdfs:label xml:lang="en">has risk profile</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/RiskProfile"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/OnHoldGoalLifecycleStatus">
    <skos:definition xml:lang="en">A goal-lifecycle status indicating on-hold.</skos:definition>
    <skos:prefLabel xml:lang="en">On-hold goal lifecycle status</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/GoalLifecycleStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">On-hold goal lifecycle status</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/GoalLifecycleStatusScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/GoalLifecycleStatusScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/pilotSiteHasLocale">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PilotSite"/>
    <skos:definition xml:lang="en">Identifies a locale supported by the site.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Locale"/>
    <rdfs:label xml:lang="en">has locale</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/clinicalRecordHasSource">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdfs:label xml:lang="en">has source</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ClinicalRecord"/>
    <skos:definition xml:lang="en">Relates Clinical Record to Data Source.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/DataSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/InterventionArmType">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/StudyArmTypeScheme"/>
    <skos:prefLabel xml:lang="en">Intervention arm</skos:prefLabel>
    <rdf:type rdf:resource="https://w3id.org/icareonto/StudyArmType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A study-arm type identifying a participant group assigned to receive the intervention under evaluation.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/StudyArmTypeScheme"/>
    <rdfs:label xml:lang="en">Intervention arm</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ExerciseActivityTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/TreadmillWalking"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/PressUp"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ResistanceBandRow"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/Walking"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/Cycling"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/Running"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/Squat"/>
    <rdfs:label xml:lang="en">Exercise Activity Type scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/symptomRecordHasSeverity">
    <skos:definition xml:lang="en">Relates a symptom record to its severity.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Severity"/>
    <rdfs:label xml:lang="en">has severity</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/SymptomRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Infographic">
    <skos:prefLabel xml:lang="en">Infographic</skos:prefLabel>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ResourceFormat"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ResourceFormatScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ResourceFormatScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">A resource format that uses infographic as its primary presentation format.</skos:definition>
    <rdfs:label xml:lang="en">Infographic</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/parameterCodeVersion">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurableParameter"/>
    <skos:definition xml:lang="en">Identifies the version of the terminology from which the parameter code was selected.</skos:definition>
    <rdfs:label xml:lang="en">parameter code version</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ClinicalConditionRecord">
    <rdfs:label xml:lang="en">Clinical Condition Record</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/ClinicalRecord"/>
    <skos:definition xml:lang="en">A clinical record documenting the presence, absence, history, severity, status, or monitoring state of a clinical condition.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/participantEnrolmentInPhase">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/PilotPhase"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ParticipantEnrolment"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">enrolment has phase</rdfs:label>
    <skos:definition xml:lang="en">Identifies a pilot phase in which the participant takes part.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/preferenceValue">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PersonPreference"/>
    <skos:definition xml:lang="en">Records the preference value, such as "SMS", "Italian", "brief", or "evening".</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">preference value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ExerciseTrainingPatternScheme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ContinuousTraining"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/IntervalTraining"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/HighIntensityIntervalTraining"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/CircuitTraining"/>
