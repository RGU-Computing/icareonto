    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">An agent capability to provide self monitoring support.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/AgentCapability"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/AgentCapabilityScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/recommendationHasContraindication">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates Recommendation to Contraindication.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Recommendation"/>
    <rdfs:label xml:lang="en">has contraindication</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Contraindication"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RecurrencePattern">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <skos:definition xml:lang="en">A controlled concept classifying the repeated temporal pattern according to which an activity, assessment, intervention or reminder is scheduled, such as daily, weekly or monthly.</skos:definition>
    <rdfs:label xml:lang="en">Recurrence Pattern</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/behaviourRecordHasSmokingStatus">
