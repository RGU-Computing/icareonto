    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/UnableToWork"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/SelfEmployed"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/OnLeave"/>
