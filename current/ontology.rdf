  <rdf:Description rdf:about="https://w3id.org/icareonto/Increase">
    <skos:definition xml:lang="en">A nutrition action indicating that the targeted dietary component should be increased.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/NutritionActionTypeScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/NutritionActionTypeScheme"/>
    <skos:prefLabel xml:lang="en">Increase</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
