    <skos:definition xml:lang="en">A structured plan for when an activity, protocol, visit, or reminder should occur.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AmbiguousSlot">
    <skos:prefLabel xml:lang="en">Ambiguous slot</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SlotStatusValueScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
