    <rdfs:label xml:lang="en">intervention addresses need</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ModerateIntensity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ExerciseIntensityLevel"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">An exercise-intensity level representing moderate physical effort.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <skos:prefLabel xml:lang="en">Moderate intensity</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ExerciseIntensityLevelScheme"/>
    <rdfs:label xml:lang="en">Moderate intensity</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ExerciseIntensityLevelScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/StemCellTransplantTreatment">
    <rdfs:label xml:lang="en">Stem cell transplant treatment</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/icareonto/CancerTreatmentType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CancerTreatmentTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <skos:broader rdf:resource="https://w3id.org/icareonto/SystemicTreatment"/>
    <skos:definition xml:lang="en">A cancer-treatment type involving transplantation of blood-forming stem cells as part of cancer treatment.</skos:definition>
    <skos:prefLabel xml:lang="en">Stem cell transplant treatment</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AboveReferenceRange">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ThresholdCategoryScheme"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ThresholdCategory"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">Above reference range</rdfs:label>
    <skos:prefLabel xml:lang="en">Above reference range</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ThresholdCategoryScheme"/>
    <skos:definition xml:lang="en">A threshold category indicating that the observed value is above the applicable reference range.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CustomRecurrence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/RecurrencePattern"/>
    <skos:prefLabel xml:lang="en">Custom recurrence</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/RecurrencePatternScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <rdfs:label xml:lang="en">Custom recurrence</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/RecurrencePatternScheme"/>
    <skos:definition xml:lang="en">A recurrence pattern defined by a schedule that does not correspond to the standard daily, weekly or monthly patterns.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ExerciseSet">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A set within an exercise prescription or performed session, grouping repeated executions of an activity.</skos:definition>
    <rdfs:label xml:lang="en">Exercise Set</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CardiovascularCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cardiovascular Condition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/ClinicalCondition"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:definition xml:lang="en">A clinical condition affecting the heart or vascular system, including hypertension, cardiomyopathy, arrhythmia, heart failure, or other cardiovascular late effects.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/behaviourRecordValidDuring">
    <skos:definition xml:lang="en">Relates a behaviour record to the interval during which the behaviour summary applies.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/TimeInterval"/>
    <rdfs:label xml:lang="en">valid during</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/BehaviourRecord"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CommunicationPreference">
    <skos:definition xml:lang="en">A preference specifying how a person prefers to communicate or receive contact, such as channel, timing, frequency, format, or level of detail.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/PersonPreference"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <rdfs:label xml:lang="en">Communication Preference</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ContactPreference">
    <skos:definition xml:lang="en">A preference describing preferred contact channels, timing, or communication method.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/CommunicationPreference"/>
    <rdfs:label xml:lang="en">Contact Preference</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/LivesAlone">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/LivingSituationType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/LivingSituationTypeScheme"/>
    <skos:prefLabel xml:lang="en">Lives alone</skos:prefLabel>
    <skos:definition xml:lang="en">A living-situation type indicating that the person lives alone.</skos:definition>
    <rdfs:label xml:lang="en">Lives alone</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/LivingSituationTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/IntervalTraining">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ExerciseTrainingPattern"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ExerciseTrainingPatternScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <skos:prefLabel xml:lang="en">Interval training</skos:prefLabel>
    <skos:definition xml:lang="en">An exercise-training pattern alternating work periods with recovery or lower-intensity periods.</skos:definition>
    <rdfs:label xml:lang="en">Interval training</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ExerciseTrainingPatternScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PerformedExerciseSession">
    <rdfs:label xml:lang="en">Performed Exercise Session</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/ActivityExecution"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">An exercise session that was actually performed by a person, including completed activities, actual duration, intensity, monitoring data, and adherence evidence.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/symptomBasedTriggerUsesSymptomRecord">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:definition xml:lang="en">Relates a symptom-based trigger to the symptom record that caused it.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">uses symptom record</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/SymptomBasedTrigger"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/SymptomRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/instrumentName">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurementInstrument"/>
    <rdfs:label xml:lang="en">instrument name</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Records the name of a measurement instrument.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MeasurementInterpretation">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">Measurement Interpretation</rdfs:label>
    <skos:definition xml:lang="en">An interpretation derived from one or more observation results, thresholds, reference ranges, or clinical context.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/LivingSituationType">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Living Situation Type</rdfs:label>
    <skos:definition xml:lang="en">Permitted living-arrangement values</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/treatmentRecordHasSetting">
