    <rdfs:range rdf:resource="https://w3id.org/icareonto/ResponseStatus"/>
    <rdfs:label xml:lang="en">has response status</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
