  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#historyNote">
    <rdfs:label xml:lang="en">history note</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <skos:definition xml:lang="en">A note about the past state/use/meaning of a concept.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#note"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RequestInformation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/UserIntent"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/UserIntentScheme"/>
    <skos:definition xml:lang="en">A user-intent concept indicating that the user intends to request information.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/UserIntentScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Request information</rdfs:label>
    <skos:prefLabel xml:lang="en">Request information</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AnthracyclineExposure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Anthracycline Exposure</rdfs:label>
    <skos:definition xml:lang="en">Exposure to anthracycline chemotherapy, represented because cumulative anthracycline dose is a key factor in cardiovascular late-effect risk.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/ChemotherapyExposure"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ScheduledActivity">
    <rdfs:label xml:lang="en">Scheduled activity</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ActivityStatus"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ActivityStatusScheme"/>
    <skos:definition xml:lang="en">An activity status indicating that the activity is scheduled.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:prefLabel xml:lang="en">Scheduled activity</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ActivityStatusScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/FIGOStagingSystem">
    <rdfs:label xml:lang="en">FIGO staging system</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/CancerStagingSystem"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/CancerStagingSystemScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CancerStagingSystemScheme"/>
    <skos:prefLabel xml:lang="en">FIGO staging system</skos:prefLabel>
    <skos:definition xml:lang="en">The cancer-staging system maintained by the International Federation of Gynecology and Obstetrics for relevant gynaecological cancers.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AerobicExercise">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ExerciseModality"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">An exercise modality primarily involving sustained activity that increases cardiorespiratory demand.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ExerciseModalityScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <skos:prefLabel xml:lang="en">Aerobic exercise</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ExerciseModalityScheme"/>
    <rdfs:label xml:lang="en">Aerobic exercise</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CancelledGoalLifecycleStatus">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/GoalLifecycleStatusScheme"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/GoalLifecycleStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/GoalLifecycleStatusScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Cancelled goal lifecycle status</skos:prefLabel>
    <rdfs:label xml:lang="en">Cancelled goal lifecycle status</rdfs:label>
    <skos:definition xml:lang="en">A goal-lifecycle status indicating cancelled.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/protocolSpecifiesMethod">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/MeasurementMethod"/>
    <skos:definition xml:lang="en">Identifies the measurement method prescribed or recommended by a protocol.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">specifies method</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurementProtocol"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SevereSeverity">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ClinicalSeverityLevel"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Severe severity</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ClinicalSeverityLevelScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ClinicalSeverityLevelScheme"/>
    <skos:definition xml:lang="en">A clinical-severity level indicating severe clinical severity.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:prefLabel xml:lang="en">Severe severity</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AccessibilityFeature">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Accessibility Feature</rdfs:label>
    <skos:definition xml:lang="en">Accessibility characteristics available in a resource.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/QuantityValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <skos:definition xml:lang="en">A value object representing a recorded quantity, score, unit, category, or textual value.</skos:definition>
    <rdfs:label xml:lang="en">Quantity Value</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/TreatmentExposure">
    <skos:definition xml:lang="en">A representation of a person’s exposure to a cancer treatment or treatment-related factor, modelled separately so it can be reused in risk prediction and survivorship assessment.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Treatment Exposure</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/TertiaryEducation">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/EducationalAttainmentValueScheme"/>
    <skos:prefLabel xml:lang="en">Tertiary education</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EducationalAttainmentValue"/>
    <rdfs:label xml:lang="en">Tertiary education</rdfs:label>
    <skos:definition xml:lang="en">An educational-attainment value representing education provided by a university, college or comparable post-secondary institution.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/EducationalAttainmentValueScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/dialogueSlotLiteralValue">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DialogueSlot"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Literal slot value when it is not represented by a structured ontology entity.</skos:definition>
    <rdfs:label xml:lang="en">dialogue slot literal value</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#note">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <skos:definition xml:lang="en">A general note, for any purpose.</skos:definition>
    <skos:scopeNote xml:lang="en">This property may be used directly, or as a super-property for more specific note types.</skos:scopeNote>
    <rdfs:label xml:lang="en">note</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/knowledgeResourceHasApplicabilityCriterion">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/KnowledgeResource"/>
    <rdfs:label xml:lang="en">has applicability criterion</rdfs:label>
    <skos:definition xml:lang="en">Describes conditions under which the resource is suitable.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ApplicabilityCriterion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/serviceUseDuration">
    <ns1:valuePattern>^-?P([0-9]+W|([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)(T([0-9]+H([0-9]+M)?([0-9]+(\.[0-9]+)?S)?|[0-9]+M([0-9]+(\.[0-9]+)?S)?|[0-9]+(\.[0-9]+)?S))?|T([0-9]+H([0-9]+M)?([0-9]+(\.[0-9]+)?S)?|[0-9]+M([0-9]+(\.[0-9]+)?S)?|[0-9]+(\.[0-9]+)?S))$</ns1:valuePattern>
    <rdfs:label xml:lang="en">service use duration</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ServiceUseEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Records the elapsed duration of a service-use event as an ISO 8601 duration string, for example PT15M for fifteen minutes, supporting analysis of service engagement.</skos:definition>
    <ns1:valueFormat>iso-duration</ns1:valueFormat>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/healthhub-service"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/thresholdNumericValue">
    <skos:definition xml:lang="en">Records the threshold numeric value for Alert Threshold.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/AlertThreshold"/>
    <rdfs:label xml:lang="en">threshold numeric value</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SlotTypeScheme">
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/GoalSlot"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/SymptomOnsetSlot"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/MeasurementTimeSlot"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/SymptomSeveritySlot"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/MeasurementValueSlot"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ActivityTypeSlot"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/MeasurementUnitSlot"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/SymptomTypeSlot"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ResourceTopicSlot"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/MeasurementTypeSlot"/>
    <rdfs:label xml:lang="en">Slot Type scheme</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/NotAttainableGoalAchievementStatus">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/GoalAchievementStatusScheme"/>
    <rdfs:label xml:lang="en">Not-attainable goal achievement status</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/GoalAchievementStatusScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/GoalAchievementStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:definition xml:lang="en">A goal-achievement status indicating not-attainable.</skos:definition>
    <skos:prefLabel xml:lang="en">Not-attainable goal achievement status</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/dataSourceName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Records the display name or common name of a data source.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DataSource"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <rdfs:label xml:lang="en">data source name</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/repetitionCount">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:label xml:lang="en">repetition count</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseSet"/>
    <skos:definition xml:lang="en">Exact repetitions prescribed or performed per set.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/IndeterminateResult">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ThresholdCategory"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ThresholdCategoryScheme"/>
    <skos:definition xml:lang="en">A threshold category indicating that the result cannot be reliably classified against the applicable range or threshold.</skos:definition>
    <skos:prefLabel xml:lang="en">Indeterminate result</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ThresholdCategoryScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">Indeterminate result</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ScreenReaderCompatible">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/AccessibilityFeature"/>
    <skos:prefLabel xml:lang="en">Screen-reader compatible</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/AccessibilityFeatureScheme"/>
    <rdfs:label xml:lang="en">Screen-reader compatible</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/AccessibilityFeatureScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <skos:definition xml:lang="en">An accessibility feature indicating that digital content is structured for use with screen-reading software.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PrivacyProtectionRule">
    <rdf:type rdf:resource="https://w3id.org/icareonto/SafetyRuleType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SafetyRuleTypeScheme"/>
    <rdfs:label xml:lang="en">Privacy protection rule</rdfs:label>
    <skos:definition xml:lang="en">A safety-rule type requiring protection of personal information and observance of applicable privacy constraints.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SafetyRuleTypeScheme"/>
    <skos:prefLabel xml:lang="en">Privacy protection rule</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CircuitTraining">
    <skos:prefLabel xml:lang="en">Circuit training</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ExerciseTrainingPattern"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Circuit training</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ExerciseTrainingPatternScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ExerciseTrainingPatternScheme"/>
    <skos:definition xml:lang="en">An exercise-training pattern involving a sequence of different exercises or stations.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/unitCodeSystem">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">unit code system</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Unit"/>
    <skos:definition xml:lang="en">Identifies the code system that defines the unit code.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PersonAttribute">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A recorded characteristic of a person that may be used for personalisation, risk assessment, eligibility, care planning, or study analysis.</skos:definition>
    <rdfs:label xml:lang="en">Person Attribute</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ExerciseIntervention">
    <rdfs:label xml:lang="en">Exercise Intervention</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:definition xml:lang="en">An intervention involving prescribed, guided, or monitored physical activity or exercise.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/Intervention"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/UnknownSmokingStatus">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">A smoking-status value indicating that current and historical smoking status is unknown.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/SmokingStatusValue"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SmokingStatusValueScheme"/>
    <rdfs:label xml:lang="en">Unknown smoking status</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SmokingStatusValueScheme"/>
    <skos:prefLabel xml:lang="en">Unknown smoking status</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/isSupervised">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Indicates whether exercise is intended to be supervised.</skos:definition>
    <rdfs:label xml:lang="en">is supervised</rdfs:label>
