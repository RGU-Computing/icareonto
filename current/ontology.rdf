    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CarePlan"/>
    <rdfs:label xml:lang="en">includes</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AlertThreshold">
    <skos:definition xml:lang="en">A threshold used to identify values requiring attention, review, warning, escalation, or clinical interpretation.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">Alert Threshold</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ConsistentSupport">
    <rdf:type rdf:resource="https://w3id.org/icareonto/SupportAvailabilityValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SupportAvailabilityValueScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SupportAvailabilityValueScheme"/>
    <skos:prefLabel xml:lang="en">Consistent support</skos:prefLabel>
    <skos:definition xml:lang="en">A support-availability value indicating that dependable support is regularly available.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdfs:label xml:lang="en">Consistent support</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/riskProfileAssessedAt">
