    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <rdfs:label xml:lang="en">has smoking status</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/BehaviourRecord"/>
    <skos:definition xml:lang="en">Identifies the smoking-status category reported or determined for a behaviour record.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/plannedSessionHasStatus">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PlannedExerciseSession"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <skos:definition xml:lang="en">Records states such as scheduled, cancelled, missed, or rescheduled.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ActivityStatus"/>
    <rdfs:label xml:lang="en">has status</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PreparationStage">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/BehaviourChangeStageScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/BehaviourChangeStage"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Preparation stage</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/BehaviourChangeStageScheme"/>
    <skos:definition xml:lang="en">A behaviour-change stage in which the person is preparing or planning to make the relevant change.</skos:definition>
    <rdfs:label xml:lang="en">Preparation stage</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/EmploymentStatusValueScheme">
