  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PathologicalStageType">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <skos:prefLabel xml:lang="en">Pathological stage</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/CancerStageTypeScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/CancerStageType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Pathological stage</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CancerStageTypeScheme"/>
    <skos:definition xml:lang="en">A cancer-stage type based on pathological examination of tissue obtained during surgery or another procedure.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RadiotherapyExposure">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/CardiotoxicTreatmentExposure"/>
    <skos:definition xml:lang="en">Exposure to radiotherapy, including dose, treatment field, anatomical site, and timing where available.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Radiotherapy Exposure</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PrimaryEducation">
    <rdf:type rdf:resource="https://w3id.org/icareonto/EducationalAttainmentValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/EducationalAttainmentValueScheme"/>
    <skos:definition xml:lang="en">An educational-attainment value representing education at primary-school level.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:prefLabel xml:lang="en">Primary education</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/EducationalAttainmentValueScheme"/>
    <rdfs:label xml:lang="en">Primary education</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MentalHealthAndEmotionalWellbeing">
    <skos:prefLabel xml:lang="en">Mental health and emotional wellbeing</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ResourceTopicScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ResourceTopic"/>
    <rdfs:label xml:lang="en">Mental health and emotional wellbeing</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ResourceTopicScheme"/>
    <skos:definition xml:lang="en">Emotional and psychological aspects of living with and after cancer, including worry, stress, mood, coping, adjustment and access to appropriate support.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/measurementEventHasOutput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ObservationResult"/>
    <skos:definition xml:lang="en">Relates Measurement Event to Observation Result.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurementEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">has output</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SecondaryEducation">
    <skos:definition xml:lang="en">An educational-attainment value representing education at secondary-school level.</skos:definition>
    <skos:prefLabel xml:lang="en">Secondary education</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/EducationalAttainmentValueScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EducationalAttainmentValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Secondary education</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/EducationalAttainmentValueScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SeverityLevel">
    <rdfs:label xml:lang="en">Severity Level</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
