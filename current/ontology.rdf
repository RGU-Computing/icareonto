  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ResistanceBandRow">
    <rdf:type rdf:resource="https://w3id.org/icareonto/ExerciseActivityType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ExerciseActivityTypeScheme"/>
    <skos:definition xml:lang="en">An exercise-activity type involving a rowing movement performed with a resistance band.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Resistance band row</rdfs:label>
    <skos:prefLabel xml:lang="en">Resistance band row</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ExerciseActivityTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/intervalEndsAt">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Timepoint"/>
    <rdfs:label xml:lang="en">interval ends at</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/TimeInterval"/>
    <skos:definition xml:lang="en">Relates a temporal interval to its ending timepoint.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MeasurementInstruction">
    <rdfs:label xml:lang="en">Measurement Instruction</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <skos:definition xml:lang="en">An instruction associated with a protocol, activity, or user-facing task.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch">
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
    <rdfs:label xml:lang="en">has exact match</rdfs:label>
    <rdfs:comment xml:lang="en">skos:exactMatch is disjoint with each of the properties skos:broadMatch and skos:relatedMatch.</rdfs:comment>
    <skos:definition xml:lang="en">skos:exactMatch is used to link two concepts, indicating a high degree of confidence that the concepts can be used interchangeably across a wide range of information retrieval applications. skos:exactMatch is a transitive property, and is a sub-property of skos:closeMatch.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/HealthEducationCapability">
    <skos:prefLabel xml:lang="en">Health education capability</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/AgentCapability"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/AgentCapabilityScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <skos:definition xml:lang="en">An agent capability to provide health education.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Health education capability</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/AgentCapabilityScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/clinicalRecordRecordedAt">
    <skos:definition xml:lang="en">Relates Clinical Record to Timepoint.</skos:definition>
    <rdfs:label xml:lang="en">recorded at</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Timepoint"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ClinicalRecord"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/EscalationActivity">
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/CarePlanActivity"/>
    <skos:definition xml:lang="en">A care-plan activity that routes a concern for clinical review, urgent follow-up, or safety oversight.</skos:definition>
    <rdfs:label xml:lang="en">Escalation Activity</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/behaviourMetricNumericValue">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/BehaviourMetric"/>
    <rdfs:label xml:lang="en">behaviour metric numeric value</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Records the numeric metric value.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/EmergencyEscalationRule">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <rdfs:label xml:lang="en">Emergency escalation rule</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Emergency escalation rule</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SafetyRuleTypeScheme"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/SafetyRuleType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A safety-rule type requiring escalation when information indicates a possible emergency or urgent safety concern.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SafetyRuleTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SleepQuality">
    <rdfs:label xml:lang="en">Sleep quality</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/BehaviourMetricType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/BehaviourMetricTypeScheme"/>
