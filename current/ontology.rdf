    <rdfs:range rdf:resource="https://w3id.org/icareonto/TimeInterval"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ActivityExecution"/>
    <skos:definition xml:lang="en">Relates an activity execution to the interval during which it occurred.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/activityContributesToGoal">
