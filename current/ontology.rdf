    <skos:prefLabel xml:lang="en">TNM staging system</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/CancerStagingSystemScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ActivityTypeSlot">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SlotTypeScheme"/>
    <rdfs:label xml:lang="en">Activity type slot</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/SlotType"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <skos:definition xml:lang="en">A dialogue-slot type used to capture activity type.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SlotTypeScheme"/>
    <skos:prefLabel xml:lang="en">Activity type slot</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/conditionRecordValidDuring">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ClinicalConditionRecord"/>
    <skos:definition xml:lang="en">Relates a condition record to the interval during which the condition status applies.</skos:definition>
    <rdfs:label xml:lang="en">record valid during</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/TimeInterval"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ConfirmInformation">
    <rdfs:label xml:lang="en">Confirm information</rdfs:label>
    <skos:definition xml:lang="en">A user-intent concept indicating that the user intends to confirm information.</skos:definition>
    <skos:prefLabel xml:lang="en">Confirm information</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/UserIntentScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/UserIntent"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/UserIntentScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/modelOutputValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">model output value</rdfs:label>
    <skos:definition xml:lang="en">Records a raw or textual model output value.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ModelOutput"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/carePlanIncludesActivity">
