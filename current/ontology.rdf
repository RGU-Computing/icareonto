    <skos:definition xml:lang="en">Relates a care-plan activity to its result or outcome.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CarePlanActivity"/>
    <rdfs:label xml:lang="en">activity has outcome</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
