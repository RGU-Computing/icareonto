    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/CarePlanActivity"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:label xml:lang="en">Clinical Assessment Activity</rdfs:label>
    <skos:definition xml:lang="en">A care-plan activity involving clinical review, examination, assessment, or interpretation of health status.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CancerTreatmentTypeScheme">
