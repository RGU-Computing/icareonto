    <rdfs:label xml:lang="en">assigned to study arm</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/StudyArm"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
