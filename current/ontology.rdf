    <skos:prefLabel xml:lang="en">Targeted therapy treatment</skos:prefLabel>
    <skos:definition xml:lang="en">A cancer-treatment type directed at specific molecular targets involved in cancer growth or survival.</skos:definition>
    <rdfs:label xml:lang="en">Targeted therapy treatment</rdfs:label>
  </rdf:Description>
