    <skos:definition xml:lang="en">Ongoing care and support after primary cancer treatment, including monitoring, health management, psychosocial wellbeing and adjustment to everyday life.</skos:definition>
    <rdfs:label xml:lang="en">Follow-up care</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ResourceTopicScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ResourceTopicScheme"/>
  </rdf:Description>
