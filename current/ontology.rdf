    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerDiagnosis"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Medication">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:definition xml:lang="en">A medicinal product, drug, or therapeutic substance used for treatment, prevention, symptom control, or risk-factor management.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Medication</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/carePlanHasStatus">
