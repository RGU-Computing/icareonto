    <rdf:type rdf:resource="https://w3id.org/icareonto/ClinicalSeverityLevel"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Moderate severity</rdfs:label>
    <skos:definition xml:lang="en">A clinical-severity level indicating moderate clinical severity.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ClinicalSeverityLevelScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ClinicalSeverityLevelScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:prefLabel xml:lang="en">Moderate severity</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/carePlanName">
    <skos:definition xml:lang="en">Records a name or title for the care plan.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:label xml:lang="en">care plan name</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CarePlan"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/HealthLiteracyIntervention">
    <skos:definition xml:lang="en">An intervention intended to improve a person's understanding, confidence, or ability to act on health information.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/Intervention"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:label xml:lang="en">Health Literacy Intervention</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/cancerStageHasSource">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerStage"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/DataSource"/>
    <skos:definition xml:lang="en">Identifies the record, report or other information source supporting the cancer-stage assessment.</skos:definition>
    <rdfs:label xml:lang="en">stage has source</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/HighCertaintyEvidence">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/EvidenceGradeScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EvidenceGrade"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">High certainty evidence</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/EvidenceGradeScheme"/>
    <skos:definition xml:lang="en">An evidence grade indicating high certainty in the relevant body of evidence under the stated grading approach.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <skos:prefLabel xml:lang="en">High certainty evidence</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/plannedSessionScheduledAt">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Timepoint"/>
    <skos:definition xml:lang="en">Gives an individual planned session a specific scheduled time.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PlannedExerciseSession"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:label xml:lang="en">scheduled at</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/DraftCarePlan">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Draft care plan</rdfs:label>
    <skos:definition xml:lang="en">A care-plan status indicating that the care plan is in the draft state.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/CarePlanStatusScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CarePlanStatusScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/CarePlanStatus"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:prefLabel xml:lang="en">Draft care plan</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#broaderTransitive">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#semanticRelation"/>
    <skos:scopeNote xml:lang="en">By convention, skos:broaderTransitive is not used to make assertions. Rather, the properties can be used to draw inferences about the transitive closure of the hierarchical relation, which is useful e.g. when implementing a simple query expansion algorithm in a search application.</skos:scopeNote>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <skos:definition>skos:broaderTransitive is a transitive superproperty of skos:broader.</skos:definition>
    <owl:inverseOf rdf:resource="http://www.w3.org/2004/02/skos/core#narrowerTransitive"/>
    <rdfs:label xml:lang="en">has broader transitive</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RequestPlanChange">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <skos:prefLabel xml:lang="en">Request plan change</skos:prefLabel>
    <skos:definition xml:lang="en">A user-intent concept indicating that the user intends to request plan change.</skos:definition>
    <rdfs:label xml:lang="en">Request plan change</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/UserIntentScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/UserIntent"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/UserIntentScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/DigitalLiteracy">
    <rdfs:label xml:lang="en">Digital Literacy</rdfs:label>
    <skos:definition xml:lang="en">A person's ability and confidence to access, understand, evaluate, and use digital technologies and digital information.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/SocialContextFactor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/recommendationDerivationUsesRiskProfile">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RecommendationDerivation"/>
    <rdfs:label xml:lang="en">uses risk profile</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/RiskProfile"/>
    <skos:definition xml:lang="en">Relates Recommendation Derivation to Risk Profile.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Schedule">
