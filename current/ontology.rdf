    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <skos:definition xml:lang="en">An evidence grade indicating moderate certainty in the relevant body of evidence under the stated grading approach.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/EvidenceGradeScheme"/>
    <skos:prefLabel xml:lang="en">Moderate certainty evidence</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/EvidenceGradeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/activityExecutionOccursDuring">
