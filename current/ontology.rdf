    <rdfs:range rdf:resource="https://w3id.org/icareonto/Timepoint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RiskProfile"/>
    <skos:definition xml:lang="en">Relates Risk Profile to Timepoint.</skos:definition>
    <rdfs:label xml:lang="en">assessed at</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/InProgressGoalAchievementStatus">
