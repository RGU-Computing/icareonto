    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/hasFinancialConstraintStatus">
    <rdfs:label xml:lang="en">has financial constraint status</rdfs:label>
    <skos:definition xml:lang="en">Whether financial constraints are absent, present, severe, or unknown.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/FinancialConstraint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/FinancialConstraintStatusValue"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/radiotherapyExposureHasBodySite">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RadiotherapyExposure"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:label xml:lang="en">has exposure to site</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/RadiotherapyBodySite"/>
    <skos:definition xml:lang="en">Relates radiotherapy exposure to the treated anatomical site or field.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/LanguagePreference">
    <rdfs:label xml:lang="en">Language Preference</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/PersonPreference"/>
    <skos:definition xml:lang="en">A preference specifying the language in which a person prefers to receive communication, education, dialogue, or service content.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/sessionNotes">
    <rdfs:label xml:lang="en">session notes</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Free-text report about the performed session.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PerformedExerciseSession"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/StudyArmType">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Study Arm Type</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A controlled concept classifying the role of a participant group within a study design, such as intervention or control.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ResourceTopic">
    <skos:definition xml:lang="en">Subject focus used for identification or retrieval of a resource.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Resource Topic</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/treatmentRecordHasRegimen">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <skos:definition xml:lang="en">Relates a treatment record to the regimen or protocol used.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerTreatmentRecord"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/TreatmentRegimen"/>
    <rdfs:label xml:lang="en">has treatment regimen</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MeasurementContext">
    <rdfs:label xml:lang="en">Measurement Context</rdfs:label>
    <skos:definition xml:lang="en">Circumstantial information relevant to understanding or interpreting a measurement event, including its setting, trigger or monitoring situation.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/activityExecutionOccursAt">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">activity execution occurs at</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Timepoint"/>
    <skos:definition xml:lang="en">Relates an activity execution to the timepoint at which it occurred.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ActivityExecution"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/clinicalInterpretationText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Records the textual interpretation.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">interpretation text</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ClinicalInterpretation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/modelVersion">
    <rdfs:label xml:lang="en">model version</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PredictionModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <skos:definition xml:lang="en">Records the model version for Prediction Model.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/InformationPreference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Information Preference</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <skos:definition xml:lang="en">A preference describing how a person wants information to be presented, such as detail level, format, or tone.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/CommunicationPreference"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/exerciseActivityHasIntensity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Associates an activity with prescribed or reported intensity.</skos:definition>
    <rdfs:label xml:lang="en">has intensity</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ExerciseIntensity"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseActivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/GoalSlot">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SlotTypeScheme"/>
    <skos:prefLabel xml:lang="en">Goal slot</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/SlotType"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <rdfs:label xml:lang="en">Goal slot</rdfs:label>
    <skos:definition xml:lang="en">A dialogue-slot type used to capture goal.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SlotTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PressUp">
    <rdfs:label xml:lang="en">Press-up</rdfs:label>
    <skos:prefLabel xml:lang="en">Press-up</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ExerciseActivityType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ExerciseActivityTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <skos:definition xml:lang="en">An exercise-activity type involving performance of a press-up movement.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ExerciseActivityTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/behaviourHasChangeStage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <rdfs:label xml:lang="en">has change stage</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/BehaviourChangeStage"/>
    <skos:definition xml:lang="en">Relates a behaviour record to a readiness or behaviour-change stage.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/BehaviourRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CancerStagingSystem">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <skos:definition xml:lang="en">A controlled concept identifying the classification system used to express a cancer-stage assessment.</skos:definition>
    <rdfs:label xml:lang="en">Cancer Staging System</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PlannedExerciseSession">
    <rdfs:label xml:lang="en">Planned Exercise Session</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A scheduled occurrence of exercise that follows a particular prescription. It represents intention, not actual performance.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/goalDescriptionText">
    <skos:definition xml:lang="en">Records the goal description text for Goal.</skos:definition>
    <rdfs:label xml:lang="en">goal description text</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Goal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/HealthcareNavigationSupportNeed">
    <skos:definition xml:lang="en">An identified need for support finding, accessing or navigating appropriate healthcare services.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyNeedType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/HealthLiteracyNeedTypeScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/HealthLiteracyNeedTypeScheme"/>
    <skos:prefLabel xml:lang="en">Healthcare navigation support need</skos:prefLabel>
    <rdfs:label xml:lang="en">Healthcare navigation support need</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/healthLiteracyInterventionUsesResource">
    <skos:definition xml:lang="en">Identifies an approved health-literacy resource delivered or used as part of the intervention.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/HealthLiteracyResource"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/HealthLiteracyIntervention"/>
    <rdfs:label xml:lang="en">uses resource</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AYASurvivorAudience">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ResourceAudienceType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:definition xml:lang="en">A resource-audience type representing adolescent and young adult cancer survivors.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ResourceAudienceTypeScheme"/>
    <skos:prefLabel xml:lang="en">AYA survivor audience</skos:prefLabel>
    <rdfs:label xml:lang="en">AYA survivor audience</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ResourceAudienceTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MidInterventionTimepointType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/StudyTimepointType"/>
    <rdfs:label xml:lang="en">Mid intervention timepoint</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/StudyTimepointTypeScheme"/>
    <skos:definition xml:lang="en">A study-timepoint type representing mid intervention.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/StudyTimepointTypeScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Mid intervention timepoint</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PrivacyConcern">
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/AccessOrEngagementBarrier"/>
    <rdfs:label xml:lang="en">Privacy Concern</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:definition xml:lang="en">A concern about observation, recording, sharing, or unintended disclosure of personal or health information, including use of technology in shared spaces.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/TimeInterval">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <skos:definition xml:lang="en">A temporal interval with duration or start and end bounds, used for treatment periods, schedule validity, and risk-profile validity.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/TemporalEntity"/>
    <rdfs:label xml:lang="en">Time Interval</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Facilitator">
    <skos:definition xml:lang="en">A context-influence value indicating that the factor helps access, engagement or participation.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ContextInfluenceValueScheme"/>
    <skos:prefLabel xml:lang="en">Facilitator</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ContextInfluenceValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Facilitator</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ContextInfluenceValueScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ActivityStatus">
    <rdfs:label xml:lang="en">Activity Status</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A controlled concept representing the operational or lifecycle state of a care-plan activity, such as planned, scheduled, in progress, completed, cancelled or missed.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PlannedMedicationStatus">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/MedicationStatusScheme"/>
    <skos:definition xml:lang="en">A medication-status value indicating planned status.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/icareonto/MedicationStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/MedicationStatusScheme"/>
    <skos:prefLabel xml:lang="en">Planned medication status</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdfs:label xml:lang="en">Planned medication status</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/riskInterpretationValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdfs:label xml:lang="en">risk interpretation text</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RiskInterpretation"/>
    <skos:definition xml:lang="en">Records a human-readable interpretation of a risk estimate, explaining what the estimated risk or assigned risk category means within its stated time horizon and assessment context.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/treatmentRecordHasSource">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:label xml:lang="en">has treatment source</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates a treatment record to its data source.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerTreatmentRecord"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/DataSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/performedSessionMonitoredBy">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:label xml:lang="en">monitored by</rdfs:label>
    <skos:definition xml:lang="en">Relates Performed Exercise Session to Device.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PerformedExerciseSession"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Device"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ValidMeasurement">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/MeasurementQuality"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/MeasurementQualityScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <skos:prefLabel xml:lang="en">Valid measurement</skos:prefLabel>
    <rdfs:label xml:lang="en">Valid measurement</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">A measurement-quality value indicating that the measurement meets the applicable validity or quality requirements.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/MeasurementQualityScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AccessOrEngagementBarrier">
    <skos:definition xml:lang="en">A circumstance reported or assessed as impeding access to care, participation, engagement, or sustained use of an intervention.</skos:definition>
    <skos:altLabel xml:lang="en">Barrier to Care</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/SocialContextFactor"/>
    <rdfs:label xml:lang="en">Access or Engagement Barrier</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AYACancerSurvivorRole">
    <rdfs:label xml:lang="en">AYA Cancer Survivor Role</rdfs:label>
    <skos:altLabel xml:lang="en">adolescent and young adult cancer survivor role</skos:altLabel>
    <skos:altLabel xml:lang="en">AYA survivor role</skos:altLabel>
    <skos:definition xml:lang="en">A cancer survivor role held by a person whose cancer diagnosis or treatment occurred during adolescence or young adulthood, typically between 15 and 39 years of age.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/CancerSurvivorRole"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Functional">
    <rdfs:label xml:lang="en">Functional</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/LanguageProficiencyLevelValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/LanguageProficiencyLevelValueScheme"/>
    <skos:prefLabel xml:lang="en">Functional</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/LanguageProficiencyLevelValueScheme"/>
    <skos:definition xml:lang="en">A language-proficiency level indicating sufficient ability to manage common communication in the relevant language.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/measurementEventPartOfPanel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">part of panel</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurementEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/MeasurementPanel"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <skos:definition xml:lang="en">Relates a measurement event to a grouped panel of measurements.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/BriefInformation">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <skos:definition xml:lang="en">An information-detail preference indicating brief information.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/InformationDetailLevelValue"/>
    <rdfs:label xml:lang="en">Brief information</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/InformationDetailLevelValueScheme"/>
