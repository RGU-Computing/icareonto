    <skos:definition xml:lang="en">Relates a person attribute to the source that supplied it.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PersonAttribute"/>
    <rdfs:label xml:lang="en">person attribute has source</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/measurementEventHasContext">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurementEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has context</rdfs:label>
    <skos:definition xml:lang="en">Identifies the circumstances or setting in which a measurement event occurred.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/MeasurementContext"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/LifestyleBehaviour">
    <skos:definition xml:lang="en">A behaviour pattern or activity relevant to health, survivorship, cardiovascular risk, or care-plan adherence.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Lifestyle Behaviour</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ModerateCertaintyEvidence">
    <rdfs:label xml:lang="en">Moderate certainty evidence</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EvidenceGrade"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
