  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/VigorousIntensity">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ExerciseIntensityLevelScheme"/>
    <skos:definition xml:lang="en">An exercise-intensity level representing vigorous physical effort.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ExerciseIntensityLevel"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Vigorous intensity</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ExerciseIntensityLevelScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:label xml:lang="en">Vigorous intensity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/doseUnit">
    <rdfs:label xml:lang="en">dose unit</rdfs:label>
