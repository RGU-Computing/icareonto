    <skos:definition xml:lang="en">A controlled concept classifying a broad type of cancer treatment, such as chemotherapy, radiotherapy, surgery, immunotherapy or targeted therapy.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/TargetedTherapyTreatment">
