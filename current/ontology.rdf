  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AdherenceBehaviour">
    <skos:definition xml:lang="en">A lifestyle behaviour describing whether a person follows planned monitoring, medication, intervention, or care-plan activities.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/LifestyleBehaviour"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <rdfs:label xml:lang="en">Adherence Behaviour</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Running">
    <skos:prefLabel xml:lang="en">Running</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ExerciseActivityType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ExerciseActivityTypeScheme"/>
    <rdfs:label xml:lang="en">Running</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ExerciseActivityTypeScheme"/>
    <skos:definition xml:lang="en">An exercise-activity type involving running on a suitable surface or route.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/contributionMetricType">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <skos:definition xml:lang="en">Records the type or scale of contribution, such as coefficient, odds ratio, hazard ratio, SHAP value, relative importance, percentage contribution, or points.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RiskFactorContribution"/>
    <rdfs:label xml:lang="en">contribution metric type</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SelfMonitoringSupportCapability">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
