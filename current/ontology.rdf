    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:label xml:lang="en">has treatment setting</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerTreatmentRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/LowRisk">
    <skos:prefLabel xml:lang="en">Low risk</skos:prefLabel>
    <skos:definition xml:lang="en">A risk-category value indicating low risk.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/RiskCategoryValueScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/RiskCategoryValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Low risk</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/RiskCategoryValueScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SelfEmployed">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/EmploymentStatusValueScheme"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EmploymentStatusValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/EmploymentStatusValueScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdfs:label xml:lang="en">Self-employed</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Self-employed</skos:prefLabel>
    <skos:definition xml:lang="en">An employment-status value indicating that the person is self-employed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/TeachBackStrategy">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/DialogueStrategy"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <skos:definition xml:lang="en">A dialogue strategy based on teach-back to support the interaction.</skos:definition>
    <rdfs:label xml:lang="en">Teach-back strategy</rdfs:label>
    <skos:prefLabel xml:lang="en">Teach-back strategy</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/DialogueStrategyScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/DialogueStrategyScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/HistoricalMedicationStatus">
    <rdfs:label xml:lang="en">Historical medication status</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:prefLabel xml:lang="en">Historical medication status</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/MedicationStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/MedicationStatusScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/MedicationStatusScheme"/>
    <skos:definition xml:lang="en">A medication-status value indicating historical status.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/title">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">title</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SystemicTherapyExposure">
    <rdfs:label xml:lang="en">Systemic Therapy Exposure</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/CardiotoxicTreatmentExposure"/>
    <skos:definition xml:lang="en">Exposure to a systemic anti-cancer therapy delivered through the body, including chemotherapy, targeted therapy, immunotherapy, hormonal therapy, or transplant-related conditioning.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/UnknownSeverity">
    <skos:definition xml:lang="en">A clinical-severity level indicating unknown clinical severity.</skos:definition>
    <skos:prefLabel xml:lang="en">Unknown severity</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Unknown severity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ClinicalSeverityLevel"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ClinicalSeverityLevelScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ClinicalSeverityLevelScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/GoalAchievementStatusScheme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/AchievedGoalAchievementStatus"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/NotAchievedGoalAchievementStatus"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/InProgressGoalAchievementStatus"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/NotAttainableGoalAchievementStatus"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ImprovingGoalAchievementStatus"/>
    <rdfs:label xml:lang="en">Goal Achievement Status scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#ConceptScheme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A set of concepts, optionally including statements about semantic relationships between those concepts.</skos:definition>
    <rdfs:label xml:lang="en">Concept Scheme</rdfs:label>
    <owl:disjointWith rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <skos:scopeNote xml:lang="en">A concept scheme may be defined to include concepts from different sources.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PlainLanguage">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Plain language</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/AccessibilityFeatureScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/AccessibilityFeature"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/AccessibilityFeatureScheme"/>
    <rdfs:label xml:lang="en">Plain language</rdfs:label>
    <skos:definition xml:lang="en">An accessibility feature presenting information using clear, direct and readily understandable language.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SmokingBehaviour">
    <rdfs:label xml:lang="en">Smoking Behaviour</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <skos:definition xml:lang="en">A lifestyle behaviour describing current, past, or never smoking status, tobacco exposure, vaping, or cessation behaviour.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/LifestyleBehaviour"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MonthlyRecurrence">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Monthly recurrence</rdfs:label>
    <skos:definition xml:lang="en">A recurrence pattern in which an activity is expected to recur each month.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/RecurrencePatternScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/RecurrencePatternScheme"/>
    <skos:prefLabel xml:lang="en">Monthly recurrence</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/RecurrencePattern"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/timepointDateTime">
    <skos:definition xml:lang="en">Records the concrete date/time represented by a timepoint.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">timepoint datetime</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Timepoint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/HealthHub">
    <rdfs:label xml:lang="en">Health Hub</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">An integrated digital-health platform through which MAYA provides participant-facing services and connects supported devices.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/healthhub-service"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RiskInterpretation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <skos:definition xml:lang="en">A clinical or operational interpretation of a risk estimate, such as low concern, monitor routinely, review soon, or escalate.</skos:definition>
    <rdfs:label xml:lang="en">Risk Interpretation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ClinicalStageType">
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CancerStageTypeScheme"/>
    <rdfs:label xml:lang="en">Clinical stage</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/icareonto/CancerStageType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:prefLabel xml:lang="en">Clinical stage</skos:prefLabel>
    <skos:definition xml:lang="en">A cancer-stage type based on information available before definitive treatment, including clinical examination, imaging or biopsy findings.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/CancerStageTypeScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ClinicalProtocol">
    <skos:definition xml:lang="en">A structured resource specifying how a clinical, monitoring, assessment, or study procedure should be performed.</skos:definition>
    <rdfs:label xml:lang="en">Clinical Protocol</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/KnowledgeResource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/HealthLiteracyServiceType">
    <skos:prefLabel xml:lang="en">Health literacy service</skos:prefLabel>
    <rdfs:label xml:lang="en">Health literacy service</rdfs:label>
    <skos:definition xml:lang="en">A digital-service type providing health literacy.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/DigitalServiceType"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/healthhub-service"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/DigitalServiceTypeScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/DigitalServiceTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/assessmentMethodName">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RiskAssessmentMethod"/>
    <rdfs:label xml:lang="en">assessment method name</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Records the name of the risk assessment method.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/interpretationText">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">interpretation text</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurementInterpretation"/>
    <skos:definition xml:lang="en">Records textual interpretation of a measurement or observation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/dialogueSessionHasParticipant">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <skos:definition xml:lang="en">Identifies the person participating in the dialogue session.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DialogueSession"/>
    <rdfs:label xml:lang="en">has participant</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Person"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/activityInstructionText">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseActivity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Instructions explaining how the activity should be performed.</skos:definition>
    <rdfs:label xml:lang="en">activity instruction text</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PilotStudy">
    <skos:definition xml:lang="en">An operational representation of a pilot or evaluation, including its sites, phases, participant enrolments and study arms.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
    <rdfs:label xml:lang="en">Pilot Study</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Sodium">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/DietaryComponentScheme"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/DietaryComponent"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/DietaryComponentScheme"/>
    <skos:prefLabel xml:lang="en">Sodium</skos:prefLabel>
    <rdfs:label xml:lang="en">Sodium</rdfs:label>
    <skos:definition xml:lang="en">A dietary component representing sodium as a target of nutrition guidance.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/nutrition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/NotApplicable">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ResponseStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Not applicable</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ResponseStatusScheme"/>
    <skos:definition xml:lang="en">A response status indicating that the requested information does not apply in the current context.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ResponseStatusScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:prefLabel xml:lang="en">Not applicable</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SedentaryBehaviour">
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/LifestyleBehaviour"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sedentary Behaviour</rdfs:label>
    <skos:definition xml:lang="en">A lifestyle behaviour describing low-energy sitting, reclining, screen time, or prolonged inactivity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SupportBehaviourChange">
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ResourcePurposeScheme"/>
    <skos:prefLabel xml:lang="en">Support behaviour change</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ResourcePurpose"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Support behaviour change</rdfs:label>
    <skos:definition xml:lang="en">A resource purpose indicating that the resource is intended to support a health-related behaviour change.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ResourcePurposeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SupportAvailabilityValueScheme">
    <rdfs:label xml:lang="en">Support Availability Value scheme</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/NoAvailableSupport"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ConsistentSupport"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/OccasionalSupport"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/scheduleIncludesTimepoint">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Schedule"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <rdfs:label xml:lang="en">schedule includes timepoint</rdfs:label>
    <skos:definition xml:lang="en">Relates a schedule to one of its planned timepoints.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Timepoint"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/preferenceRecordedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Timepoint"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PersonPreference"/>
    <rdfs:label xml:lang="en">preference recorded at</rdfs:label>
    <skos:definition xml:lang="en">Relates a preference to the time it was recorded or updated.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/EvidenceGroundingRule">
    <skos:definition xml:lang="en">A safety-rule type requiring health information or recommendations to be grounded in approved evidence or resources.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/SafetyRuleType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Evidence grounding rule</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SafetyRuleTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <skos:prefLabel xml:lang="en">Evidence grounding rule</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SafetyRuleTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/treatmentRecordIndicatesExposure">
    <skos:definition xml:lang="en">Relates Cancer Treatment Record to Treatment Exposure.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/TreatmentExposure"/>
    <rdfs:label xml:lang="en">record indicates exposure</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerTreatmentRecord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CriticalResult">
    <rdf:type rdf:resource="https://w3id.org/icareonto/ThresholdCategory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ThresholdCategoryScheme"/>
    <skos:prefLabel xml:lang="en">Critical result</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ThresholdCategoryScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <skos:definition xml:lang="en">A threshold category indicating a result that meets a defined critical threshold and may require prompt review.</skos:definition>
    <rdfs:label xml:lang="en">Critical result</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/TrustConcern">
    <skos:definition xml:lang="en">A concern about the credibility, reliability, fairness, or appropriate operation of a healthcare provider or digital health system that may reduce engagement.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Trust Concern</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/AccessOrEngagementBarrier"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ResourceFormat">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">User-facing presentation format, distinct from technical file format.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Resource Format</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/WithdrawnEnrolmentStatus">
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/EnrolmentStatusValueScheme"/>
    <skos:definition xml:lang="en">An enrolment status indicating that the person withdrew or was withdrawn before completing participation.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EnrolmentStatusValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Withdrawn enrolment status</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/EnrolmentStatusValueScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
    <rdfs:label xml:lang="en">Withdrawn enrolment status</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/scheduleValidDuring">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Schedule"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates a schedule to the interval during which it applies.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/TimeInterval"/>
    <rdfs:label xml:lang="en">schedule valid during</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/UserIntent">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A controlled concept representing the communicative goal inferred from a user utterance.</skos:definition>
    <rdfs:label xml:lang="en">User Intent</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CareTeamCommunicationSupportNeed">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyNeedType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/HealthLiteracyNeedTypeScheme"/>
    <rdfs:label xml:lang="en">Care team communication support need</rdfs:label>
    <skos:definition xml:lang="en">An identified need for support communicating questions, concerns or information with healthcare professionals.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/HealthLiteracyNeedTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:prefLabel xml:lang="en">Care team communication support need</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/measurementPanelIncludesParameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates a panel to the parameters it includes.</skos:definition>
    <rdfs:label xml:lang="en">includes parameter</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurementPanel"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/MeasurableParameter"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Cycling">
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ExerciseActivityTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ExerciseActivityType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:prefLabel xml:lang="en">Cycling</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Cycling</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ExerciseActivityTypeScheme"/>
    <skos:definition xml:lang="en">An exercise-activity type involving cycling on a bicycle or stationary cycle.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/NutritionIntervention">
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/Intervention"/>
    <skos:definition xml:lang="en">An intervention involving dietary guidance, nutrition coaching, or behaviour change related to cardiometabolic risk.</skos:definition>
    <rdfs:label xml:lang="en">Nutrition Intervention</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/dialogueSessionHasAgentParticipant">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ConversationAgent"/>
    <skos:definition xml:lang="en">Identifies the conversational agent participating in the session.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DialogueSession"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has agent participant</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ActiveCarePlan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/CarePlanStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/CarePlanStatusScheme"/>
    <rdfs:label xml:lang="en">Active care plan</rdfs:label>
    <skos:definition xml:lang="en">A care-plan status indicating that the care plan is in the active state.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CarePlanStatusScheme"/>
    <skos:prefLabel xml:lang="en">Active care plan</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ThresholdCategory">
    <skos:definition xml:lang="en">A controlled concept classifying an observation result according to its relationship with an applicable threshold or reference range, such as below range, within range, above range or critical.</skos:definition>
    <rdfs:label xml:lang="en">Threshold Category</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/carePlanUpdatedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates a care plan to its most recent update time.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CarePlan"/>
    <rdfs:label xml:lang="en">updated at</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Timepoint"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ActiveEnrolmentStatus">
    <rdf:type rdf:resource="https://w3id.org/icareonto/EnrolmentStatusValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">An enrolment status indicating that the person's participation is currently active.</skos:definition>
    <rdfs:label xml:lang="en">Active enrolment status</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/EnrolmentStatusValueScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
    <skos:prefLabel xml:lang="en">Active enrolment status</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/EnrolmentStatusValueScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AnthropometricParameter">
    <skos:definition xml:lang="en">A body-size or body-composition parameter, such as weight, height, BMI, waist circumference, or body fat percentage.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Anthropometric Parameter</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/PhysiologicalParameter"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MetabolicCondition">
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/ClinicalCondition"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:definition xml:lang="en">A clinical condition involving metabolic risk or dysfunction, such as diabetes, dyslipidaemia, obesity, insulin resistance, or metabolic syndrome.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Metabolic Condition</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ActivityPriorityScheme">
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/EscalationRequiredPriority"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/UrgentPriority"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/RoutinePriority"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ImportantPriority"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Activity Priority scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/agentGovernedBySafetyPolicy">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/SafetyPolicy"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Agent"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <skos:definition xml:lang="en">Identifies a safety policy governing the agent’s behaviour.</skos:definition>
    <rdfs:label xml:lang="en">governed by</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SedentaryDuration">
    <skos:prefLabel xml:lang="en">Sedentary duration</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/BehaviourMetricTypeScheme"/>
    <skos:definition xml:lang="en">A behaviour metric representing time spent in sedentary behaviour during a defined period.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/BehaviourMetricType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Sedentary duration</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/BehaviourMetricTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/roleName">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <rdfs:label xml:lang="en">role name</rdfs:label>
    <skos:definition xml:lang="en">Records a human-readable role name when a role instance needs a label beyond its class.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PersonRole"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Unemployed">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EmploymentStatusValue"/>
    <skos:definition xml:lang="en">An employment-status value indicating that the person is unemployed.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Unemployed</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/EmploymentStatusValueScheme"/>
    <skos:prefLabel xml:lang="en">Unemployed</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/EmploymentStatusValueScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ConversationAgent">
    <skos:altLabel xml:lang="en">virtual assistant</skos:altLabel>
    <skos:altLabel xml:lang="en">AI-powered conversational agent</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Conversation Agent</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/DigitalAgent"/>
    <skos:definition xml:lang="en">A digital agent that provides non-diagnostic education, coaching, self-monitoring support, resource navigation and appropriate escalation under defined safety policies and human oversight.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/DigitalServiceTypeScheme">
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/VideoConsultationServiceType"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/DialogueServiceType"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/HealthLiteracyServiceType"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/NutritionCoachingServiceType"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ExerciseGuidanceServiceType"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/RemoteMonitoringServiceType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Digital Service Type scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/agentResponseGroundedInResource">
    <skos:definition xml:lang="en">Identifies a knowledge resource used to ground the response.</skos:definition>
    <rdfs:label xml:lang="en">grounded in resource</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/KnowledgeResource"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/AgentResponse"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/modelExecutionGeneratesRiskProfile">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/RiskProfile"/>
    <skos:definition xml:lang="en">Relates Model Execution to Risk Profile.</skos:definition>
    <rdfs:label xml:lang="en">generates</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ModelExecution"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/personAttributeName">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PersonAttribute"/>
    <skos:definition xml:lang="en">Records the name or category of a person attribute.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">person attribute name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/knowledgeResourceHasComplexityLevel">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/KnowledgeResource"/>
    <skos:definition xml:lang="en">Identifies the intended content-complexity level.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has complexity level</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ContentComplexityLevel"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/activityHasStatus">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CarePlanActivity"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:definition xml:lang="en">Relates Care Plan Activity to Activity Status.</skos:definition>
    <rdfs:label xml:lang="en">has status</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ActivityStatus"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/observationTextValue">
    <rdfs:label xml:lang="en">observation text value</rdfs:label>
    <skos:definition xml:lang="en">Records the observation text value for Observation Result.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ObservationResult"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/DigitalHealthPrivacyAndTrust">
    <skos:prefLabel xml:lang="en">Digital health, privacy and trust</skos:prefLabel>
    <skos:definition xml:lang="en">Use of digital health technologies, privacy and personal-data use, and the credibility, transparency and reliability of digital health information and services.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ResourceTopicScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ResourceTopic"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Digital health, privacy and trust</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ResourceTopicScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ActiveGoalLifecycleStatus">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/GoalLifecycleStatusScheme"/>
    <skos:prefLabel xml:lang="en">Active goal lifecycle status</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/GoalLifecycleStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/GoalLifecycleStatusScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">A goal-lifecycle status indicating active.</skos:definition>
    <rdfs:label xml:lang="en">Active goal lifecycle status</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/FormerSmoker">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SmokingStatusValueScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SmokingStatusValueScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/SmokingStatusValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A smoking-status value indicating previous smoking but no current smoking.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Former smoker</skos:prefLabel>
    <rdfs:label xml:lang="en">Former smoker</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PilotPhaseType">
    <skos:definition xml:lang="en">A controlled concept classifying the purpose or stage of a phase within a pilot study, such as needs assessment, feasibility or evaluation.</skos:definition>
    <rdfs:label xml:lang="en">Pilot Phase Type</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MeasurementBasedTrigger">
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/CarePlanTrigger"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A trigger based on a measurement, observation result, threshold, or monitoring change.</skos:definition>
    <rdfs:label xml:lang="en">Measurement Based Trigger</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/EnrolmentStatusValue">
    <skos:definition xml:lang="en">A controlled concept representing the current participation status of a person’s enrolment in a pilot study, such as enrolled, active, completed or withdrawn.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
    <rdfs:label xml:lang="en">Enrolment Status Value</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/agentResponseUsesContext">
    <skos:definition xml:lang="en">Identifies the context used to generate a response.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/AgentResponse"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">uses context</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/DialogueContext"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/HighLiteracy">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/LiteracyLevelValueScheme"/>
    <skos:definition xml:lang="en">A summary literacy level indicating strong capability and confidence in accessing, understanding, appraising and using relevant information.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/LiteracyLevelValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/LiteracyLevelValueScheme"/>
    <skos:prefLabel xml:lang="en">High literacy</skos:prefLabel>
    <rdfs:label xml:lang="en">High literacy</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/serviceUseEventHasUser">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/healthhub-service"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Identifies the person who used the service.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Person"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ServiceUseEvent"/>
    <rdfs:label xml:lang="en">has user</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#broader">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <skos:definition xml:lang="en">Relates a concept to a concept that is more general in meaning.</skos:definition>
    <rdfs:label xml:lang="en">has broader</rdfs:label>
    <rdfs:comment xml:lang="en">Broader concepts are typically rendered as parents in a concept hierarchy (tree).</rdfs:comment>
    <skos:scopeNote xml:lang="en">By convention, skos:broader is only used to assert an immediate (i.e. direct) hierarchical link between two conceptual resources.</skos:scopeNote>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#broaderTransitive"/>
    <owl:inverseOf rdf:resource="http://www.w3.org/2004/02/skos/core#narrower"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Student">
    <skos:prefLabel xml:lang="en">Student</skos:prefLabel>
    <skos:definition xml:lang="en">An employment-status value indicating that the person is a student.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EmploymentStatusValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Student</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/EmploymentStatusValueScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/EmploymentStatusValueScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/DailyRecurrence">
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/RecurrencePatternScheme"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/RecurrencePattern"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <rdfs:label xml:lang="en">Daily recurrence</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/RecurrencePatternScheme"/>
    <skos:definition xml:lang="en">A recurrence pattern in which an activity is expected to recur each day.</skos:definition>
    <skos:prefLabel xml:lang="en">Daily recurrence</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SymptomTriggeredContext">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Symptom Triggered Context</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/MeasurementContext"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <skos:definition xml:lang="en">A measurement context in which a measurement is initiated in response to a reported, observed or detected symptom.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ClinicianRole">
    <rdfs:label xml:lang="en">Clinician Role</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <skos:definition xml:lang="en">A care delivery role held by a healthcare professional involved in assessment, follow-up, treatment, monitoring, counselling, or clinical oversight.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/PersonRole"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Specimen">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">Specimen</rdfs:label>
    <skos:definition xml:lang="en">A biological specimen used in a laboratory measurement, such as blood, serum, plasma, urine, or saliva.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/activityTypeHasModality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ExerciseModality"/>
    <rdfs:label xml:lang="en">has modality</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <skos:definition xml:lang="en">Relates Exercise Activity Type to Exercise Modality.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseActivityType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/HealthLiteracyResource">
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/KnowledgeResource"/>
    <skos:definition xml:lang="en">A resource specifically designed to address one or more health-literacy dimensions or needs.</skos:definition>
    <rdfs:label xml:lang="en">Health Literacy Resource</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AdherencePercentage">
    <rdfs:label xml:lang="en">Adherence percentage</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/BehaviourMetricType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Adherence percentage</skos:prefLabel>
    <skos:definition xml:lang="en">A behaviour metric representing adherence as a percentage of expected or prescribed activity.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/BehaviourMetricTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/BehaviourMetricTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/InformationApplicationSupportNeed">
    <skos:definition xml:lang="en">An identified need for support applying health information to decisions, actions or self-management.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdfs:label xml:lang="en">Information application support need</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyNeedType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/HealthLiteracyNeedTypeScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/HealthLiteracyNeedTypeScheme"/>
    <skos:prefLabel xml:lang="en">Information application support need</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SymptomSeveritySlot">
    <skos:definition xml:lang="en">A dialogue-slot type used to capture symptom severity.</skos:definition>
    <rdfs:label xml:lang="en">Symptom severity slot</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/SlotType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SlotTypeScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <skos:prefLabel xml:lang="en">Symptom severity slot</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SlotTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CancerTreatmentSetting">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A controlled concept representing the timing or strategic relationship of a cancer treatment to other treatments.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cancer Treatment Setting</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PalliativeTreatmentIntent">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/CancerTreatmentIntentScheme"/>
    <skos:prefLabel xml:lang="en">Palliative treatment intent</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/CancerTreatmentIntent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CancerTreatmentIntentScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:label xml:lang="en">Palliative treatment intent</rdfs:label>
    <skos:definition xml:lang="en">A cancer-treatment intent focused on relieving symptoms, slowing disease or improving quality of life rather than achieving cure.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AchievedGoalAchievementStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/GoalAchievementStatus"/>
    <rdfs:label xml:lang="en">Achieved goal achievement status</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/GoalAchievementStatusScheme"/>
    <skos:definition xml:lang="en">A goal-achievement status indicating achieved.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/GoalAchievementStatusScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:prefLabel xml:lang="en">Achieved goal achievement status</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/TelephoneChannel">
    <rdfs:label xml:lang="en">Telephone channel</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/CommunicationChannelTypeScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/CommunicationChannelType"/>
    <skos:definition xml:lang="en">A communication-channel type delivered through a telephone call.</skos:definition>
    <skos:prefLabel xml:lang="en">Telephone channel</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CommunicationChannelTypeScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/StudyTimepoint">
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/Timepoint"/>
