  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ExerciseGuidanceServiceType">
    <rdfs:label xml:lang="en">Exercise guidance service</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/DigitalServiceType"/>
