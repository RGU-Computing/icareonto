    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/FIGOStagingSystem"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MedicationStatus">
    <rdfs:label xml:lang="en">Medication Status</rdfs:label>
    <skos:definition xml:lang="en">A controlled concept representing the current state of a medication prescription or use, such as planned, active, paused, stopped or completed.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/observationHasQuantityValue">
    <rdfs:label xml:lang="en">has quantity value</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/QuantityValue"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ObservationResult"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates Observation Result to Quantity Value.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/LiteracyLevelValue">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:definition xml:lang="en">Permitted summary levels for digital or health literacy</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Literacy Level Value</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/scheduleHasFrequency">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Schedule"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Frequency"/>
    <rdfs:label xml:lang="en">schedule has frequency</rdfs:label>
    <skos:definition xml:lang="en">Relates Schedule to Frequency.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/riskEstimateEstimatesEventRisk">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RiskEstimate"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/AdverseCardiacEvent"/>
    <rdfs:label xml:lang="en">estimates event risk</rdfs:label>
    <skos:definition xml:lang="en">Relates Risk Estimate to Adverse Cardiac Event.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ActiveClinicalStatus">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ClinicalStatus"/>
    <rdfs:label xml:lang="en">Active clinical status</rdfs:label>
    <skos:prefLabel xml:lang="en">Active clinical status</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ClinicalStatusScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ClinicalStatusScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">A clinical-status value indicating active status.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AgentCapabilityScheme">
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ConversationalInteractionCapability"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ResourceRecommendationCapability"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/CarePlanSupportCapability"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/SelfMonitoringSupportCapability"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/SafetyEscalationCapability"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/HealthLiteracySupportCapability"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/LifestyleCoachingCapability"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/HealthEducationCapability"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ClarificationCapability"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Agent Capability scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/participantKnowledgeGraphAboutPerson">
    <skos:definition xml:lang="en">Identifies the person whose information is represented in the graph.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ParticipantKnowledgeGraph"/>
    <rdfs:label xml:lang="en">about</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/provenance-governance"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Person"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SocialContextProfile">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A person-specific collection of social context records used to support context-aware dialogue and adaptation of care activities.</skos:definition>
    <rdfs:label xml:lang="en">Social Context Profile</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/dialogueContextIncludesEntity">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DialogueContext"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">includes entity</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <skos:definition xml:lang="en">Links the dialogue context to any relevant domain entity.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/VeryLowCertaintyEvidence">
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/EvidenceGradeScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Very low certainty evidence</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/icareonto/EvidenceGrade"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Very low certainty evidence</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/EvidenceGradeScheme"/>
    <skos:definition xml:lang="en">An evidence grade indicating very low certainty in the relevant body of evidence under the stated grading approach.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ReferralActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/CarePlanActivity"/>
    <rdfs:label xml:lang="en">Referral Activity</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:definition xml:lang="en">A care-plan activity involving referral to another clinician, service, programme, or specialist.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PhysicalPerformanceProtocol">
    <skos:definition xml:lang="en">A protocol specifying how an activity, measurement, assessment, or clinical process should be performed.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/MeasurementProtocol"/>
    <rdfs:label xml:lang="en">Physical Performance Protocol</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/exerciseActivityHasActivityType">
    <rdfs:label xml:lang="en">has activity type</rdfs:label>
    <skos:definition xml:lang="en">Classifies the activity as walking, cycling, squat, etc.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseActivity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ExerciseActivityType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ClinicalRecordDataSource">
    <rdfs:label xml:lang="en">Clinical Record Data Source</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A data source in which information was obtained from a clinical record or electronic health record.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/DataSource"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/stageValueHasComponentType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Identifies whether the value represents the overall stage group or a T, N or M component.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/CancerStageComponentType"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerStageValue"/>
    <rdfs:label xml:lang="en">has stage value component</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ChemotherapyExposure">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:label xml:lang="en">Chemotherapy Exposure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/SystemicTherapyExposure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">Exposure to cytotoxic chemotherapy as part of cancer treatment, including drug class, cumulative dose, regimen, and treatment period where available.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/FollowUpActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A planned activity that continues review, monitoring, communication, or care after a prior assessment, event, or intervention.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/CarePlanActivity"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:label xml:lang="en">Follow Up Activity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/VitalSign">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">Vital Sign</rdfs:label>
    <skos:definition xml:lang="en">A routinely monitored physiological parameter such as blood pressure, heart rate, respiratory rate, oxygen saturation, or temperature.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/MeasurableParameter"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/dialogueSlotExtractedFrom">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DialogueSlot"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/UserUtterance"/>
    <skos:definition xml:lang="en">Identifies the utterance from which the slot value was extracted.</skos:definition>
    <rdfs:label xml:lang="en">extracted from</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/symptomCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Symptom"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">symptom code</rdfs:label>
    <skos:definition xml:lang="en">Records a code identifying the symptom within the specified code system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SubstanceUseBehaviour">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <rdfs:label xml:lang="en">Substance Use Behaviour</rdfs:label>
    <skos:definition xml:lang="en">A behaviour describing non-tobacco substance use where relevant to clinical or psychosocial monitoring.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/LifestyleBehaviour"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/DiagnosticBoundaryRule">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SafetyRuleTypeScheme"/>
    <skos:definition xml:lang="en">A safety-rule type that prevents the agent from presenting an unsupported diagnosis or acting outside its diagnostic authority.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/SafetyRuleType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SafetyRuleTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <rdfs:label xml:lang="en">Diagnostic boundary rule</rdfs:label>
    <skos:prefLabel xml:lang="en">Diagnostic boundary rule</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/NonModifiableRiskFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Non Modifiable Risk Factor</rdfs:label>
    <skos:definition xml:lang="en">A risk factor that cannot usually be changed through behaviour or intervention, such as age, prior treatment exposure, diagnosis history, or inherited predisposition.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/RiskFactor"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ExerciseModality">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:label xml:lang="en">Exercise Modality</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A controlled concept representing the broad physiological or training mode of an exercise activity, such as aerobic, resistance, flexibility or balance exercise.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nc650cd5e198a4bada7e9648b2e1bcb1db1">
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
    <owl:annotatedSource rdf:resource="https://w3id.org/icareonto/ParticipantKnowledgeGraph"/>
    <ns1:reviewStatus>Approved</ns1:reviewStatus>
    <owl:annotatedTarget rdf:resource="http://www.w3.org/ns/prov#Collection"/>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/prov-o/"/>
    <rdfs:comment xml:lang="en">A participant KG is a collection of provenance-bearing entities.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/HumanOversightRule">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Human oversight rule</rdfs:label>
    <skos:definition xml:lang="en">A safety-rule type requiring specified decisions or outputs to be reviewed or handled by an authorised person.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/SafetyRuleType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Human oversight rule</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SafetyRuleTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SafetyRuleTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/intervalDuration">
    <ns1:valueFormat>iso-duration</ns1:valueFormat>
    <rdfs:label xml:lang="en">interval duration</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <skos:definition xml:lang="en">Records the duration of a temporal interval as an ISO 8601 duration string, for example P7D for seven days or PT30M for thirty minutes.</skos:definition>
    <ns1:valuePattern>^-?P([0-9]+W|([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)(T([0-9]+H([0-9]+M)?([0-9]+(\.[0-9]+)?S)?|[0-9]+M([0-9]+(\.[0-9]+)?S)?|[0-9]+(\.[0-9]+)?S))?|T([0-9]+H([0-9]+M)?([0-9]+(\.[0-9]+)?S)?|[0-9]+M([0-9]+(\.[0-9]+)?S)?|[0-9]+(\.[0-9]+)?S))$</ns1:valuePattern>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/TimeInterval"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/recommendationAppliesToSymptom">
    <skos:definition xml:lang="en">Relates a recommendation to a symptom for which the recommendation is considered applicable, enabling retrieval of symptom-specific guidance. This relation expresses applicability, not diagnosis or causation.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Symptom"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">applies to symptom</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Recommendation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/hasEmploymentStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdfs:label xml:lang="en">has employment status</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/EmploymentStatus"/>
    <skos:definition xml:lang="en">Current employment situation, preferably from a controlled vocabulary.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/EmploymentStatusValue"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ClarificationStrategy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/DialogueStrategy"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Clarification strategy</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/DialogueStrategyScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/DialogueStrategyScheme"/>
    <skos:definition xml:lang="en">A dialogue strategy based on clarification to support the interaction.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Clarification strategy</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SmartMirror">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/healthhub-service"/>
    <rdfs:label xml:lang="en">Smart Mirror</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/Device"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A participant-facing device providing access to MAYA services and its conversational agent through a mirror-based interface.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/activityExecutionHasSource">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/DataSource"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ActivityExecution"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">activity execution has source</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <skos:definition xml:lang="en">Relates an activity execution to the source that recorded, generated, or supplied evidence for it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/EvidenceSource">
    <skos:definition xml:lang="en">A publication, study, review, dataset, or other knowledge resource that reports or synthesises supporting evidence.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/KnowledgeResource"/>
    <rdfs:label xml:lang="en">Evidence Source</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/personHasLifestyleProfile">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Person"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <skos:definition xml:lang="en">Relates Person to Lifestyle Profile.</skos:definition>
    <rdfs:label xml:lang="en">has lifestyle profile</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/LifestyleProfile"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/activityExecutionFollowsSchedule">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Schedule"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates an activity execution to its schedule.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ActivityExecution"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <rdfs:label xml:lang="en">activity execution follows schedule</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/intensityUpperBound">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseIntensity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Upper bound of an intensity range.</skos:definition>
    <rdfs:label xml:lang="en">intensity upper bound</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/modelExecutionUsesInput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ModelExecution"/>
    <skos:definition xml:lang="en">Relates Model Execution to Model Input.</skos:definition>
    <rdfs:label xml:lang="en">uses input</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ModelInput"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ExerciseIntensity">
    <rdfs:label xml:lang="en">Intensity</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A value object representing planned or actual exercise intensity, such as light, moderate, vigorous, RPE, target heart-rate zone, or workload.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ResistanceTraining">
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ExerciseModalityScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Resistance training</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ExerciseModality"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">An exercise modality using resistance to improve muscular strength, endurance or function.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ExerciseModalityScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:label xml:lang="en">Resistance training</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ConversationalInteractionCapability">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Conversational interaction capability</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/icareonto/AgentCapability"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/AgentCapabilityScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/AgentCapabilityScheme"/>
    <skos:prefLabel xml:lang="en">Conversational interaction capability</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <skos:definition xml:lang="en">An agent capability to provide conversational interaction.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/FamilyAudience">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ResourceAudienceType"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ResourceAudienceTypeScheme"/>
    <rdfs:label xml:lang="en">Family audience</rdfs:label>
    <skos:prefLabel xml:lang="en">Family audience</skos:prefLabel>
    <skos:definition xml:lang="en">A resource-audience type representing family members of the person receiving care or support.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ResourceAudienceTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ExerciseAdherenceResult">
    <rdfs:label xml:lang="en">Exercise Adherence Result</rdfs:label>
    <skos:definition xml:lang="en">The result of an exercise adherence assessment, such as adherence percentage, completion status, missed session, partial completion, or exceeded target.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/ObservationResult"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/dialogueContextAddressesIntent">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DialogueContext"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <skos:definition xml:lang="en">Identifies the intent currently being handled.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/UserIntent"/>
    <rdfs:label xml:lang="en">addresses intent</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/cardiotoxicityRiskValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">cardiotoxicity risk value</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CardiotoxicityRisk"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <skos:definition xml:lang="en">Records a qualitative cardiotoxicity risk value, such as low, moderate, high, or unknown.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/BalanceTraining">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ExerciseModality"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">An exercise modality intended to maintain or improve balance and postural control.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ExerciseModalityScheme"/>
    <skos:prefLabel xml:lang="en">Balance training</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ExerciseModalityScheme"/>
    <rdfs:label xml:lang="en">Balance training</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AsNeededRecurrence">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/RecurrencePatternScheme"/>
    <rdfs:label xml:lang="en">As needed recurrence</rdfs:label>
    <skos:definition xml:lang="en">A recurrence pattern in which an activity occurs when needed rather than at fixed recurring intervals.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/icareonto/RecurrencePattern"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/RecurrencePatternScheme"/>
    <skos:prefLabel xml:lang="en">As needed recurrence</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/hasLivingSituationType">
    <rdfs:label xml:lang="en">has living situation type</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/LivingSituation"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/LivingSituationType"/>
    <skos:definition xml:lang="en">Summary such as lives alone, with family, shared accommodation, or temporary housing.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/DietaryPattern">
    <rdfs:label xml:lang="en">Dietary Pattern</rdfs:label>
    <skos:definition xml:lang="en">A nutrition behaviour representing an overall dietary pattern, such as Mediterranean diet, high-salt diet, or low-fibre diet.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/NutritionBehaviour"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CompletedGoalLifecycleStatus">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/GoalLifecycleStatus"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:prefLabel xml:lang="en">Completed goal lifecycle status</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/GoalLifecycleStatusScheme"/>
    <rdfs:label xml:lang="en">Completed goal lifecycle status</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/GoalLifecycleStatusScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">A goal-lifecycle status indicating completed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/conditionRecordResolvedAt">
    <rdfs:label xml:lang="en">record resolved at</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ClinicalConditionRecord"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Timepoint"/>
    <skos:definition xml:lang="en">Relates a condition record to the time the condition resolved, if known.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MeasurementValueSlot">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/SlotType"/>
    <rdfs:label xml:lang="en">Measurement value slot</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SlotTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SlotTypeScheme"/>
    <skos:definition xml:lang="en">A dialogue-slot type used to capture measurement value.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Measurement value slot</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MedicationRecord">
    <rdfs:label xml:lang="en">Medication Record</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:definition xml:lang="en">A clinical record describing a medication a person is taking, has taken, or has been prescribed, including indication, timing, status, and dose where available.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/ClinicalRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/conditionName">
    <skos:definition xml:lang="en">Records the human-readable name of a clinical condition.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ClinicalCondition"/>
    <rdfs:label xml:lang="en">condition name</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/unitCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Unit"/>
    <rdfs:label xml:lang="en">unit code</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <skos:definition xml:lang="en">Records the machine-readable code identifying the unit within a unit code system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/dataSourceDescription">
    <skos:definition xml:lang="en">Records a textual description of the data source and what it contributes.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DataSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">data source description</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MedicationStatusScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ActiveMedicationStatus"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/HistoricalMedicationStatus"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/CompletedMedicationStatus"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/StoppedMedicationStatus"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/PausedMedicationStatus"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/PlannedMedicationStatus"/>
    <rdfs:label xml:lang="en">Medication Status scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/TreatmentAgent">
    <rdfs:label xml:lang="en">Treatment Agent</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A drug, radiation modality, biological agent, or other therapeutic agent used in a cancer treatment.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/dialogueSlotConfidence">
    <skos:definition xml:lang="en">Optional confidence (between 0 and 1) assigned to the extracted or inferred slot value.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DialogueSlot"/>
    <rdfs:label xml:lang="en">dialogue slot confidence</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/UserConfirmed">
    <skos:prefLabel xml:lang="en">User confirmed</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">User confirmed</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/VerificationStatusValue"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/VerificationStatusValueScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/provenance-governance"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/VerificationStatusValueScheme"/>
    <skos:definition xml:lang="en">A verification status indicating that the person to whom the information relates has confirmed it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CardiotoxicTreatmentExposure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A treatment exposure with known or suspected relevance to cardiovascular late effects, such as anthracycline therapy, chest radiotherapy, or other cardiotoxic regimens.</skos:definition>
    <rdfs:label xml:lang="en">Cardiotoxic Treatment Exposure</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/TreatmentExposure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/UserIntentScheme">
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ConfirmInformation"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ReportSymptom"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/RequestExplanation"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ReportActivity"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/RejectInformation"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/RequestPlanChange"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ReportMeasurement"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/RequestInformation"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/RequestRecommendation"/>
    <rdfs:label xml:lang="en">User Intent scheme</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CancerStageComponentTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/StageGroupComponent"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/RegionalNodeCategoryComponent"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/TumourCategoryComponent"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/DistantMetastasisCategoryComponent"/>
    <rdfs:label xml:lang="en">Cancer Stage Component Type scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/rights">
    <rdfs:label xml:lang="en">rights</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/issued">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">issued</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/preferredLanguageTag">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">preferred language tag</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/LanguagePreference"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#language"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <skos:definition xml:lang="en">Records an IETF language tag for the preferred language.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RejectInformation">
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/UserIntentScheme"/>
    <skos:definition xml:lang="en">A user-intent concept indicating that the user intends to reject information.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/UserIntent"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <skos:prefLabel xml:lang="en">Reject information</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/UserIntentScheme"/>
    <rdfs:label xml:lang="en">Reject information</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/StudyArmTypeScheme">
    <rdfs:label xml:lang="en">Study Arm Type scheme</rdfs:label>
