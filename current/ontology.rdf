    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/healthhub-service"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/DigitalServiceTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AdverseCardiacEvent">
    <rdfs:label xml:lang="en">Adverse Cardiac Event</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <skos:definition xml:lang="en">A cardiovascular event of concern for monitoring or prediction, such as heart failure, cardiomyopathy, arrhythmia, myocardial infarction, or hypertension-related complication.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/riskBasedTriggerUsesRiskProfile">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:label xml:lang="en">uses risk profile</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RiskBasedTrigger"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/RiskProfile"/>
    <skos:definition xml:lang="en">Relates a risk-based trigger to the risk profile that caused it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/observationHasThresholdCategory">
    <skos:definition xml:lang="en">Relates an observation result to an interpreted threshold category.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ThresholdCategory"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ObservationResult"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has threshold category</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/conditionCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Records a code identifying the clinical condition within the specified code system.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ClinicalCondition"/>
    <rdfs:label xml:lang="en">condition code</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/LimitedLiteracy">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/LiteracyLevelValueScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/LiteracyLevelValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/LiteracyLevelValueScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">A summary literacy level indicating substantial difficulty accessing, understanding, appraising or using relevant information.</skos:definition>
    <rdfs:label xml:lang="en">Limited literacy</rdfs:label>
    <skos:prefLabel xml:lang="en">Limited literacy</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CarePlanStatusScheme">
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/CancelledCarePlan"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/CompletedCarePlan"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/DraftCarePlan"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ActiveCarePlan"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/PausedCarePlan"/>
    <rdfs:label xml:lang="en">Care Plan Status scheme</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/personHasClinicalProfile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ClinicalProfile"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdfs:label xml:lang="en">has clinical profile</rdfs:label>
    <skos:definition xml:lang="en">Relates Person to Clinical Profile.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Person"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AfternoonTimeOfDay">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/TimeOfDay"/>
    <rdfs:label xml:lang="en">Afternoon time of day</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/TimeOfDayScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Afternoon time of day</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <skos:definition xml:lang="en">A time-of-day value representing the afternoon period.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/TimeOfDayScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/EveningTimeOfDay">
    <rdf:type rdf:resource="https://w3id.org/icareonto/TimeOfDay"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Evening time of day</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/TimeOfDayScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">A time-of-day value representing the evening period.</skos:definition>
    <skos:prefLabel xml:lang="en">Evening time of day</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/TimeOfDayScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/nutritionInstructionHasActionType">
    <rdfs:label xml:lang="en">has action type</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/NutritionInstruction"/>
    <skos:definition xml:lang="en">Identifies the intended change to the targeted dietary component.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/NutritionActionType"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/nutrition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SystemicTreatment">
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CancerTreatmentTypeScheme"/>
    <skos:prefLabel xml:lang="en">Systemic treatment</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:label xml:lang="en">Systemic treatment</rdfs:label>
    <skos:definition xml:lang="en">A cancer-treatment type that acts throughout the body, including chemotherapy, immunotherapy, targeted therapy and relevant stem-cell transplantation.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/CancerTreatmentTypeScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/CancerTreatmentType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ConsentWithdrawn">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ConsentStatusValue"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/provenance-governance"/>
    <skos:prefLabel xml:lang="en">Consent withdrawn</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ConsentStatusValueScheme"/>
    <rdfs:label xml:lang="en">Consent withdrawn</rdfs:label>
    <skos:definition xml:lang="en">A consent status indicating that previously granted consent has been withdrawn.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ConsentStatusValueScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/cancerStageAssessedAt">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Timepoint"/>
    <rdfs:label xml:lang="en">stage assessed at</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerStage"/>
    <skos:definition xml:lang="en">Identifies when the cancer-stage assessment was made.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/assessmentRecordRecordsAssessment">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ClinicalAssessment"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ClinicalAssessmentRecord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">records assessment</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:definition xml:lang="en">Relates Clinical Assessment Record to Clinical Assessment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ConditionalRecommendation">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/RecommendationStrengthScheme"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/RecommendationStrength"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">A recommendation-strength value indicating that the appropriate action may depend on preferences, circumstances or additional judgement.</skos:definition>
    <skos:prefLabel xml:lang="en">Conditional recommendation</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/RecommendationStrengthScheme"/>
    <rdfs:label xml:lang="en">Conditional recommendation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/quantityNumericValue">
    <rdfs:label xml:lang="en">quantity numeric value</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/QuantityValue"/>
    <skos:definition xml:lang="en">Records the quantity numeric value for Quantity Value.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CurrentSmoker">
    <skos:prefLabel xml:lang="en">Current smoker</skos:prefLabel>
    <rdf:type rdf:resource="https://w3id.org/icareonto/SmokingStatusValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Current smoker</rdfs:label>
    <skos:definition xml:lang="en">A smoking-status value indicating current smoking.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SmokingStatusValueScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SmokingStatusValueScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Goal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A desired care, monitoring, behavioural, or clinical outcome that care-plan activities are intended to support.</skos:definition>
    <rdfs:label xml:lang="en">Goal</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/performedSessionIdentifier">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Identifier for a performed session.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">performed session identifier</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PerformedExerciseSession"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/recommendationRecommendsActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Recommendation"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/CarePlanActivity"/>
    <skos:definition xml:lang="en">Relates Recommendation to Care Plan Activity.</skos:definition>
    <rdfs:label xml:lang="en">recommends activity</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Person">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Person</rdfs:label>
    <skos:definition xml:lang="en">A human actor represented in the ontology, such as an AYA cancer survivor, clinician, caregiver, family member, researcher, or study participant.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/StageGroupComponent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/CancerStageComponentType"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/CancerStageComponentTypeScheme"/>
    <skos:prefLabel xml:lang="en">Stage group</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">Indicates that the value represents an overall cancer-stage group, such as stage IIIA.</skos:definition>
    <rdfs:label xml:lang="en">Stage group</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CancerStageComponentTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/treatmentExposureHasPeriod">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/TimeInterval"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has exposure period</rdfs:label>
    <skos:definition xml:lang="en">Relates an exposure to the interval during which the exposure occurred.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/TreatmentExposure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/DigitalService">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A digitally delivered function that supports monitoring, communication, education, coaching or care-plan activities.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/healthhub-service"/>
    <rdfs:label xml:lang="en">Digital Service</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/healthHubIncludesDevice">
    <skos:definition xml:lang="en">Relates a HealthHub deployment to a device that forms part of that deployment.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/healthhub-service"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/HealthHub"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Device"/>
    <rdfs:label xml:lang="en">includes device</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/personHasRole">
    <rdfs:label xml:lang="en">has role</rdfs:label>
    <skos:definition xml:lang="en">Relates Person to Person Role.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Person"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/PersonRole"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/treatmentRecordRecordsTreatmentType">
    <skos:definition xml:lang="en">Relates Cancer Treatment Record to Cancer Treatment Type.</skos:definition>
    <rdfs:label xml:lang="en">records treatment type</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/CancerTreatmentType"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerTreatmentRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#related">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <skos:definition xml:lang="en">Relates a concept to a concept with which there is an associative semantic relationship.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#semanticRelation"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <rdfs:comment xml:lang="en">skos:related is disjoint with skos:broaderTransitive</rdfs:comment>
    <rdfs:label xml:lang="en">has related</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PatientReportedOutcome">
    <skos:definition xml:lang="en">A measurable outcome reported directly by a person, such as symptoms, quality of life, fatigue, distress, function, or wellbeing.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/MeasurableParameter"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Patient Reported Outcome</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/BehaviourRecord">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Behaviour Record</rdfs:label>
    <skos:definition xml:lang="en">A dated record describing a reported, observed, measured, or inferred lifestyle behaviour.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ConsentExpired">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ConsentStatusValueScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ConsentStatusValueScheme"/>
    <skos:prefLabel xml:lang="en">Consent expired</skos:prefLabel>
    <rdfs:label xml:lang="en">Consent expired</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ConsentStatusValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">A consent status indicating that previously granted consent is no longer valid because its validity period ended.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/provenance-governance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PlainLanguageStrategy">
    <rdfs:label xml:lang="en">Plain-language strategy</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/icareonto/DialogueStrategy"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/DialogueStrategyScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <skos:definition xml:lang="en">A dialogue strategy based on plain-language to support the interaction.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/DialogueStrategyScheme"/>
    <skos:prefLabel xml:lang="en">Plain-language strategy</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/contributor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">contributor</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/measurementInstructionText">
    <rdfs:label xml:lang="en">measurement instruction text</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurementInstrument"/>
    <skos:definition xml:lang="en">Records the user-facing text describing an action or step required by a measurement protocol.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ResearcherRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Researcher Role</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/PersonRole"/>
    <skos:definition xml:lang="en">A role held by a person involved in study delivery, analysis, coordination, or research oversight.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/DeviceDataSource">
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/DataSource"/>
    <skos:definition xml:lang="en">A data source in which information was produced, captured or transmitted by a measurement or monitoring device.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">Device Data Source</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CancerTreatmentRecord">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <skos:definition xml:lang="en">A record of cancer treatment received by a person, including its treatment type or regimen and, where known, its therapeutic intent, treatment setting, associated cancer diagnosis, timing and information source.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cancer Treatment Record</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/VerifiedAgainstClinicalRecord">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/VerificationStatusValue"/>
    <skos:definition xml:lang="en">A verification status indicating that the information has been confirmed against a clinical record.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/provenance-governance"/>
    <skos:prefLabel xml:lang="en">Verified against clinical record</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/VerificationStatusValueScheme"/>
    <rdfs:label xml:lang="en">Verified against clinical record</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/VerificationStatusValueScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ExerciseIntensityLevel">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A controlled concept representing a qualitative band of intended or performed exercise effort, such as light, moderate, vigorous or maximal intensity.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Exercise Intensity Level</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/activityDeliveredThroughService">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/healthhub-service"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/DigitalService"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Identifies the digital service intended to deliver or support a care-plan activity.</skos:definition>
    <rdfs:label xml:lang="en">delivered through</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CarePlanActivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/treatmentRecordHasTreatmentPeriod">
    <rdfs:label xml:lang="en">record has treatment period</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/TimeInterval"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerTreatmentRecord"/>
    <skos:definition xml:lang="en">Relates Cancer Treatment Record to Time Interval. A treatment record may cover a broader episode than one exposure.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/exerciseActivityHasTrainingPattern">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseActivity"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ExerciseTrainingPattern"/>
    <skos:definition xml:lang="en">Identifies continuous, interval, HIIT, circuit, or another pattern.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has training pattern</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/treatmentExposureHasAgent">
    <rdfs:label xml:lang="en">has exposure to</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/TreatmentAgent"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/TreatmentExposure"/>
    <skos:definition xml:lang="en">Relates an exposure to the treatment agent involved.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/recommendationHasApplicabilityCriterion">
    <skos:definition xml:lang="en">Relates Recommendation to Applicability Criterion.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has applicability criterion</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ApplicabilityCriterion"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Recommendation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ClinicalInterpretation">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdfs:label xml:lang="en">Clinical Interpretation</rdfs:label>
    <skos:definition xml:lang="en">A clinical interpretation or summary derived from records, observations, assessments, or measurements.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/DialogueContext">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A selected set of intents, slot states, domain records, preferences, recommendations, and resources used to interpret an utterance or generate a response.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <rdfs:label xml:lang="en">Dialogue Context</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/protocolSpecifiesParameter">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurementProtocol"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Identifies the parameter that the protocol is designed to measure.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/MeasurableParameter"/>
    <rdfs:label xml:lang="en">specifies parameter</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ConsentStatusValueScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ConsentExpired"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ConsentGranted"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ConsentPending"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ConsentRefused"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ConsentWithdrawn"/>
    <rdfs:label xml:lang="en">Consent Status Value scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/methodName">
    <skos:definition xml:lang="en">Records the name of a measurement method.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurementMethod"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">measurement method name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/carePlanHasTrigger">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/CarePlanTrigger"/>
    <skos:definition xml:lang="en">Relates a care plan to the trigger or reason that caused it to be created or updated.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CarePlan"/>
    <rdfs:label xml:lang="en">plan has trigger</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/TimeOfDay">
    <skos:definition xml:lang="en">A controlled concept representing a broad period within a day during which an activity, communication or reminder is preferred or scheduled, such as morning, afternoon or evening.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Time Of Day</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#inScheme">
    <skos:definition xml:lang="en">Relates a resource (for example a concept) to a concept scheme in which it is included.</skos:definition>
    <rdfs:label xml:lang="en">is in scheme</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:scopeNote xml:lang="en">A concept may be a member of more than one concept scheme.</skos:scopeNote>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/observationHasInterpretation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates an observation result to its interpretation.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/MeasurementInterpretation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ObservationResult"/>
    <rdfs:label xml:lang="en">has interpretation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/cancerStageHasType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerStage"/>
    <skos:definition xml:lang="en">Identifies whether a cancer-stage assessment is clinical, pathological or another recognised stage type.</skos:definition>
    <rdfs:label xml:lang="en">has stage type</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/CancerStageType"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/measurementPanelDescription">
    <rdfs:label xml:lang="en">measurement panel description</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurementPanel"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Records a textual description of the measurement panel and its intended monitoring use.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/InPersonChannel">
    <rdf:type rdf:resource="https://w3id.org/icareonto/CommunicationChannelType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CommunicationChannelTypeScheme"/>
    <rdfs:label xml:lang="en">In person channel</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">A communication-channel type involving face-to-face interaction.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/CommunicationChannelTypeScheme"/>
    <skos:prefLabel xml:lang="en">In person channel</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#mappingRelation"/>
    <skos:definition xml:lang="en">skos:closeMatch is used to link two concepts that are sufficiently similar that they can be used interchangeably in some information retrieval applications. In order to avoid the possibility of "compound errors" when combining mappings across more than two concept schemes, skos:closeMatch is not declared to be a transitive property.</skos:definition>
    <rdfs:label xml:lang="en">has close match</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/High">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="https://w3id.org/icareonto/SeverityLevel"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SeverityLevelScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SeverityLevelScheme"/>
    <skos:prefLabel xml:lang="en">High</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:definition xml:lang="en">A controlled severity level indicating a high degree of impact or concern.</skos:definition>
    <rdfs:label xml:lang="en">High</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ResourceRecommendationCapability">
    <rdf:type rdf:resource="https://w3id.org/icareonto/AgentCapability"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Resource recommendation capability</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/AgentCapabilityScheme"/>
    <skos:prefLabel xml:lang="en">Resource recommendation capability</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <skos:definition xml:lang="en">An agent capability to provide resource recommendation.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/AgentCapabilityScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/interventionTargetsRiskFactor">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Intervention"/>
    <skos:definition xml:lang="en">Relates Intervention to Modifiable Risk Factor.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/RiskFactor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">targets risk factor</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ClinicalRecord">
    <skos:definition xml:lang="en">A dated clinical statement or record about a person's health status, medication, condition, symptom, assessment, or care-relevant finding.</skos:definition>
    <rdfs:label xml:lang="en">Clinical Record</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ExerciseIntensityLevelScheme">
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ModerateIntensity"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/MaximalIntensity"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/LightIntensity"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/VigorousIntensity"/>
    <rdfs:label xml:lang="en">Exercise Intensity Level scheme</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/TreatmentRegimen">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Treatment Regimen</rdfs:label>
    <skos:definition xml:lang="en">A named treatment regimen or protocol used during a cancer treatment record.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/safetyRuleHasType">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <skos:definition xml:lang="en">Classifies the purpose of a safety rule.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/SafetyRuleType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/SafetyRule"/>
    <rdfs:label xml:lang="en">has type</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/carePlanActivityAdaptedToSocialContext">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CarePlanActivity"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:label xml:lang="en">adapted to</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/SocialContextRecord"/>
    <skos:definition xml:lang="en">Indicates that a care-plan activity was selected or adapted in response to recorded social context.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ReportSymptom">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/UserIntentScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/UserIntent"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/UserIntentScheme"/>
    <skos:definition xml:lang="en">A user-intent concept indicating that the user intends to report symptom.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <rdfs:label xml:lang="en">Report symptom</rdfs:label>
    <skos:prefLabel xml:lang="en">Report symptom</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/FinancialConstraintStatusValueScheme">
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/SomeFinancialConstraint"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/NoFinancialConstraint"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/SevereFinancialConstraint"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Financial Constraint Status Value scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/scoreNumericValue">
    <rdfs:label xml:lang="en">score numeric value</rdfs:label>
    <skos:definition xml:lang="en">Records the score numeric value for Score Value.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ScoreValue"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/measurementEventHasQuality">
    <rdfs:label xml:lang="en">has quality</rdfs:label>
    <skos:definition xml:lang="en">Relates a measurement event to an assessment of measurement quality.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurementEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/MeasurementQuality"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/InformationDetailLevelValue">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <skos:definition xml:lang="en">A controlled concept representing the level of detail a person prefers when receiving health information, such as brief, standard or detailed.</skos:definition>
    <rdfs:label xml:lang="en">Information Detail Level Value</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/medicationCode">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Medication"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdfs:label xml:lang="en">medication code</rdfs:label>
    <skos:definition xml:lang="en">Records a code identifying the medication or medication class within the specified code system.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/cancerTreatmentHistoryHasRecord">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerTreatmentHistory"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <skos:definition xml:lang="en">Relates Cancer Treatment History to Cancer Treatment Record.</skos:definition>
    <rdfs:label xml:lang="en">history treatment record</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/CancerTreatmentRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/LanguageProficiencyLevelValueScheme">
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/Fluent"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/Functional"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/NoProficiency"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/LimitedProficiency"/>
    <rdfs:label xml:lang="en">Language Proficiency Level Value scheme</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/dialogueSlotHasEntityValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has entity value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DialogueSlot"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <skos:definition xml:lang="en">Links a filled slot to a structured ontology entity, such as an exercise activity or observation result.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#Collection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
    <rdfs:label>Collection</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ExercisePrescription">
    <rdfs:label xml:lang="en">Exercise Prescription</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A person-specific information specification defining intended exercise activities and their frequency, intensity, duration, sets, repetitions, load, rest, and progression.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/OccasionalSupport">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/SupportAvailabilityValue"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SupportAvailabilityValueScheme"/>
    <skos:prefLabel xml:lang="en">Occasional support</skos:prefLabel>
    <skos:definition xml:lang="en">A support-availability value indicating that support is available intermittently or only in some situations.</skos:definition>
    <rdfs:label xml:lang="en">Occasional support</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SupportAvailabilityValueScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/conversationAgentOverseenBy">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DigitalAgent"/>
    <rdfs:label xml:lang="en">overseen by</rdfs:label>
    <skos:definition xml:lang="en">Identifies a person responsible for oversight of the digital agent.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Person"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/riskScore">
    <skos:definition xml:lang="en">Records the risk score for Risk Estimate.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">risk score</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RiskEstimate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CancerSurvivorRole">
    <skos:definition xml:lang="en">A role held by a person who has completed, is living after, or is receiving follow-up after a cancer diagnosis or cancer treatment.</skos:definition>
    <rdfs:label xml:lang="en">Cancer Survivor Role</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/PersonRole"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ClinicianAudience">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ResourceAudienceTypeScheme"/>
    <skos:prefLabel xml:lang="en">Clinician audience</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ResourceAudienceTypeScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ResourceAudienceType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Clinician audience</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <skos:definition xml:lang="en">A resource-audience type representing clinicians and other healthcare professionals.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ContinuousTraining">
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ExerciseTrainingPatternScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ExerciseTrainingPattern"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">An exercise-training pattern involving sustained activity without planned recovery intervals.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <skos:prefLabel xml:lang="en">Continuous training</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ExerciseTrainingPatternScheme"/>
    <rdfs:label xml:lang="en">Continuous training</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/TreatmentRelatedCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/ClinicalCondition"/>
    <rdfs:label xml:lang="en">Treatment Related Condition</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:definition xml:lang="en">A condition attributed to, associated with, or monitored because of prior cancer treatment exposure.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/prescriptionIdentifier">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExercisePrescription"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">prescription identifier</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Identifier for the prescription.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CardiacBiomarker">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/Biomarker"/>
    <rdfs:label xml:lang="en">Cardiac Biomarker</rdfs:label>
    <skos:definition xml:lang="en">A biomarker relevant to cardiac function, injury, or cardiovascular risk monitoring.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AgentResponse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/DialogueTurn"/>
    <skos:definition xml:lang="en">A dialogue turn generated by a conversational agent in response to the user or the current dialogue context.</skos:definition>
    <rdfs:label xml:lang="en">Agent Response</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Unit">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">Unit</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A unit of measurement used to qualify a numeric observation value.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/EducationalResource">
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/KnowledgeResource"/>
    <skos:definition xml:lang="en">A resource designed to improve knowledge, understanding, skills, confidence, or self-management.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Educational Resource</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/recommendationDerivationUsesKnowledgeResource">
    <rdfs:label xml:lang="en">uses knowledge resource</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RecommendationDerivation"/>
    <skos:definition xml:lang="en">Relates Recommendation Derivation to Knowledge Resource.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/KnowledgeResource"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ClinicalFindingRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/ClinicalRecord"/>
    <rdfs:label xml:lang="en">Clinical Finding Record</rdfs:label>
    <skos:definition xml:lang="en">A record documenting a clinical finding derived from examination, interpretation, measurements, imaging, or assessment.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/resistanceLoadValue">
    <rdfs:label xml:lang="en">resistance load value</rdfs:label>
    <skos:definition xml:lang="en">Numeric resistance load prescribed or reported.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseSet"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/resistanceLoadUnit">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <skos:definition xml:lang="en">Load unit or basis, such as kg, lb, resistance-band level, or %1RM.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseSet"/>
    <rdfs:label xml:lang="en">resistance load unit</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/studyTimepointHasType">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/StudyTimepointType"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/StudyTimepoint"/>
    <skos:definition xml:lang="en">Classifies a study timepoint as baseline, end of intervention, follow-up, or another controlled study-timepoint type.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">study timepoint has type</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/behaviourRecordRelatesToActivity">
    <rdfs:label xml:lang="en">relates to activity</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/CarePlanActivity"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/BehaviourRecord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <skos:definition xml:lang="en">Relates Behaviour Record to Care Plan Activity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/FilledSlot">
    <skos:definition xml:lang="en">A dialogue-slot status indicating that a value has been supplied for the slot.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/SlotStatusValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SlotStatusValueScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <rdfs:label xml:lang="en">Filled slot</rdfs:label>
    <skos:prefLabel xml:lang="en">Filled slot</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SlotStatusValueScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/treatmentRecordTreatsDiagnosis">
    <rdfs:label xml:lang="en">treats diagnosis</rdfs:label>
    <skos:definition xml:lang="en">Identifies the cancer diagnosis for which the recorded treatment was delivered.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/CancerDiagnosis"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerTreatmentRecord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/barrierDescription">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/LifestyleBarrier"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <skos:definition xml:lang="en">Records a textual description of a lifestyle barrier.</skos:definition>
    <rdfs:label xml:lang="en">barrier description</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/adherenceAssessmentHasResult">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ExerciseAdherenceResult"/>
    <skos:definition xml:lang="en">Relates Exercise Adherence Assessment to Exercise Adherence Result.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has adherence result</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseAdherenceAssessment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/participantEnrolmentAtSite">
    <rdfs:label xml:lang="en">enrolment at site</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/PilotSite"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ParticipantEnrolment"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
    <skos:definition xml:lang="en">Identifies the site responsible for the participant's enrolment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PersonRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <rdfs:label xml:lang="en">Person Role</rdfs:label>
    <skos:definition xml:lang="en">A contextual role held by a person in care delivery, survivorship support, family support, research participation, or study operations.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/cancerType">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:label xml:lang="en">cancer type</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerDiagnosis"/>
    <skos:definition xml:lang="en">Records the type or name of the diagnosed cancer.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ReferenceRange">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A normal, expected, or clinically relevant value range used to interpret an observation result.</skos:definition>
    <rdfs:label xml:lang="en">Reference Range</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/doseFrequency">
    <rdfs:label xml:lang="en">dose frequency</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MedicationDose"/>
    <skos:definition xml:lang="en">Records dosing frequency as text.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SymptomTypeSlot">
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/SlotType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SlotTypeScheme"/>
    <rdfs:label xml:lang="en">Symptom type slot</rdfs:label>
    <skos:prefLabel xml:lang="en">Symptom type slot</skos:prefLabel>
    <skos:definition xml:lang="en">A dialogue-slot type used to capture symptom type.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SlotTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/prescriptionIssuedAt">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExercisePrescription"/>
    <rdfs:label xml:lang="en">prescription issued at</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <skos:definition xml:lang="en">Date and time the prescription was issued.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CombinedTraining">
    <rdf:type rdf:resource="https://w3id.org/icareonto/ExerciseModality"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ExerciseModalityScheme"/>
    <skos:definition xml:lang="en">An exercise modality combining two or more distinct exercise modalities within a programme or session.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:label xml:lang="en">Combined training</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ExerciseModalityScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Combined training</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ImmunotherapyTreatment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/CancerTreatmentType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CancerTreatmentTypeScheme"/>
    <skos:prefLabel xml:lang="en">Immunotherapy treatment</skos:prefLabel>
    <skos:definition xml:lang="en">A cancer-treatment type that modifies or uses immune-system activity to act against cancer.</skos:definition>
    <rdfs:label xml:lang="en">Immunotherapy treatment</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <skos:broader rdf:resource="https://w3id.org/icareonto/SystemicTreatment"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/parameterCode">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurableParameter"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <skos:definition xml:lang="en">Records an optional code for a measurable parameter.</skos:definition>
    <rdfs:label xml:lang="en">parameter code</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RiskFactorContribution">
    <skos:definition xml:lang="en">A representation of how much a specific factor contributes to a risk estimate or risk profile.</skos:definition>
    <rdfs:label xml:lang="en">Risk Factor Contribution</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#editorialNote">
    <skos:definition xml:lang="en">A note for an editor, translator or maintainer of the vocabulary.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <rdfs:label xml:lang="en">editorial note</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#note"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/StudyParticipantRole">
    <skos:definition xml:lang="en">A role held by a person participating in a study or pilot activity.</skos:definition>
    <rdfs:label xml:lang="en">Study Participant Role</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/PersonRole"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/socialContextRecordHasSource">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/SocialContextRecord"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/DataSource"/>
    <skos:definition xml:lang="en">Identifies the source, such as self-report, questionnaire, clinician, caregiver, or clinical record.</skos:definition>
    <rdfs:label xml:lang="en">has source</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/healthLiteracyHasLevel">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/LiteracyLevelValue"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/HealthLiteracy"/>
    <rdfs:label xml:lang="en">has level</rdfs:label>
    <skos:definition xml:lang="en">Summary literacy level, such as limited, adequate, high, or unknown.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/LanguageProficiencyLevelValue">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">Permitted language-proficiency levels</skos:definition>
    <rdfs:label xml:lang="en">Language Proficiency Level Value</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/agentResponseRespondsTo">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/AgentResponse"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">responds to</rdfs:label>
    <skos:definition xml:lang="en">Identifies the utterance to which the response primarily responds.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/UserUtterance"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ExerciseActivityType">
    <rdfs:label xml:lang="en">Exercise Activity Type</rdfs:label>
    <skos:definition xml:lang="en">A controlled concept representing a specific named exercise activity or movement, such as walking, cycling, squatting or resistance-band rowing.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RecurrencePatternScheme">
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/AsNeededRecurrence"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/CustomRecurrence"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/MonthlyRecurrence"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/DailyRecurrence"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/WeeklyRecurrence"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Recurrence Pattern scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RecommendationStrengthScheme">
    <rdfs:label xml:lang="en">Recommendation Strength scheme</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/StrongRecommendation"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ConditionalRecommendation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/measurementEventOccursDuringPerformedSession">
    <skos:definition xml:lang="en">Associates physiological or performance measurements with the session.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/PerformedExerciseSession"/>
    <rdfs:label xml:lang="en">occurs during</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurementEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/modelInputIncludesPersonAttribute">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/PersonAttribute"/>
    <rdfs:label xml:lang="en">includes person attribute</rdfs:label>
    <skos:definition xml:lang="en">Relates Model Input to Person Attribute.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ModelInput"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/activityHasSchedule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates Care Plan Activity to Schedule.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Schedule"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CarePlanActivity"/>
    <rdfs:label xml:lang="en">has schedule</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SafetyRule">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">An actionable constraint or instruction contained in a safety policy, such as requiring clarification or escalation.</skos:definition>
    <rdfs:label xml:lang="en">Safety Rule</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SuspectedClinicalStatus">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ClinicalStatus"/>
    <skos:prefLabel xml:lang="en">Suspected clinical status</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ClinicalStatusScheme"/>
    <rdfs:label xml:lang="en">Suspected clinical status</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">A clinical-status value indicating suspected status.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ClinicalStatusScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/symptomRecordRecordsSymptom">
    <skos:definition xml:lang="en">Relates a symptom record to the symptom being documented.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Symptom"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">records symptom</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/SymptomRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ActivityOutcome">
    <rdfs:label xml:lang="en">Activity Outcome</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:definition xml:lang="en">The result or outcome of a care-plan activity after it has been performed or reviewed.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/DialogueTurn">
    <skos:definition xml:lang="en">A temporally ordered contribution made during a dialogue session.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dialogue Turn</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/cancerStageUsesSystem">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:label xml:lang="en">uses staging system</rdfs:label>
    <skos:definition xml:lang="en">Identifies the staging classification system used to express a cancer-stage assessment.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/CancerStagingSystem"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerStage"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SocialContextFactor">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdfs:label xml:lang="en">Social Context Factor</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A social, economic, cultural, interpersonal, or access-related circumstance that may affect care access, engagement, intervention adoption, support needs, or care-plan delivery.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/measurementPanelName">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurementPanel"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">measurement panel name</rdfs:label>
    <skos:definition xml:lang="en">Records the name of a grouped measurement panel, such as lipid panel, cardiac biomarker panel, body composition panel, or physical performance battery.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/WeeklyRecurrence">
    <skos:definition xml:lang="en">A recurrence pattern in which an activity is expected to recur each week.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Weekly recurrence</rdfs:label>
    <skos:prefLabel xml:lang="en">Weekly recurrence</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/RecurrencePatternScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/RecurrencePattern"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/RecurrencePatternScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/doseValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MedicationDose"/>
    <skos:definition xml:lang="en">Records the numeric medication dose.</skos:definition>
    <rdfs:label xml:lang="en">dose value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ResourceTopicSlot">
    <skos:prefLabel xml:lang="en">Resource topic slot</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/SlotType"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/SlotTypeScheme"/>
    <rdfs:label xml:lang="en">Resource topic slot</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/SlotTypeScheme"/>
    <skos:definition xml:lang="en">A dialogue-slot type used to capture resource topic.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MeasurementQualityScheme">
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/IncompleteMeasurement"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/InvalidMeasurement"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/QualityNotAssessed"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/SuspectMeasurement"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ValidMeasurement"/>
    <rdfs:label xml:lang="en">Measurement Quality scheme</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/measurementEventFollowsProtocol">
    <skos:definition xml:lang="en">Relates Measurement Event to Measurement Protocol.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurementEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/MeasurementProtocol"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">follows protocol</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RiskAssessmentMethod">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <skos:definition xml:lang="en">The method used to assess risk, such as prediction model, rule-based stratification, clinician assessment, or guideline-based classification.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Risk Assessment Method</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/GoalAchievementStatus">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Goal Achievement Status</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A controlled concept representing progress toward or achievement of a goal against its intended target.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SafetyPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Safety Policy</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <skos:definition xml:lang="en">A versioned set of rules and constraints governing the safe behaviour of an agent.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SocialSupportNeed">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/HealthLiteracyNeedType"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/HealthLiteracyNeedTypeScheme"/>
    <skos:definition xml:lang="en">An identified need for practical, informational or emotional support from other people.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/HealthLiteracyNeedTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:prefLabel xml:lang="en">Social support need</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Social support need</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/stageValueCode">
    <rdfs:label xml:lang="en">stage value code</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Records the stage-component value within the specified staging system, such as IIIA, T2, N1 or M0.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerStageValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PredictionModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdfs:label xml:lang="en">Prediction Model</rdfs:label>
    <skos:definition xml:lang="en">A computational, statistical, rule-based, or machine-learning model used to estimate cardiovascular risk or support monitoring decisions.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/QuestionnaireProtocol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/MeasurementProtocol"/>
    <rdfs:label xml:lang="en">Questionnaire Protocol</rdfs:label>
    <skos:definition xml:lang="en">A protocol specifying how an activity, measurement, assessment, or clinical process should be performed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MeasurementDevice">
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/Device"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/MeasurementInstrument"/>
    <rdfs:label xml:lang="en">Measurement Device</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <skos:definition xml:lang="en">A physical measurement instrument used to collect or generate data about a measurable parameter.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/carePlanHasGoal">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CarePlan"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Goal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates Care Plan to Goal.</skos:definition>
    <rdfs:label xml:lang="en">has goal</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Device">
    <rdfs:label xml:lang="en">Device</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <skos:definition xml:lang="en">A physical device used to support interaction, collect data or provide access to a digital service.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Nutrition">
    <rdf:type rdf:resource="https://w3id.org/icareonto/ResourceTopic"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ResourceTopicScheme"/>
    <skos:definition xml:lang="en">Food, dietary patterns and nutritional needs relevant to cancer survivorship, including healthy eating, managing eating-related difficulties and understanding nutrition information.</skos:definition>
    <rdfs:label xml:lang="en">Nutrition</rdfs:label>
    <skos:prefLabel xml:lang="en">Nutrition</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ResourceTopicScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MeasurementPanel">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A grouped set of related measurable parameters or biomarkers measured together, such as a lipid panel, cardiac biomarker panel, or body composition panel.</skos:definition>
    <rdfs:label xml:lang="en">Measurement Panel</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/LifestyleBarrier">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <rdfs:label xml:lang="en">Lifestyle Barrier</rdfs:label>
    <skos:definition xml:lang="en">A barrier affecting lifestyle behaviour change, such as time, fatigue, cost, symptoms, access, confidence, or social support.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/carePlanActivitySupersedes">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CarePlanActivity"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/CarePlanActivity"/>
    <skos:definition xml:lang="en">Connects a revised Care Plan Activity to the version it replaces.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">supersedes</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/nutritionInstructionHasSchedule">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/nutrition"/>
    <rdfs:label xml:lang="en">has schedule</rdfs:label>
    <skos:definition xml:lang="en">Specifies when or how frequently the instruction should be followed.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Schedule"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/NutritionInstruction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CardiovascularLateEffects">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ResourceTopicScheme"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ResourceTopic"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ResourceTopicScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <skos:prefLabel xml:lang="en">Cardiovascular late effects</skos:prefLabel>
    <skos:definition xml:lang="en">Effects of cancer and its treatment on the heart and blood vessels that persist or emerge after treatment, including associated risk factors, symptom awareness and long-term cardiovascular health.</skos:definition>
    <rdfs:label xml:lang="en">Cardiovascular late effects</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PhysicalActivityBehaviour">
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/LifestyleBehaviour"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A lifestyle behaviour describing daily movement, activity level, exercise participation, or physical activity pattern.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <rdfs:label xml:lang="en">Physical Activity Behaviour</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/InteractiveDialogue">
    <rdfs:label xml:lang="en">Interactive dialogue</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ResourceFormatScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ResourceFormat"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:definition xml:lang="en">A resource format that uses interactive dialogue as its primary presentation format.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ResourceFormatScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <skos:prefLabel xml:lang="en">Interactive dialogue</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SocioEconomicFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:definition xml:lang="en">A social or economic circumstance, such as education, employment, or financial resources, that may affect health-related opportunities or participation.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/SocialContextFactor"/>
    <rdfs:label xml:lang="en">Socio Economic Factor</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/TargetedTherapyExposure">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/SystemicTherapyExposure"/>
    <rdfs:label xml:lang="en">Targeted Therapy Exposure</rdfs:label>
    <skos:definition xml:lang="en">Exposure to targeted anti-cancer therapy, such as kinase inhibitors or monoclonal antibodies, that may be relevant to survivorship monitoring or late-effect assessment.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/adherenceAssessmentUsesPerformedSession">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/PerformedExerciseSession"/>
    <skos:definition xml:lang="en">Identifies performed sessions used as adherence evidence.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseAdherenceAssessment"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:label xml:lang="en">uses performed session</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/durationMinutes">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseActivity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <skos:definition xml:lang="en">Intended or actual duration; interpretation comes from prescription or performed-session context.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">duration in minutes</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/behaviourRecordRecordsBehaviour">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/BehaviourRecord"/>
    <rdfs:label xml:lang="en">records behaviour</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <skos:definition xml:lang="en">Relates Behaviour Record to Lifestyle Behaviour.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/LifestyleBehaviour"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CancerDiagnosis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cancer Diagnosis</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <skos:definition xml:lang="en">A recorded diagnosis of cancer associated with a person, representing a current or historical cancer condition and providing context for treatment history, follow-up and assessment of potential late effects.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/medicationCodeSystem">
    <rdfs:label xml:lang="en">medication code system</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Identifies the terminology or classification system that defines the medication code.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Medication"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ScoreValue">
    <skos:definition xml:lang="en">A value object representing a recorded quantity, score, unit, category, or textual value.</skos:definition>
    <rdfs:label xml:lang="en">Score Value</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ResourceFormatScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/MultimodalResource"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/InteractiveDialogue"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/Quiz"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/WrittenText"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/Infographic"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/Audio"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/Video"/>
    <rdfs:label xml:lang="en">Resource Format scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/StudyTimepointType">
    <rdfs:label xml:lang="en">Study Timepoint Type</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A controlled concept classifying a protocol-defined point at which study activities or assessments are scheduled, such as baseline, end of intervention or follow-up.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/localeTimeZoneIdentifier">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Locale"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <skos:definition xml:lang="en">The primary time zone identifier associated with the locale using the standard IANA Time Zone Database naming convention, specifying the region and main city (e.g., Europe/Rome).</skos:definition>
    <rdfs:label xml:lang="en">locale time zone identifier</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PilotPhaseTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/FeasibilityPhaseType"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/NeedsAssessmentPhaseType"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/EvaluationPhaseType"/>
    <rdfs:label xml:lang="en">Pilot Phase Type scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PersonPreference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <rdfs:label xml:lang="en">Person Preference</rdfs:label>
    <skos:definition xml:lang="en">A recorded preference describing how a person wants information, interaction, monitoring, or support to be adapted.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ClinicalCondition">
    <skos:definition xml:lang="en">A clinical, psychosocial, metabolic, cardiovascular, or late-effect condition.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Clinical Condition</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/conditionRecordHasClinicalStatus">
    <rdfs:label xml:lang="en">has clinical status</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ClinicalStatus"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:definition xml:lang="en">Relates Clinical Condition Record to Clinical Status.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ClinicalConditionRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/measurementEventFollowsSamplingProcedure">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">follows sampling procedure</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurementEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/SamplingProcedure"/>
    <skos:definition xml:lang="en">Relates a measurement event to its sampling or collection procedure.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Severity">
    <rdfs:label xml:lang="en">Severity</rdfs:label>
    <skos:definition xml:lang="en">A value or category describing the intensity, seriousness, grade, or clinical impact of a condition, symptom, finding, or adverse effect.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SurveillanceActivity">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:definition xml:lang="en">A planned activity for ongoing detection or monitoring of late effects, recurrence concerns, risk change, or clinically relevant deterioration.</skos:definition>
    <rdfs:label xml:lang="en">Surveillance Activity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/CarePlanActivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/riskEstimateHasContribution">
    <rdfs:label xml:lang="en">has contribution</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RiskEstimate"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <skos:definition xml:lang="en">Relates a risk estimate to a contribution made by a risk factor or model input.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/RiskFactorContribution"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/nutritionInterventionSpecifiesInstruction">
    <rdfs:label xml:lang="en">specifies instruction</rdfs:label>
    <skos:definition xml:lang="en">Relates a nutrition intervention to a nutrition instruction included in it.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/NutritionIntervention"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/NutritionInstruction"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/nutrition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ConsentRefused">
    <skos:prefLabel xml:lang="en">Consent refused</skos:prefLabel>
    <rdfs:label xml:lang="en">Consent refused</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ConsentStatusValue"/>
    <skos:definition xml:lang="en">A consent status indicating that consent was requested and refused.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ConsentStatusValueScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/provenance-governance"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ConsentStatusValueScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ResourceAudienceTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/FamilyAudience"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/AYASurvivorAudience"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/ClinicianAudience"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/CaregiverAudience"/>
    <rdfs:label xml:lang="en">Resource Audience Type scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/EmploymentStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/SocioEconomicFactor"/>
    <rdfs:label xml:lang="en">Employment Status</rdfs:label>
    <skos:definition xml:lang="en">A person's current employment situation, such as employed, unemployed, self-employed, studying, on leave, retired, or unable to work.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/TreatmentAloneSetting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/CancerTreatmentSetting"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CancerTreatmentSettingScheme"/>
    <skos:prefLabel xml:lang="en">Treatment alone setting</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Treatment alone setting</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/CancerTreatmentSettingScheme"/>
    <skos:definition xml:lang="en">A cancer-treatment setting in which the treatment is not classified as neoadjuvant, adjuvant or concomitant treatment.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ClinicalStatus">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Clinical Status</rdfs:label>
    <skos:definition xml:lang="en">A controlled concept representing the current state of a clinical condition or clinical record, such as active, resolved, suspected, in remission or historical.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/socialContextRecordRecordsFactor">
    <skos:definition xml:lang="en">Identifies the contextual factor described by the record. Prefer one factor per record.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/SocialContextFactor"/>
    <rdfs:label xml:lang="en">records factor</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/SocialContextRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Provided">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ResponseStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:definition xml:lang="en">A response status indicating that the requested information was supplied.</skos:definition>
    <skos:prefLabel xml:lang="en">Provided</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ResponseStatusScheme"/>
    <rdfs:label xml:lang="en">Provided</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ResponseStatusScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/dialogueStrategyAdaptedToContext">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Indicates that a dialogue strategy was adapted in response to recorded social context.</skos:definition>
    <rdfs:label xml:lang="en">adapted to context</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/SocialContextRecord"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DialogueStrategy"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/dialogueTurnOccursAt">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Timepoint"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DialogueTurn"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <rdfs:label xml:lang="en">occurs at</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Identifies when a dialogue turn occurred.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/findingName">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ClinicalFinding"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:definition xml:lang="en">Records the finding name or label.</skos:definition>
    <rdfs:label xml:lang="en">finding name</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Biomarker">
    <skos:definition xml:lang="en">A measurable biological indicator used to assess health status, disease process, treatment effect, organ function, or late-effect risk.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/MeasurableParameter"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Biomarker</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RiskFactor">
    <skos:definition xml:lang="en">A factor that may increase, reduce, or modify a person's cardiovascular or late-effect risk.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdfs:label xml:lang="en">Risk Factor</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/NutritionActionType">
    <skos:definition xml:lang="en">A controlled concept representing the intended change to a dietary component, such as increase, reduce, maintain, avoid, or replace.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/nutrition"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nutrition Action Type</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RequestExplanation">
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/UserIntentScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/UserIntent"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <skos:prefLabel xml:lang="en">Request explanation</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/UserIntentScheme"/>
    <rdfs:label xml:lang="en">Request explanation</rdfs:label>
    <skos:definition xml:lang="en">A user-intent concept indicating that the user intends to request explanation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ExerciseAdherenceAssessment">
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/ActivityExecution"/>
    <rdfs:label xml:lang="en">Exercise Adherence Assessment</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">An assessment comparing planned exercise with performed exercise to determine completion, adherence, deviation, or barriers.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/recommendationDerivationProduces">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Recommendation"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RecommendationDerivation"/>
    <skos:definition xml:lang="en">Relates Recommendation Derivation to Recommendation.</skos:definition>
    <rdfs:label xml:lang="en">produces</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/roleValidDuring">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <skos:definition xml:lang="en">Relates a role to the interval during which it applies.</skos:definition>
    <rdfs:label xml:lang="en">role valid during</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PersonRole"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/TimeInterval"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/knowledgeResourceHasAudience">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Identifies the intended audience.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ResourceAudienceType"/>
    <rdfs:label xml:lang="en">has audience</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/KnowledgeResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/behaviourRecordRecordedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <skos:definition xml:lang="en">Relates Behaviour Record to Timepoint.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Timepoint"/>
    <rdfs:label xml:lang="en">recorded at</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/BehaviourRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/EvidenceGrade">
    <skos:definition xml:lang="en">A controlled assessment of the certainty or quality of evidence, interpreted according to a named grading scheme.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Evidence Grade</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/roleContext">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">role context</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PersonRole"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <skos:definition xml:lang="en">Records contextual details for the role, such as study, clinic, family, or care-plan context.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/pilotStudyHasPhase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PilotStudy"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/PilotPhase"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
    <skos:definition xml:lang="en">Identifies an operational phase of the study.</skos:definition>
    <rdfs:label xml:lang="en">has phase</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ChestRadiotherapyExposure">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <skos:definition xml:lang="en">Radiotherapy exposure involving the chest, mediastinum, heart region, or adjacent structures, represented because of its relevance to cardiovascular late-effect risk.</skos:definition>
    <rdfs:label xml:lang="en">Chest Radiotherapy Exposure</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/RadiotherapyExposure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/modelInputIncludesClinicalRecord">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ModelInput"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ClinicalConditionRecord"/>
    <rdfs:label xml:lang="en">includes clinical record</rdfs:label>
    <skos:definition xml:lang="en">Relates Model Input to Clinical Condition Record.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CulturalFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:definition xml:lang="en">A person-stated cultural belief, practice, norm, or context relevant to communication, care, or intervention use.</skos:definition>
    <rdfs:label xml:lang="en">Cultural Factor</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/SocialContextFactor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/modelIdentifier">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PredictionModel"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Records the model identifier for Prediction Model.</skos:definition>
    <rdfs:label xml:lang="en">model identifier</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/preferenceName">
    <skos:definition xml:lang="en">Records the name or category of a preference.</skos:definition>
    <rdfs:label xml:lang="en">preference name</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PersonPreference"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/maximumRepetitionCount">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseSet"/>
    <rdfs:label xml:lang="en">maximum repetition count</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Upper bound when a repetition range is used.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CancerTreatmentHistory">
    <skos:definition xml:lang="en">A longitudinal summary of a person’s cancer diagnosis and treatment records, used to represent survivorship history and treatment exposures relevant to late-effect risk.</skos:definition>
    <rdfs:label xml:lang="en">Cancer Treatment History</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ParticipantKnowledgeGraph">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Collection"/>
    <skos:definition xml:lang="en">A private logical collection of information associated with a particular participant.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/provenance-governance"/>
    <rdfs:label xml:lang="en">Participant Knowledge Graph</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/DigitalAgent">
    <skos:definition xml:lang="en">A software-based agent that performs actions or generates outputs within a defined capability and safety scope.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/Agent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Digital Agent</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/TemporalEntity">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <skos:definition xml:lang="en">A general temporal entity used to group instants and intervals.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Temporal Entity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/medicationRecordPrescribedFor">
    <rdfs:label xml:lang="en">prescribed for</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ClinicalCondition"/>
    <skos:definition xml:lang="en">Relates Medication Record to Clinical Condition.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MedicationRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/EducationActivity">
    <skos:definition xml:lang="en">A care-plan activity that provides educational or self-management content.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/CarePlanActivity"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:label xml:lang="en">Education Activity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/activityOutcomeValue">
    <rdfs:label xml:lang="en">activity outcome value</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ActivityOutcome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Records the activity outcome value.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/observationHasReferenceRange">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ObservationResult"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates an observation result to the reference range used for interpretation.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">has reference range</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ReferenceRange"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/parameterName">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MeasurableParameter"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">parameter name</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Records the display name of a measurable parameter.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/metadata#valuePattern">
    <rdfs:label xml:lang="en">value pattern</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/personAttributeRecordedAt">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Timepoint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates a person attribute to the time it was recorded or asserted.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PersonAttribute"/>
    <rdfs:label xml:lang="en">person attribute recorded at</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/QuestionnaireDataSource">
    <skos:definition xml:lang="en">A data source in which information was obtained from responses to, or scores calculated from, a questionnaire.</skos:definition>
    <rdfs:label xml:lang="en">Questionnaire Data Source</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/DataSource"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/UrgentPriority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ActivityPriority"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Urgent priority</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Urgent priority</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ActivityPriorityScheme"/>
    <skos:definition xml:lang="en">An activity-priority value indicating urgent priority.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ActivityPriorityScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/carePlanHasParticipation">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/CarePlanParticipation"/>
    <skos:definition xml:lang="en">Relates Care Plan to Care Plan Participation.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:label xml:lang="en">has participation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CarePlan"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/cancerStageSystemVersion">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerStage"/>
    <rdfs:label xml:lang="en">cancer stage system version</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Identifies the version or edition of the staging system used for the assessment, such as TNM edition 8.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/cancerDiagnosisRecordedAt">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerDiagnosis"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Timepoint"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">recorded diagnosis at</rdfs:label>
    <skos:definition xml:lang="en">Relates a cancer diagnosis to the time it was recorded or diagnosed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CarePlan">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:definition xml:lang="en">Personalised plan of goals and activities used to support cardiovascular risk management, lifestyle change and follow-up.</skos:definition>
    <skos:altLabel xml:lang="en">personalised care plan</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Care Plan</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/UserUtterance">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/DialogueTurn"/>
    <skos:definition xml:lang="en">A dialogue turn containing information communicated by the user through speech, text, or another supported input mode.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">User Utterance</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/conditionRecordHasSeverity">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ClinicalConditionRecord"/>
    <skos:definition xml:lang="en">Relates Clinical Condition Record to Severity.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Severity"/>
    <rdfs:label xml:lang="en">has severity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/exercisePrescriptionIncludesActivity">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ExerciseActivity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExercisePrescription"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <skos:definition xml:lang="en">Relates a prescription to the exercise activity it prescribes.</skos:definition>
    <rdfs:label xml:lang="en">includes activity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/participationHasRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates Care Plan Participation to Person Role.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CarePlanParticipation"/>
    <rdfs:label xml:lang="en">has participation role</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/PersonRole"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/DataSource">
    <rdfs:label xml:lang="en">Data Source</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
    <skos:definition xml:lang="en">A source from which a record, measurement, or contextual statement is obtained, such as a device, clinical record, questionnaire, self-report, or service.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/intensityLowerBound">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Lower bound of an intensity range.</skos:definition>
    <rdfs:label xml:lang="en">intensity lower bound</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseIntensity"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CancerStageValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A structured component of a cancer-stage assessment that records the component being represented and its coded value.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:label xml:lang="en">Cancer Stage Value</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CarePlanTrigger">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:definition xml:lang="en">A reason or event that causes a care plan or activity to be created, updated, escalated, or reviewed.</skos:definition>
    <rdfs:label xml:lang="en">Care Plan Trigger</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/DerivedParameter">
    <skos:definition xml:lang="en">A measurable parameter calculated from other observations, such as BMI, average heart rate, heart-rate variability, or risk-relevant summary metrics.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/MeasurableParameter"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">Derived Parameter</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/modelInputDerivedFromObservation">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ObservationResult"/>
    <skos:definition xml:lang="en">Relates Model Input to Observation Result.</skos:definition>
    <rdfs:label xml:lang="en">derived from</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ModelInput"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ContemplationStage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/BehaviourChangeStage"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/BehaviourChangeStageScheme"/>
    <skos:prefLabel xml:lang="en">Contemplation stage</skos:prefLabel>
    <skos:definition xml:lang="en">A behaviour-change stage in which the person is considering making the relevant change.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/BehaviourChangeStageScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Contemplation stage</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Locale">
    <skos:definition xml:lang="en">A regional, linguistic and operational context used to localise services, dialogue and knowledge resources.</skos:definition>
    <rdfs:label xml:lang="en">Locale</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/core"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/BehaviourMetricType">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <rdfs:label xml:lang="en">Behaviour Metric Type</rdfs:label>
    <skos:definition xml:lang="en">A controlled concept classifying the aspect of a lifestyle behaviour represented by a behaviour metric, such as sleep duration, daily step count or sedentary duration.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SlotStatusValueScheme">
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/UnconfirmedSlot"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/FilledSlot"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/NotApplicableSlot"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/AmbiguousSlot"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/MissingSlot"/>
    <rdfs:label xml:lang="en">Slot Status Value scheme</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/modelExecutionExecutes">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/PredictionModel"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ModelExecution"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdfs:label xml:lang="en">executes</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates Model Execution to Prediction Model.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/informationPreferenceHasDetailLevel">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/InformationPreference"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <rdfs:label xml:lang="en">has detail level</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/InformationDetailLevelValue"/>
    <skos:definition xml:lang="en">Relates information preference to level of detail.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/modified">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">modified</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ClinicalVisitContext">
    <skos:definition xml:lang="en">A measurement context in which a measurement is performed as part of a scheduled or unscheduled clinical visit or assessment.</skos:definition>
    <rdfs:label xml:lang="en">Clinical Visit Context</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/MeasurementContext"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/carePlanIntendedFor">
    <rdfs:label xml:lang="en">intended for</rdfs:label>
    <skos:definition xml:lang="en">Relates Care Plan to Person.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Person"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CarePlan"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/riskProfileIncludesRiskEstimate">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RiskProfile"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/RiskEstimate"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <skos:definition xml:lang="en">Relates Risk Profile to Risk Estimate.</skos:definition>
    <rdfs:label xml:lang="en">includes risk estimate</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/source">
    <rdfs:label xml:lang="en">source</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/dialogueSlotHasStatus">
    <rdfs:label xml:lang="en">has status</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/SlotStatusValue"/>
    <skos:definition xml:lang="en">Identifies whether the slot is filled, missing, ambiguous, or awaiting confirmation.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DialogueSlot"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/HealthLiteracyNeedType">
    <rdfs:label xml:lang="en">Health Literacy Need Type</rdfs:label>
    <skos:definition xml:lang="en">A controlled concept classifying an actionable health-literacy support need identified through assessment or dialogue.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ECGMonitoringProtocol">
    <skos:definition xml:lang="en">A protocol specifying how an activity, measurement, assessment, or clinical process should be performed.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ECG Monitoring Protocol</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/MeasurementProtocol"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/setCount">
    <skos:definition xml:lang="en">Number of equivalent sets prescribed or performed.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">set count</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseSet"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/knowledgeResourceHasPurpose">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/KnowledgeResource"/>
    <rdfs:label xml:lang="en">has purpose</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Identifies the educational or communication purpose.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ResourcePurpose"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/conditionCodeSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">condition code system</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ClinicalCondition"/>
    <skos:definition xml:lang="en">Identifies the terminology or code system that defines the condition code.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/socialProfileIncludesRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/SocialContextProfile"/>
    <rdfs:label xml:lang="en">includes record</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/SocialContextRecord"/>
    <skos:definition xml:lang="en">Includes a time- and source-specific social-context record in a profile.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MeasurementProtocol">
    <rdfs:label xml:lang="en">Measurement Protocol</rdfs:label>
    <skos:definition xml:lang="en">A protocol specifying how an activity, measurement, assessment, or clinical process should be performed.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/behaviourRecordRelatesToGoal">
    <skos:definition xml:lang="en">Relates a behaviour record to a goal that the behaviour supports, tracks, or evaluates.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <rdfs:label xml:lang="en">relates to goal</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Goal"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/BehaviourRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ConcomitantTreatmentSetting">
    <rdfs:label xml:lang="en">Concomitant treatment setting</rdfs:label>
    <skos:prefLabel xml:lang="en">Concomitant treatment setting</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/CancerTreatmentSetting"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/CancerTreatmentSettingScheme"/>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CancerTreatmentSettingScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:definition xml:lang="en">A cancer-treatment setting in which two or more treatments are delivered during the same treatment period.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/NutritionInstruction">
    <rdfs:label xml:lang="en">Nutrition Instruction</rdfs:label>
    <skos:definition xml:lang="en">A person-specific instruction or target forming part of a nutrition intervention, such as increasing vegetable intake or reducing salt consumption.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/nutrition"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#InstantaneousEvent">
    <rdfs:label>InstantaneousEvent</rdfs:label>
    <rdfs:comment xml:lang="en">An instantaneous event, or event for short, happens in the world and marks a change in the world, in its activities and in its entities. The term 'event' is commonly used in process algebra with a similar meaning. Events represent communications or interactions; they are assumed to be atomic and instantaneous.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ExerciseActivity">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <skos:definition xml:lang="en">A specific exercise activity included in a planned or performed session, such as walking, cycling, squats, sit-ups, stretching, or resistance exercise.</skos:definition>
    <rdfs:label xml:lang="en">Exercise Activity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/contextFactorDescriptionText">
    <skos:definition xml:lang="en">A person-specific explanation of social context factor.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/SocialContextFactor"/>
    <rdfs:label xml:lang="en">context factor description text</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Guideline">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Guideline</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/KnowledgeResource"/>
    <skos:definition xml:lang="en">A systematically developed knowledge resource containing recommendations intended to support health, care, or policy decisions.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/serviceUseEventUsesService">
    <rdfs:range rdf:resource="https://w3id.org/icareonto/DigitalService"/>
    <rdfs:label xml:lang="en">uses service</rdfs:label>
    <skos:definition xml:lang="en">Identifies the service accessed during the event.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/healthhub-service"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ServiceUseEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/LifestyleProfile">
    <rdfs:label xml:lang="en">Lifestyle Profile</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <skos:definition xml:lang="en">A person-specific profile grouping lifestyle and behaviour records relevant to cardiovascular risk, late-effect monitoring, self-management, and care planning.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MixedInfluence">
    <rdf:type rdf:resource="https://w3id.org/icareonto/ContextInfluenceValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ContextInfluenceValueScheme"/>
    <rdfs:label xml:lang="en">Mixed influence</rdfs:label>
    <skos:prefLabel xml:lang="en">Mixed influence</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ContextInfluenceValueScheme"/>
    <skos:definition xml:lang="en">A context-influence value indicating that the factor has both facilitating and impeding effects.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#altLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <rdfs:label xml:lang="en">alternative label</rdfs:label>
    <skos:definition xml:lang="en">An alternative lexical label for a resource.</skos:definition>
    <rdfs:comment xml:lang="en">The range of skos:altLabel is the class of RDF plain literals.</rdfs:comment>
    <rdfs:comment xml:lang="en">skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ClinicalAssessmentRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Clinical Assessment Record</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/ClinicalRecord"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:definition xml:lang="en">A clinical record documenting an assessment performed to evaluate symptoms, conditions, risk, function, late effects, or need for follow-up.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ParticipantEnrolment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Participant Enrolment</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
    <skos:definition xml:lang="en">A contextual record connecting a person to a pilot study, site and phase and, where applicable, to a study arm, participation status and participation period.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/preferredContactTime">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ContactPreference"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/TimeOfDay"/>
    <skos:definition xml:lang="en">Records a preferred contact time window.</skos:definition>
    <rdfs:label xml:lang="en">preferred contact time</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/BehaviourStatus">
    <rdfs:label xml:lang="en">Behaviour Status</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <skos:definition xml:lang="en">A status describing whether a behaviour is current, historical, improved, worsening, stable, target met, or target not met.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/personHasPreference">
    <skos:definition xml:lang="en">Relates Person to Person Preference.</skos:definition>
    <rdfs:label xml:lang="en">has preference</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Person"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/PersonPreference"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ApplicabilityCriterion">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A textual or structured condition used to determine whether a knowledge resource or recommendation is relevant to a particular person, population, or context.</skos:definition>
    <rdfs:label xml:lang="en">Applicability Criterion</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ImmunotherapyExposure">
    <rdfs:label xml:lang="en">Immunotherapy Exposure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/SystemicTherapyExposure"/>
    <skos:definition xml:lang="en">Exposure to cancer immunotherapy, such as checkpoint inhibitors or immune-modulating treatments, with potential relevance to later clinical monitoring.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/VerificationStatusValue">
    <rdfs:label xml:lang="en">Verification Status Value</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/provenance-governance"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A controlled value indicating the verification state of information.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ConsentPending">
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/ConsentStatusValueScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/ConsentStatusValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/provenance-governance"/>
    <skos:definition xml:lang="en">A consent status indicating that a consent decision has not yet been completed.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/ConsentStatusValueScheme"/>
    <rdfs:label xml:lang="en">Consent pending</rdfs:label>
    <skos:prefLabel xml:lang="en">Consent pending</skos:prefLabel>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/TransportationBarrier">
    <rdfs:label xml:lang="en">Transportation Barrier</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:definition xml:lang="en">Difficulty reaching healthcare or study activities because suitable, affordable, or accessible transport is unavailable.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/AccessOrEngagementBarrier"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CarePlanStatus">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdfs:label xml:lang="en">Care Plan Status</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A controlled concept representing the lifecycle state of a care plan, such as draft, active, paused, completed or cancelled.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/activityHasPriority">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">activity has priority</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ActivityPriority"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CarePlanActivity"/>
    <skos:definition xml:lang="en">Relates a care-plan activity to its priority.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/exerciseInterventionHasPrescription">
    <skos:definition xml:lang="en">Associates the intervention with one or more operational prescriptions.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseIntervention"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:label xml:lang="en">has prescription</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ExercisePrescription"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SlotStatusValue">
    <skos:definition xml:lang="en">A controlled value describing the current state of a dialogue slot.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <rdfs:label xml:lang="en">Slot Status Value</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/predictionModelHasPerformanceMetric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates a prediction model to a validation or performance metric.</skos:definition>
    <rdfs:label xml:lang="en">has performance metric</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ModelPerformanceMetric"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PredictionModel"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/conversationAgentEscalatesTo">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DigitalAgent"/>
    <rdfs:label xml:lang="en">escalates to</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <skos:definition xml:lang="en">Identifies a person to whom relevant cases or concerns may be escalated.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Person"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/LaboratoryProtocol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/MeasurementProtocol"/>
    <rdfs:label xml:lang="en">Laboratory Protocol</rdfs:label>
    <skos:definition xml:lang="en">A protocol specifying how an activity, measurement, assessment, or clinical process should be performed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AgentCapability">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Agent Capability</rdfs:label>
    <skos:definition xml:lang="en">A controlled concept representing a function an agent is designed and authorised to perform.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/agent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/DialogueSession">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dialogue Session</rdfs:label>
    <skos:definition xml:lang="en">A bounded interaction between a person and a conversational agent, consisting of one or more ordered dialogue turns.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/ActivityExecution"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/DigitalServiceType">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A controlled concept classifying the principal function of a digital service.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/healthhub-service"/>
    <rdfs:label xml:lang="en">Digital Service Type</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/EmploymentStatusValue">
    <rdfs:label xml:lang="en">Employment Status Value</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:definition xml:lang="en">Permitted employment-status values</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/personParticipatesInMeasurement">
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/Person"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/MeasurementEvent"/>
    <rdfs:label xml:lang="en">participates in</rdfs:label>
    <skos:definition xml:lang="en">Relates Person to Measurement Event.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/consentRecordAppliesToKnowledgeGraph">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/provenance-governance"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Identifies the graph to which the consent applies.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ParticipantKnowledgeGraph"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ConsentRecord"/>
    <rdfs:label xml:lang="en">applies to knowledge graph</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/cancerStageSummary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">The cancer-stage statement as recorded or communicated, such as "Stage II" or "pT2N1M0".</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerStage"/>
    <rdfs:label xml:lang="en">cancer stage summary</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CancerStageComponentType">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A controlled concept identifying the component represented by a cancer-stage value, such as the overall stage group or a TNM T, N or M category.</skos:definition>
    <rdfs:label xml:lang="en">Cancer Stage Component Type</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SevereFinancialConstraint">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/FinancialConstraintStatusValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/FinancialConstraintStatusValueScheme"/>
    <skos:prefLabel xml:lang="en">Severe financial constraint</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/FinancialConstraintStatusValueScheme"/>
    <skos:definition xml:lang="en">A financial-constraint status indicating that financial limitations substantially restrict access, participation or health-related choices.</skos:definition>
    <rdfs:label xml:lang="en">Severe financial constraint</rdfs:label>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/BehaviourChangeStage">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Behaviour Change Stage</rdfs:label>
    <skos:definition xml:lang="en">A controlled concept representing a person's stage of readiness or action in relation to changing a behaviour, according to an identified behaviour-change model (transtheoretical model).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SomeFinancialConstraint">
    <skos:definition xml:lang="en">A financial-constraint status indicating that financial limitations affect some health-related choices or participation.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/FinancialConstraintStatusValueScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/FinancialConstraintStatusValue"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <skos:prefLabel xml:lang="en">Some financial constraint</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/FinancialConstraintStatusValueScheme"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <rdfs:label xml:lang="en">Some financial constraint</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/riskEstimateHasTimeHorizon">
    <rdfs:label xml:lang="en">has time horizon</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RiskEstimate"/>
    <skos:definition xml:lang="en">Relates a risk estimate to the time horizon over which the estimate applies.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/RiskTimeHorizon"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/identifier">
    <rdfs:label xml:lang="en">identifier</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/modelExecutionExecutedAt">
    <rdfs:label xml:lang="en">executed at</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ModelExecution"/>
    <skos:definition xml:lang="en">Relates Model Execution to Timepoint.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/Timepoint"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/facilitatorDescription">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <rdfs:label xml:lang="en">facilitator description</rdfs:label>
    <skos:definition xml:lang="en">Records a textual description of a lifestyle facilitator.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/LifestyleFacilitator"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CarePlanActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:definition xml:lang="en">A planned activity within a care plan, including interventions, monitoring, assessment, follow-up, and surveillance.</skos:definition>
    <rdfs:label xml:lang="en">Care Plan Activity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RadiotherapyTreatment">
    <rdfs:label xml:lang="en">Radiotherapy treatment</rdfs:label>
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/CancerTreatmentTypeScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/CancerTreatmentType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
    <skos:prefLabel xml:lang="en">Radiotherapy treatment</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/CancerTreatmentTypeScheme"/>
    <skos:definition xml:lang="en">A cancer-treatment type using ionising radiation to treat cancer.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SupportAvailabilityValue">
    <rdfs:label xml:lang="en">Support Availability Value</rdfs:label>
    <skos:definition xml:lang="en">Permitted levels of available support</skos:definition>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/distanceValue">
    <skos:definition xml:lang="en">Intended or actual distance when relevant.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/exercise"/>
    <rdfs:label xml:lang="en">distance value</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/ExerciseActivity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#mappingRelation">
    <skos:definition xml:lang="en">Relates two concepts coming, by convention, from different schemes, and that have comparable meanings</skos:definition>
    <rdfs:label xml:lang="en">is in mapping relation with</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">These concept mapping relations mirror semantic relations, and the data model defined below is similar (with the exception of skos:exactMatch) to the data model defined for semantic relations. A distinct vocabulary is provided for concept mapping relations, to provide a convenient way to differentiate links within a concept scheme from links between concept schemes. However, this pattern of usage is not a formal requirement of the SKOS data model, and relies on informal definitions of best practice.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#semanticRelation"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PilotPhase">
    <rdfs:label xml:lang="en">Pilot Phase</rdfs:label>
    <skos:definition xml:lang="en">A bounded stage of a pilot study, such as needs assessment, feasibility testing or evaluation.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/behaviourRecordHasFacilitator">
    <rdfs:label xml:lang="en">has facilitator</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/BehaviourRecord"/>
    <skos:definition xml:lang="en">Relates a behaviour record to a facilitator supporting the behaviour.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/LifestyleFacilitator"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/EducationalAttainmentValue">
    <skos:definition xml:lang="en">Permitted educational attainment values</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdfs:label xml:lang="en">Educational Attainment Value</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/CarePlanAdherenceBehaviour">
    <rdfs:label xml:lang="en">Care Plan Adherence Behaviour</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/AdherenceBehaviour"/>
    <skos:definition xml:lang="en">Adherence behaviour specific to planned care-plan activities.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SocialContextRecord">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Social Context Record</rdfs:label>
    <skos:definition xml:lang="en">A time- and source-qualified statement or observation about a social context factor affecting a person.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ClinicalSeverityLevel">
    <rdfs:label xml:lang="en">Clinical Severity Level</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:definition xml:lang="en">A controlled concept representing the degree of intensity, seriousness or clinical impact of a symptom, condition or finding, such as mild, moderate or severe.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/StudyArm">
    <rdfs:label xml:lang="en">Study Arm</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A study-specific participant group receiving a defined intervention or comparator condition.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/personAttributeValue">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/person-role"/>
    <skos:definition xml:lang="en">Records the value of a person attribute when represented textually.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/PersonAttribute"/>
    <rdfs:label xml:lang="en">person attribute value</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/BehaviourMetric">
    <rdfs:label xml:lang="en">Behaviour Metric</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A measurable quantity or descriptor used to characterise a behaviour record.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/medicationRecordHasStatus">
    <rdfs:label xml:lang="en">record has status</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <skos:definition xml:lang="en">Relates a medication record to its current or recorded medication status.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/MedicationStatus"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/MedicationRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/DialogueSlot">
    <skos:definition xml:lang="en">A representation of an expected piece of information for the current user intent, including whether it has been supplied, is missing, or requires clarification.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <rdfs:label xml:lang="en">Dialogue Slot</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/riskFactorContributionForInput">
    <skos:definition xml:lang="en">Relates a contribution to the model input or factor it describes.</skos:definition>
    <rdfs:label xml:lang="en">contribution for input</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RiskFactorContribution"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/ModelInput"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Contraindication">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Contraindication</rdfs:label>
    <skos:definition xml:lang="en">A condition in which a recommended activity or intervention should not be used, or should be used only with additional assessment or supervision.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/DietaryComponent">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/nutrition"/>
    <rdfs:label xml:lang="en">Dietary Component</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A controlled concept representing the food group, nutrient, beverage, or dietary feature addressed by a nutrition recommendation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/riskFactorContributionForRiskFactor">
    <skos:definition xml:lang="en">Relates a risk-factor contribution to the risk factor it represents.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/RiskFactor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/RiskFactorContribution"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdfs:label xml:lang="en">contribution for risk factor</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/KnowledgeResource">
    <skos:definition xml:lang="en">An identifiable information resource used to support education, evidence-grounded dialogue, recommendations, care activities, or clinical and study procedures.</skos:definition>
    <rdfs:label xml:lang="en">Knowledge Resource</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/AlcoholUseBehaviour">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <rdfs:label xml:lang="en">Alcohol Use Behaviour</rdfs:label>
    <skos:definition xml:lang="en">A behaviour describing alcohol consumption frequency, quantity, or risk level.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/LifestyleBehaviour"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/bibliographicCitation">
    <rdfs:label xml:lang="en">bibliographicCitation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept">
    <skos:definition xml:lang="en">An idea or notion; a unit of thought.</skos:definition>
    <rdfs:label xml:lang="en">Concept</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">description</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/Symptom">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/clinical-profile"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A subjective or observed health complaint relevant to monitoring, triage, assessment, or late-effect management.</skos:definition>
    <rdfs:label xml:lang="en">Symptom</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/publisher">
    <rdfs:label xml:lang="en">publisher</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/dialogueSlotHasType">
    <rdfs:label xml:lang="en">has type</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/DialogueSlot"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/dialogue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/icareonto/SlotType"/>
    <skos:definition xml:lang="en">Identifies the kind of information represented by the slot.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nc650cd5e198a4bada7e9648b2e1bcb1db3">
    <owl:annotatedSource rdf:resource="https://w3id.org/icareonto/ConsentRecord"/>
    <owl:annotatedTarget rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/prov-o/"/>
    <ns1:reviewStatus>Approved</ns1:reviewStatus>
    <rdfs:comment xml:lang="en">A consent record is a provenance-bearing information entity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/RiskTimeHorizon">
    <skos:definition xml:lang="en">The future period over which a risk estimate applies, such as 1-year, 5-year, 10-year, or lifetime risk.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cv-risk"/>
    <rdfs:label xml:lang="en">Risk Time Horizon</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/ActivityPriority">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/intervention-careplan"/>
    <skos:definition xml:lang="en">A controlled concept representing the relative importance or urgency assigned to a care-plan activity, such as routine, important, urgent or requiring escalation.</skos:definition>
    <rdfs:label xml:lang="en">Activity Priority</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/LifestyleFacilitator">
    <rdfs:label xml:lang="en">Lifestyle Facilitator</rdfs:label>
    <skos:definition xml:lang="en">A factor that supports positive lifestyle behaviour change or adherence.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/lifestyle-behaviour"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/license">
    <rdfs:label xml:lang="en">license</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/stageValueText">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">stage value text</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/cancer-history"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/icareonto/CancerStageValue"/>
    <skos:definition xml:lang="en">Records optional human-readable wording for the stage-component value.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/language">
    <rdfs:label xml:lang="en">language</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/PilotSite">
    <rdfs:label xml:lang="en">Pilot Site</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/pilot"/>
    <skos:definition xml:lang="en">A clinical, research or living-lab site responsible for recruitment, intervention delivery or study assessment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/MeasurableParameter">
    <skos:definition xml:lang="en">A clinical, physiological, behavioural, psychological, performance, engagement, or reported variable that can be measured or observed.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">Measurable Parameter</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/SupportNetwork">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/social-context"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/SocialContextFactor"/>
    <skos:definition xml:lang="en">The people or groups available to provide emotional, informational, practical, or care-related support to a person.</skos:definition>
    <rdfs:label xml:lang="en">Support Network</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/creator">
    <rdfs:label xml:lang="en">creator</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/metadata#releaseStatus">
    <rdfs:label xml:lang="en">release status</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/metadata#reviewStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">review status</rdfs:label>
  </rdf:Description>
</rdf:RDF>
