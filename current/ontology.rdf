    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">Sampling Procedure</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/LiteracyLevelValueScheme">
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/HighLiteracy"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/AdequateLiteracy"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/icareonto/LimitedLiteracy"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Literacy Level Value scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/VisualSummary">
    <skos:inScheme rdf:resource="https://w3id.org/icareonto/AccessibilityFeatureScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/icareonto/AccessibilityFeature"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:prefLabel xml:lang="en">Visual summary</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/AccessibilityFeatureScheme"/>
    <rdfs:label xml:lang="en">Visual summary</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/knowledge-resource"/>
    <skos:definition xml:lang="en">An accessibility feature providing a concise visual representation of the main information.</skos:definition>
    <ns1:reviewStatus>Proposed</ns1:reviewStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/EngagementParameter">
    <skos:definition xml:lang="en">A measurable parameter describing interaction with services, adherence to monitoring, app use, session participation, or user engagement.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/icareonto/MeasurableParameter"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/icareonto/measurement-biomarker"/>
    <rdfs:label xml:lang="en">Engagement Parameter</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/icareonto/participantEnrolmentAssignedToArm">
