    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">An identified need for support finding or obtaining relevant and trustworthy health information.</skos:definition>
    <rdfs:label xml:lang="en">Information access support need</rdfs:label>
    <skos:topConceptOf rdf:resource="https://w3id.org/icareonto/HealthLiteracyNeedTypeScheme"/>
    <skos:prefLabel xml:lang="en">Information access support need</skos:prefLabel>
  </rdf:Description>
